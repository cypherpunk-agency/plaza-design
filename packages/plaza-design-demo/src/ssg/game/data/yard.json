{
  "id": "yard",
  "name": "back yard",

  "state": {
    "found": false,
    "armAt": "home",
    "held": null,
    "parcel": "C-7",
    "parcelAt": "C-7",
    "gateAllowed": false,
    "pan": 0
  },

  "tuning": {
    "gateOpenMs": 1000,
    "slideMs": 2500,
    "chuteDropMs": 400,
    "bounceBackMs": 700
  },

  "devices": [
    {
      "id": "cam",
      "name": "CAM-1",
      "look": "A camera on a pole. It has seen things. Mostly crates.",
      "status": [{ "if": "found", "then": "tagged: {parcel}", "else": "watching the yard" }],
      "nouns": [
        {
          "id": "lens", "kind": "SENSE", "verbs": ["view"],
          "on": { "view": { "do": [{ "open": "camera" }], "say": ["cat lens", "feed open."] } }
        },
        {
          "id": "motor", "kind": "ACT", "verbs": ["left", "centre", "right"], "current": "pan",
          "on": {
            "left": { "do": [{ "set": "pan", "to": -1 }], "say": "motor.turn" },
            "centre": { "do": [{ "set": "pan", "to": 0 }], "say": "motor.turn" },
            "right": { "do": [{ "set": "pan", "to": 1 }], "say": "motor.turn" }
          }
        },
        {
          "id": "footage", "kind": "STORE", "verbs": ["read", "copy"],
          "on": {
            "read": { "say": ["cat footage", "three hours of crates. one is addressed to someone you know."] },
            "copy": { "say": ["cp footage ~/deck", "copied. riveting."] }
          }
        }
      ]
    },
    {
      "id": "crane",
      "name": "CRANE",
      "look": "A yard crane. Does exactly what it is told, in order, with a sigh.",
      "status": ["arm: {armAt}", { "if": "held", "then": " · holding {held}" }],
      "nouns": [
        {
          "id": "arm", "kind": "ACT", "verbs": ["A-3", "B-5", "C-7", "chute"], "current": "armAt",
          "on": {
            "*": {
              "do": [{ "set": "armAt", "to": "{verb}" }, { "if": "held", "set": "parcelAt", "to": "hook" }],
              "say": ["use arm --{verb}", "arm swings to {verb}."]
            }
          }
        },
        {
          "id": "claw", "kind": "ACT", "verbs": ["grab", "drop"], "events": ["dropped"],
          "on": { "*": { "do": [{ "effect": "crane.claw" }] } }
        },
        {
          "id": "job.log", "kind": "STORE", "verbs": ["read"],
          "on": { "read": { "say": ["cat job.log", "job.log: \"parcel for you, slot ?-? (smudged by a thumb).\""] } }
        }
      ]
    },
    {
      "id": "gate",
      "name": "HATCH · HINGE",
      "look": "A hatch in the fence, with a face. It is judging you.",
      "status": [
        { "if": "gateOpen", "then": "OPEN", "else": "closed" },
        { "if": "gateAllowed", "then": " · takes signals", "else": " · ignores signals" }
      ],
      "nouns": [
        {
          "id": "lock", "kind": "ACT", "verbs": ["open"],
          "on": {
            "open": [
              { "if": "!signal", "say": ["use lock --open", "HINGE: \"hands off the lock. ask me like a person.\"", "err"] },
              { "if": "!gateAllowed", "say": ["signal → lock --open", "HINGE ignores the signal. it wants to be asked first.", "err"] },
              { "do": [{ "effect": "hatch.open" }], "say": ["signal → lock --open", "HINGE: \"opening. one second. I am busy.\""] }
            ]
          }
        },
        {
          "id": "log", "kind": "STORE", "verbs": ["read"],
          "on": { "read": { "say": ["cat log", "log: opened 0 times today. proud of it."] } }
        },
        {
          "id": "hinge", "kind": "DAEMON", "verbs": ["talk"],
          "on": { "talk": { "do": [{ "open": "talk" }] } }
        }
      ]
    }
  ],

  "cables": [],

  "camera": {
    "crates": [
      { "id": "A-3", "x": 60, "y": 92, "w": 44, "h": 34, "label": "RAISINS (BULK)" },
      { "id": "B-5", "x": 140, "y": 88, "w": 40, "h": 38, "label": "NOT YOURS. REALLY." },
      { "id": "C-7", "x": 222, "y": 96, "w": 36, "h": 30, "label": "TO: YOU. FRAGILE-ISH." }
    ]
  },

  "dialogue": {
    "hinge": {
      "speaker": "HINGE · hatch daemon",
      "start": "start",
      "sayCmd": "say \"{line}\" > hinge",
      "nodes": {
        "start": [
          { "if": "gateAllowed", "text": "Signals: allowed. One second per ping. Do not make me regret this.", "choices": [["Thanks, HINGE.", "bye"]] },
          { "text": "State your business. Briefly. I have been a hatch for eleven years.", "choices": [["I have a parcel coming.", "parcel"], ["Can you open, please?", "please"], ["Open.", "blunt"]] }
        ],
        "parcel": { "text": "Parcels. Always parcels. I do not watch chutes. I have standards.", "choices": [["What if something pinged you?", "ping"], ["Never mind.", "start"]] },
        "ping": { "text": "A signal? Hm. Automation. Very modern. Fine: one ping, I open for one second. I will not wait.", "choices": [["Deal.", "deal"]] },
        "please": { "text": "Manners. Rare. But I do not open for people. I open for reasons.", "choices": [["The reason is a parcel.", "parcel"]] },
        "blunt": { "text": "Bold. No.", "choices": [["Let me start over.", "start"]] },
        "deal": { "text": "Noted. Signals allowed. Timing is your problem.", "do": [{ "set": "gateAllowed", "to": true }, { "goal": "talk" }] },
        "bye": { "text": "Hmph." }
      },
      "free": {
        "match": "wire|ping|signal|automat",
        "goto": "ping",
        "miss": "HINGE does not parse that. HINGE does not want to.",
        "retry": "Try again.",
        "retryGoto": "start"
      }
    }
  },

  "goals": [
    { "id": "find", "text": "find your parcel" },
    { "id": "chute", "text": "get it into the chute" },
    { "id": "talk", "text": "get the hatch to cooperate" },
    { "id": "gate", "text": "get it through the hatch" },
    { "id": "take", "text": "pick it up" }
  ],

  "texts": {
    "goals.done": "done. the fixer owes you one.",
    "board.empty": "nothing on the board yet: open a device first.",
    "prompt.exit": "[E] DOWNTOWN",
    "prompt.open": "[E] OPEN",
    "prompt.take": "[E] TAKE PARCEL",

    "motor.turn": ["use motor --{verb}", "motor whirrs. pointed {verb}."],

    "claw.grab.holding": ["use claw --grab", "already holding {held}."],
    "claw.grab.air": ["use claw --grab", "the claw grabs air."],
    "claw.grab.wrong": ["use claw --grab", "a crate marked \"not yours. really.\" the claw respects that."],
    "claw.grab.wrong.A-3": ["use claw --grab", "a crate of raisins. the claw puts it back, disappointed."],
    "claw.grab.ok": ["use claw --grab", "got it. a parcel, slightly squashed.", "ok"],
    "claw.drop.empty": ["use claw --drop", "the claw drops nothing, with conviction."],
    "claw.drop.at": ["use claw --drop", "dropped at {armAt}. thud."],
    "claw.drop.chute": ["use claw --drop", "into the chute. the claw says: dropped."],

    "timer.wait": ["{via}use timer --wait {sec}s", "timer: waiting {sec} s…", "dim"],

    "parcel.tray": ["", "the parcel slides through the hatch and into the pickup tray.", "ok"],
    "parcel.bonk": ["", "bonk. the parcel hits a closed hatch. the crane fishes it back, sighing.", "err"],
    "parcel.take": ["take parcel", "a parcel, slightly squashed. inside: a note. \"nice wiring. —the fixer\"", "ok"],

    "wire.connect": ["on {from} do {to} {verbCmd}", "wired: when {event}, {toNoun} will {verb}.", "ok"],
    "wire.cut": ["unwire {from} {to}", "cable cut. snip.", "dim"],

    "ui.close": "CLOSE ×",

    "cam.zoom": "ZOOM",
    "cam.tag": "TAG",
    "cam.zoom.gravel": ["cam1 zoom", "zoomed into: gravel. high quality gravel."],
    "cam.zoom.crate": ["cam1 zoom {id}", "crate {id} label: \"{label}\""],
    "cam.zoom.parcel": ["cam1 zoom {id}", "crate {id} label: \"{label}\"", "ok"],
    "cam.zoom.out": ["cam1 zoom --out", "whole yard again.", "dim"],
    "cam.tag.none": ["cam1 tag", "nothing to tag there.", "dim"],
    "cam.tag.ok": ["cam1 tag {id}", "tagged {id}."],
    "cam.hud": "● CAM-1 · YARD",
    "cam.on": "ON: crate {id}",
    "cam.aim": "tap the feed to aim",

    "talk.unplug": "(unplug)",
    "talk.other": "⌨ say something else…",
    "talk.placeholder": "type, then Enter",
    "talk.aria": "Say something to HINGE"
  }
}
