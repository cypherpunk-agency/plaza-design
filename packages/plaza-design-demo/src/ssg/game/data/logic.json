    {
      "id": "switch.so",
      "foundIn": "moth",
      "part": {
        "id": "switch",
        "name": "SWITCH",
        "look": "A logic part. When it is on, a signal passes through. When it is off, it does not.",
        "status": [{ "if": "on", "then": "on · passes signals", "else": "off · stops signals" }],
        "state": { "on": false },
        "nouns": [
          {
            "id": "switch", "kind": "ACT", "verbs": ["pass", "turn on", "turn off"], "events": ["out"], "current": "on",
            "on": {
              "pass": [
                { "if": "on", "do": [{ "emit": "out" }], "say": ["{via}use switch --pass", "switch: on. passed along.", "dim"] },
                { "say": ["{via}use switch --pass", "switch: off. the signal stops here.", "dim"] }
              ],
              "turn on": { "do": [{ "set": "on", "to": true }], "say": ["{via}use switch --on", "switch: on."] },
              "turn off": { "do": [{ "set": "on", "to": false }], "say": ["{via}use switch --off", "switch: off.", "dim"] }
            }
          }
        ]
      }
    }
  ]
