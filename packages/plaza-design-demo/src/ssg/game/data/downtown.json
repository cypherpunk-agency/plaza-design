        "spot": { "x": 1590, "w": 40, "h": 50 },
        "dir": { "plate": "up", "gate": "right" },
        "vision": { "plate": "up", "gate": "right" }
      },
      "nouns": [
        {
          "id": "plate", "kind": "STORE", "verbs": ["read"],
          "on": { "read": { "say": ["cat plate", "REGISTRY PROPERTY · antenna access: root only."] } }
        },
        {
          "id": "gate", "kind": "ACT", "verbs": ["open"],
          "on": { "open": { "say": ["use gate --open", "ACCESS DENIED. root only. current user: unregistered.", "err"] } }
        }
      ]
    },
    {
      "id": "scan",
      "name": "IDENTITY SCAN",
      "look": "An arch that reads faces. It reads yours and finds nothing.",
      "everyday": [{ "noun": "door", "verb": "enter", "label": "walk in" }, { "noun": "scanner", "verb": "read", "label": "look at the screen" }],
      "status": "subject: {handle} · signatures: 0/3",
      "layout": {
        "spot": { "x": 1790, "w": 44, "h": 84 },
        "dir": { "scanner": "up", "door": "right" },
        "vision": { "scanner": "up", "door": "right" }
      },
      "nouns": [
        {
          "id": "scanner", "kind": "SENSE", "verbs": ["read"],
          "on": { "read": { "say": ["cat scanner", "subject: {handle} · identity: not found · signatures: 0/3."] } }
        },
        {
          "id": "door", "kind": "ACT", "verbs": ["enter"],
          "on": { "enter": { "say": ["enter", "ACCESS DENIED. identity: not found.", "err"] } }
        }
      ]
    }
  ],

  "nodes": [
    {
      "id": "dispatch",
      "name": "DISPATCH",
      "look": "The delivery robots' head office. Routes, behind shield rings.",
      "status": [{ "if": "routeFixed", "then": "DLV-9: routed", "else": "DLV-9: status lost" }],
      "layout": { "board": { "x": 0.14, "y": 0.5 }, "dir": { "fleet": "up", "manual": "left", "routes": "down" } },
      "nouns": [
        {
          "id": "fleet", "kind": "STORE", "verbs": ["read"],
          "on": { "read": { "say": ["cat fleet", "DLV-9: status lost. last ping: by a dumpster, downtown. 41 days."] } }
        },
        {
          "id": "manual", "kind": "STORE", "verbs": ["read"],
          "on": { "read": { "say": ["cat manual", "shield rings: lock them from the outside in. they do not wait."] } }
        },
        {
          "id": "routes", "kind": "STORE", "verbs": ["read", "send to dlv9"], "sector": "shields",
