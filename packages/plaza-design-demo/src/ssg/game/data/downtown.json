{
  "id": "downtown",
  "name": "Downtown",

  "state": {
    "lock": "shut",
    "scanned": false,
    "dlvAt": "home",
    "dlvFrom": "home",
    "routeFixed": false,
    "feed": "ads"
  },

  "tuning": {
    "drawerTokens": 3,
    "dlvSpeed": 160,
    "adBackMs": 1200,
    "trendMs": 2600,
    "signTestMs": 3000
  },

  "devices": [
    {
      "id": "gate",
      "name": "NEON MARKET GATE",
      "look": "A shutter across the market's mouth. It opens for a scanner signature, not a password.",
      "everyday": [{ "noun": "lock", "verb": "open", "label": "push the gate" }, { "noun": "door", "verb": "read", "label": "read the counter" }],
      "status": [{ "if": "lock=open", "then": "OPEN", "else": "shut" }, { "if": "end", "then": " · stays open", "else": " · scanner signature required" }],
      "layout": {
        "spot": { "x": 70, "w": 80, "h": 80 },
        "board": { "x": 0.14, "y": 0.28 },
        "dir": { "scanner": "up", "lock": "right", "door": "down", "deliveries.log": "left" },
        "vision": { "scanner": "up", "lock": "right", "door": "down", "deliveries.log": "left" }
      },
      "nouns": [
        {
          "id": "scanner", "kind": "SENSE", "verbs": ["read"], "events": ["matched"],
          "on": { "read": { "say": ["cat scanner", "signatures on file: delivery robots, staff. you: no."] } }
        },
        {
          "id": "lock", "kind": "ACT", "verbs": ["open", "shut"], "current": "lock",
          "on": {
            "open": [
              { "if": "end", "say": ["{via}use lock --open", "already open. held open: market hours.", "dim"] },
              { "if": "!signal", "say": ["use lock --open", "ACCESS DENIED. Scanner signature required. Password entry not supported.", "err"] },
              { "if": "!scanned", "say": ["signal → lock --open", "the lock wants the scanner's word. that signal is not the scanner.", "err"] },
              { "do": [{ "set": "lock", "to": "open" }], "say": ["signal → lock --open", "signature matched. the shutter rolls up.", "ok"] }
            ],
            "shut": [
              { "if": "end", "say": ["{via}use lock --shut", "refused. gate held open: market hours.", "dim"] },
              { "if": "lock=shut", "say": ["{via}use lock --shut", "already shut.", "dim"] },
              { "do": [{ "set": "lock", "to": "shut" }], "say": ["{via}use lock --shut", "shutter down. lock: shut.", "err"] }
            ]
          }
        },
        {
          "id": "door", "kind": "SENSE", "verbs": ["read"], "events": ["passed"],
          "on": { "read": { "say": ["cat door", "counts what goes through. today: nothing. this month: nothing."] } }
        },
        {
          "id": "deliveries.log", "kind": "STORE", "verbs": ["read"],
          "on": { "read": { "say": ["cat deliveries.log", "expected: DLV-9 (dumplings), overdue 41 days. registered robots need no scanner module."] } }
        }
      ]
    },
    {
      "id": "box",
      "name": "JUNCTION BOX 0x2F",
      "look": "REGISTRY UTILITIES · AUTHORISED STAFF ONLY. Older than you.",
      "deck": true,
      "everyday": [{ "noun": "README", "verb": "read", "label": "read the sticker" }],
      "status": [{ "if": "controlled2F", "then": "session: maint · node 0x2F yours", "else": "REGISTRY UTILITIES · maintenance login only" }],
      "layout": {
        "spot": { "x": 330, "y": 34, "w": 30, "h": 38 },
        "board": { "x": 0.38, "y": 0.28 },
        "dir": { "README": "up", "login": "left", "legs.so": "down" },
        "vision": { "README": "up", "login": "left", "legs.so": "down" }
      },
      "nouns": [
        {
          "id": "README", "kind": "STORE", "verbs": ["read"],
          "on": { "read": { "say": ["cat README", "Registry Utilities. Maintenance login only. Password set per sign policy 7."] } }
        },
        {
          "id": "login", "kind": "GUARD",
          "guard": {
            "password": "vrify", "lockMs": 0,
            "near": {
              "verify": ["login maint verify", "ACCESS DENIED. 6 characters entered. Policy 7 password: 5 characters.", "err"],
              "admin": ["login maint admin", "ACCESS DENIED. Factory default passwords are disabled on Registry hardware.", "err"]
            },
            "do": [{ "effect": "node.control" }, { "goal": "box" }]
          }
        },
        {
          "id": "legs.so", "kind": "STORE", "verbs": ["read", "install"], "sector": "maint",
          "on": {
            "read": { "say": ["cat legs.so", "[binary module] install to use."] },
            "install": [
              { "if": "jump", "say": ["install legs.so", "legs.so: already installed.", "dim"] },
              { "do": [{ "effect": "legs.install" }, { "goal": "install" }] }
            ]
          }
        }
      ],
      "sectors": [{ "id": "maint", "label": "maintenance", "seal": { "guard": "login" } }]
    },
    {
      "id": "sign",
      "name": "VERIFY SIGN",
      "look": "Six neon tubes on a plate, policy 7 in light. Five work.",
      "everyday": [{ "noun": "tubes", "verb": "read", "label": "look at the tubes" }],
      "status": "V·RIFY · tube 2 of 6 dark",
      "layout": {
        "spot": { "x": 372, "y": 66, "w": 22, "h": 96 },
        "board": { "x": 0.38, "y": 0.72 },
        "dir": { "tubes": "up" },
        "vision": { "tubes": "right" }
      },
      "nouns": [
        {
          "id": "tubes", "kind": "SENSE", "verbs": ["read", "test"],
          "on": {
            "read": { "do": [{ "give": "vrify" }], "say": ["cat tubes", "V·RIFY. tube 2 (E): dark. repair ticket open since installation."] },
            "test": { "do": [{ "effect": "sign.test" }, { "give": "vrify" }], "say": ["use tubes --test", "V ok · E dead · R ok · I ok · F ok · Y ok. tube 2 of 6: dead. repair ticket open since installation."] }
          }
        }
      ]
    },
    {
      "id": "cam3",
      "name": "CAM-3",
      "look": "A camera on a pole across from the billboard. ● REC.",
      "status": "● REC · watching the street",
      "layout": {
        "spot": { "x": 520, "w": 18, "h": 86 },
        "board": { "x": 0.62, "y": 0.72 },
        "dir": { "lens": "up", "footage": "left" },
        "vision": { "lens": "up", "footage": "left" }
      },
      "nouns": [
        {
          "id": "lens", "kind": "SENSE", "verbs": ["view", "loop"], "events": ["frame"],
          "on": {
            "view": { "do": [{ "open": "cam3" }], "say": ["cat lens", "feed open."] },
            "loop": { "do": [{ "emit": "frame" }], "say": ["{via}use lens --loop", "looping the last 8 hours. subjects detected: 1 (pigeon)."] }
          }
        },
        {
          "id": "footage", "kind": "STORE", "verbs": ["read", "copy"],
          "on": {
            "read": { "say": ["cat footage", "8 hours of street. subjects tracked: 1 pigeon. registered persons: 0."] },
            "copy": { "say": ["cp footage ~/deck", "copied footage: 8 hours, 1 subject (pigeon)."] }
          }
        }
      ]
    },
    {
      "id": "billboard",
      "name": "BILLBOARD",
      "look": "REGISTRY PREMIUM, four metres wide, bolted to the wall and wired to the Registry's ad feed.",
      "everyday": [{ "noun": "ads", "verb": "read", "label": "watch the ad" }],
      "status": [{ "if": "feed=cam3", "then": "showing: CAM-3 (a pigeon)", "else": "showing: REGISTRY PREMIUM" }, { "if": "controlledTV", "then": " · node 0x3C yours" }],
      "layout": {
        "spot": { "x": 640, "y": 108, "w": 124, "h": 42 },
        "board": { "x": 0.86, "y": 0.72 },
        "dir": { "screen": "left", "ads": "up", "terms": "right" },
        "vision": { "screen": "left", "ads": "up", "terms": "right" }
      },
      "nouns": [
        {
          "id": "screen", "kind": "ACT", "verbs": ["show ad", "show feed"], "current": "feed",
          "on": {
            "show ad": { "do": [{ "set": "feed", "to": "ads" }], "say": ["{via}use screen --show-ad", "REGISTRY PREMIUM. Be seen everywhere.", "dim"] },
            "show feed": [
              { "if": "!signal", "say": ["use screen --show-feed", "no input signal. connect a feed.", "err"] },
              { "do": [{ "effect": "billboard.feed" }] }
            ]
          }
        },
        {
          "id": "ads", "kind": "SENSE", "verbs": ["read"], "events": ["next"],
          "on": { "read": { "say": ["cat ads", "REGISTRY PREMIUM. Be seen everywhere. next ad: REGISTRY PREMIUM."] } }
        },
        {
          "id": "terms", "kind": "STORE", "verbs": ["read"],
          "on": { "read": { "say": ["cat terms", "REGISTRY PREMIUM · MINIMUM TERM 36 MONTHS · EARLY CANCELLATION FEE APPLIES · PRICES MAY CHANGE WITHOUT NOTICE."] } }
        }
      ]
    },
    {
      "id": "till",
      "name": "NOODLE TILL",
      "look": "NOODLE TILL v1.0. Firmware: factory. Last updated: never.",
      "deck": true,
      "everyday": [{ "noun": "quickstart", "verb": "read", "label": "look under the counter" }],
      "status": [{ "if": "till", "then": "firmware: factory · drawer: empty", "else": "firmware: factory · login required" }],
      "layout": {
        "spot": { "x": 860, "y": 28, "w": 22, "h": 20 },
        "board": { "x": 0.62, "y": 0.28 },
        "dir": { "receipts.log": "up", "quickstart": "left", "login": "right", "drawer": "down" },
        "vision": { "receipts.log": "up", "quickstart": "left", "login": "right", "drawer": "down" }
      },
      "nouns": [
        {
          "id": "receipts.log", "kind": "STORE", "verbs": ["read"],
          "on": { "read": { "say": ["cat receipts.log", "#0412 ramen, extra egg ...... 1 token · #0413 ramen, no logs ........ 1 token · #0414 ramen, for a ghost .... on the house"] } }
        },
        {
          "id": "quickstart", "kind": "STORE", "verbs": ["read"],
          "on": { "read": { "do": [{ "give": "admin" }], "say": ["cat quickstart", "a laminated card, taped under the counter: \"QUICKSTART. 1. log in: admin / admin. 2. change password (optional).\""] } }
        },
        {
          "id": "login", "kind": "GUARD",
          "guard": { "password": "admin", "lockMs": 0 }
        },
        {
          "id": "drawer", "kind": "ACT", "verbs": ["open"], "sector": "drawer",
          "on": {
            "open": [
              { "if": "till", "say": ["use drawer --open", "drawer: empty.", "dim"] },
              { "do": [{ "effect": "till.pay" }] }
            ]
          }
        }
      ],
      "sectors": [{ "id": "drawer", "label": "cash drawer", "seal": { "guard": "login" } }]
    },
    {
      "id": "dlv9",
      "name": "DLV-9",
      "look": "A delivery robot by the dumpster. Lost. Says it isn't.",
      "everyday": [{ "noun": "speaker", "verb": "say hi", "label": "say hi" }],
      "status": [
        { "if": "routeFixed", "then": "route: NEON MARKET · DUMPLINGS", "else": "status: lost · route: not set" },
        { "if": "dlvAt=market", "then": " · inside the market" },
        { "if": "dlvAt=driving", "then": " · rolling" }
      ],
      "layout": {
        "spot": { "x": 1062, "w": 26, "h": 28 },
        "board": { "x": 0.14, "y": 0.72 },
        "dir": { "eyes": "up", "route.dat": "left", "wheels": "down", "hatch": "right", "speaker": "right", "uplink": "up" },
        "vision": { "eyes": "left", "route.dat": "left", "wheels": "down", "hatch": "down", "speaker": "down", "uplink": "left" }
      },
      "nouns": [
        {
          "id": "eyes", "kind": "SENSE", "verbs": ["read"],
          "on": { "read": { "say": ["cat eyes", "objects: 1 person (unregistered), 1 pigeon."] } }
        },
        {
          "id": "route.dat", "kind": "STORE", "verbs": ["read", "copy"],
          "on": {
            "read": [
              { "if": "routeFixed", "say": ["cat route.dat", "destination: NEON MARKET · DUMPLINGS. ETA: 2 min."] },
              { "say": ["cat route.dat", "destination: not set. ETA: not available."] }
            ],
            "copy": { "say": ["cp route.dat ~/deck", "copied route.dat (destination: not set)."] }
          }
        },
        {
          "id": "wheels", "kind": "ACT", "verbs": ["go home", "follow you", "spin"],
          "on": {
            "go home": { "do": [{ "effect": "dlv.drive" }] },
            "follow you": { "do": [{ "effect": "dlv.drive" }] },
            "spin": { "say": ["{via}use wheels --spin", "wheels: spin test ok."] }
          }
        },
        {
          "id": "hatch", "kind": "ACT", "verbs": ["open", "close"],
          "on": {
            "open": { "do": [{ "give": "glove.left" }], "say": ["use hatch --open", "hatch: open. inside: one glove. left hand."] },
            "close": { "say": ["use hatch --close", "hatch: closed.", "dim"] }
          }
        },
        {
          "id": "speaker", "kind": "ACT", "verbs": ["say hi"],
          "on": { "say hi": { "say": ["use speaker --say-hi", "DLV-9: \"I AM NOT LOST. I AM GOING SOMEWHERE WARM.\""] } }
        },
        {
          "id": "uplink", "kind": "LINK", "link": {}
        }
      ]
    },
    {
      "id": "relay",
      "name": "ROOFTOP RELAY 0x31",
      "look": "ROOFTOP RELAY 0x31 · REGISTRY UTILITIES. It keeps a log of visitors.",
      "deck": true,
      "status": [{ "if": "controlled31", "then": "session: maint · node 0x31 yours", "else": "REGISTRY UTILITIES · maintenance login only" }],
      "layout": {
        "spot": { "x": 1150, "y": 62, "w": 26, "h": 40 },
        "board": { "x": 0.86, "y": 0.28 },
        "dir": { "notes.txt": "up", "log": "left", "archive": "left", "login": "right", "gate.memo": "down", "root.frag": "down", "uplink": "right" },
        "vision": { "notes.txt": "up", "log": "up", "archive": "up", "login": "right", "gate.memo": "right", "root.frag": "up", "uplink": "right" }
      },
      "nouns": [
        {
          "id": "notes.txt", "kind": "STORE", "verbs": ["read"],
          "on": { "read": { "do": [{ "give": "rule.reverse" }], "say": ["cat notes.txt", "maint: password rotated per policy 7. new password = old password, reversed. -J"] } }
        },
        {
          "id": "log", "kind": "LOG", "verbs": ["read"], "events": ["entry"],
          "log": { "rate": 4, "fall": 6, "archive": "relay.archive", "linger": 4000, "lockMs": 8000 },
          "on": { "read": { "say": ["cat log", "visitor: unknown. recording: yes. archive: nightly."] } }
        },
        {
          "id": "archive", "kind": "STORE", "verbs": ["save", "read"],
          "on": {
            "save": { "say": ["{via}archive save", "visit filed.", "dim"] },
            "read": { "say": ["cat archive", "visits filed: 18,402. visits reviewed: 0."] }
          }
        },
        {
          "id": "login", "kind": "GUARD",
          "guard": {
            "password": "yfirv", "lockMs": 0, "trace": 15,
            "near": {
              "vrify": ["login maint vrify", "ACCESS DENIED. That was the old one. Policy 7 says rotate.", "err"],
              "verify": ["login maint verify", "ACCESS DENIED. That was never the one. Policy 7 says rotate.", "err"]
            },
            "do": [{ "effect": "node.control" }, { "goal": "relay" }]
          }
        },
        {
          "id": "gate.memo", "kind": "STORE", "verbs": ["read"], "sector": "maint",
          "on": { "read": { "say": ["cat gate.memo", "NEON MARKET GATE: scanner signature required. Scanner modules are sold inside the Market."] } }
        },
        {
          "id": "root.frag", "kind": "STORE", "verbs": ["read", "copy"], "sector": "maint",
          "on": {
            "read": { "say": ["cat root.frag", "root fragment 1/7 · 9f2c 41ab e07d 3c55 · do not share."] },
            "copy": { "do": [{ "give": "root.frag.1" }], "say": ["cp root.frag ~/deck", "root fragment 1/7. kept.", "ok"] }
          }
        },
        {
          "id": "uplink", "kind": "LINK", "sector": "maint",
          "link": {}
        }
      ],
      "sectors": [{ "id": "maint", "label": "maintenance", "seal": { "guard": "login" } }]
    },
    {
      "id": "fence",
      "name": "REGISTRY PROPERTY",
      "look": "A fence round the antenna's foot. A yellow plate: NO ENTRY.",
      "everyday": [{ "noun": "plate", "verb": "read", "label": "read the plate" }, { "noun": "gate", "verb": "open", "label": "open the gate" }],
      "status": "antenna access: root only",
