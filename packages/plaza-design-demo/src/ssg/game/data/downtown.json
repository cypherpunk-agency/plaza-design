    {
      "id": "weathersat",
      "name": "WEATHER SAT",
      "look": "A weather satellite. It has forecast rain every day this year.",
      "status": "forecast: rain",
      "nouns": [
        {
          "id": "forecast", "kind": "SENSE", "verbs": ["read"],
