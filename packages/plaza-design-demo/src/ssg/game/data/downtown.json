  "keyring": [
    { "id": "admin", "kind": "fragment", "label": "till quickstart", "text": "admin" },
    { "id": "vrify", "kind": "fragment", "label": "V·RIFY sign", "text": "vrify" },
    { "id": "rule.reverse", "kind": "rule", "label": "policy 7", "rule": "reverse" },
    { "id": "root.frag.1", "kind": "fragment", "label": "root 1/7", "text": "9f2c41abe07d3c55" },
    { "id": "glove.left", "kind": "key", "label": "left glove" }
  ],

  "camera": {
    "crates": [
      { "id": "billboard", "x": 18, "y": 24, "w": 104, "h": 40, "label": "REGISTRY PREMIUM" },
