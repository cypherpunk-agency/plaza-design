{
  "version": 1,
  "flags": [
    "yard:gateOpen"
  ],
  "items": [],
  "events": [
    "yard.talk",
    "yard.camera.found",
    "yard.chute.start",
    "yard.chute.sliding",
    "yard.parcel.tray",
    "yard.parcel.bonk",
    "yard.parcel.return"
  ],
  "commands": {
    "yard.hinge.deal": {
      "sources": [
        "conversation"
      ],
      "actions": [
        {
          "state": "yard.gateAllowed",
          "set": true
        },
        {
          "emit": "yard.talk"
        }
      ]
    },
    "yard.camera.discover": {
      "sources": [
        "interaction"
      ],
      "actions": [
        {
          "state": "yard.found",
          "set": true
        },
        {
          "emit": "yard.camera.found"
        }
      ],
      "when": {
        "state": "yard.found",
        "is": false
      }
    },
    "checkpoint.yard.parcel": {
      "sources": [
        "system"
      ],
      "actions": [
        {
          "state": "yard.parcelAt",
          "set": "hook"
        },
        {
          "state": "yard.held",
          "set": "parcel"
        },
        {
          "state": "yard.armAt",
          "set": "chute"
        }
      ]
    },
    "yard.drop.empty": {
      "sources": [
        "interaction",
        "signal"
      ],
      "actions": []
    },
    "yard.drop.at": {
      "sources": [
        "interaction",
        "signal"
      ],
      "actions": [
        {
          "state": "yard.held",
          "set": null
        },
        {
          "state": "yard.parcelAt",
          "set": {
            "state": "yard.armAt"
          }
        }
      ]
    },
    "yard.drop.chute": {
      "sources": [
        "interaction",
        "signal"
      ],
      "actions": [
        {
          "state": "yard.held",
          "set": null
        },
        {
          "state": "yard.parcelAt",
          "set": "chute"
        },
        {
          "emit": "yard.chute.start"
        }
      ]
    },
    "yard.chute.slide": {
      "sources": [
        "system"
      ],
      "actions": [
        {
          "state": "yard.parcelAt",
          "set": "sliding"
        },
        {
          "emit": "yard.chute.sliding"
        }
      ]
    },
    "yard.parcel.arrive": {
      "sources": [
        "system"
      ],
      "actions": [
        {
          "state": "yard.parcelAt",
          "set": "tray"
        },
        {
          "emit": "yard.parcel.tray"
        }
      ]
    },
    "yard.parcel.bounce": {
      "sources": [
        "system"
      ],
      "actions": [
        {
          "state": "yard.parcelAt",
          "set": "bounced"
        },
        {
          "emit": "yard.parcel.bonk"
        },
        {
          "emit": "yard.parcel.return"
        }
      ]
    }
  },
  "reactions": [],
  "conversations": {
    "hinge": {
      "sayCommand": "say \"{line}\" > hinge",
      "entry": [
        {
          "node": "start"
        }
      ],
      "nodes": {
        "start": {
          "speaker": "HINGE · hatch daemon",
          "pages": [
            "State your business. Briefly. I have been a hatch for eleven years."
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "I have a parcel coming.",
              "next": "parcel"
            },
            {
              "id": "choice-2",
              "label": "Can you open, please?",
              "next": "please"
            },
            {
              "id": "choice-3",
              "label": "Open.",
              "next": "blunt"
            }
          ],
          "redirect": [
            {
              "when": {
                "state": "yard.gateAllowed",
                "is": true
              },
              "node": "start-variant-0"
            }
          ]
        },
        "start-variant-0": {
          "speaker": "HINGE · hatch daemon",
          "pages": [
            "Signals: allowed. One second per ping. Do not make me regret this."
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "Thanks, HINGE.",
              "next": "bye"
            }
          ]
        },
        "parcel": {
          "speaker": "HINGE · hatch daemon",
          "pages": [
            "Parcels. Always parcels. I do not watch chutes. I have standards."
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "What if something pinged you?",
              "next": "ping"
            },
            {
              "id": "choice-2",
              "label": "Never mind.",
              "next": "start"
            }
          ]
        },
        "ping": {
          "speaker": "HINGE · hatch daemon",
          "pages": [
            "A signal? Hm. Automation. Very modern. Fine: one ping, I open for one second. I will not wait."
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "Deal.",
              "next": "deal"
            }
          ]
        },
        "please": {
          "speaker": "HINGE · hatch daemon",
          "pages": [
            "Manners. Rare. But I do not open for people. I open for reasons."
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "The reason is a parcel.",
              "next": "parcel"
            }
          ]
        },
        "blunt": {
          "speaker": "HINGE · hatch daemon",
          "pages": [
            "Bold. No."
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "Let me start over.",
              "next": "start"
            }
          ]
        },
        "deal": {
          "speaker": "HINGE · hatch daemon",
          "pages": [
            "Noted. Signals allowed. Timing is your problem."
          ],
          "onEnter": "yard.hinge.deal"
        },
        "bye": {
          "speaker": "HINGE · hatch daemon",
          "pages": [
            "Hmph."
          ]
        }
      },
      "free": {
        "containsAny": [
          "wire",
          "ping",
          "signal",
          "automat"
        ],
        "next": "ping",
        "miss": "HINGE does not parse that. HINGE does not want to.",
        "retry": "Try again.",
        "retryNext": "start"
      }
    }
  },
  "state": {
    "yard.gateAllowed": {
      "owner": "yard",
      "lifetime": "save",
      "type": "boolean",
      "default": false
    },
    "yard.found": {
      "owner": "yard",
      "lifetime": "save",
      "type": "boolean",
      "default": false
    },
    "yard.armAt": {
      "owner": "yard",
      "lifetime": "save",
      "type": "string",
      "default": "home"
    },
    "yard.held": {
      "owner": "yard",
      "lifetime": "save",
      "type": "string",
      "default": null,
      "nullable": true
    },
    "yard.parcel": {
      "owner": "yard",
      "lifetime": "save",
      "type": "string",
      "default": "C-7"
    },
    "yard.parcelAt": {
      "owner": "yard",
      "lifetime": "save",
      "type": "string",
      "default": "C-7"
    },
    "yard.pan": {
      "owner": "yard",
      "lifetime": "save",
      "type": "number",
      "default": 0,
      "integer": false,
      "min": -9007199254740991,
      "max": 9007199254740991
    }
  },
  "native": {
    "verbs": [
      {
        "device": "crane",
        "noun": "claw",
        "verb": "drop",
        "cases": [
          {
            "when": {
              "any": [
                {
                  "state": "yard.held",
                  "is": null
                },
                {
                  "state": "yard.held",
                  "is": ""
                }
              ]
            },
            "command": "yard.drop.empty",
            "say": [
              "use claw --drop",
              "claw empty. nothing dropped."
            ]
          },
          {
            "when": {
              "compare": {
                "left": {
                  "state": "yard.armAt"
                },
                "op": "ne",
                "right": {
                  "literal": "chute"
                }
              }
            },
            "command": "yard.drop.at",
            "say": [
              "use claw --drop",
              "dropped at {state:yard.armAt}. thud."
            ],
            "template": true
          },
          {
            "command": "yard.drop.chute",
            "say": [
              "use claw --drop",
              "dropped into the chute."
            ]
          }
        ]
      }
    ],
    "events": {
      "yard.chute.start": "crane.claw:dropped"
    },
    "goals": {
      "yard.talk": "talk",
      "yard.camera.found": "find",
      "yard.chute.start": "chute",
      "yard.parcel.tray": "gate"
    },
    "wires": [],
    "reads": {
      "yard:gateOpen": "gateOpen"
    },
    "deadlines": {
      "yard.chute": {
        "startOn": [
          "yard.chute.start"
        ],
        "duration": {
          "tuning": "chuteDropMs"
        },
        "due": [
          {
            "command": "yard.chute.slide"
          }
        ]
      },
      "yard.slide": {
        "startOn": [
          "yard.chute.sliding"
        ],
        "duration": {
          "tuning": "slideMs"
        },
        "startedAt": "slideStart",
        "due": [
          {
            "when": {
              "flag": "yard:gateOpen"
            },
            "command": "yard.parcel.arrive"
          },
          {
            "command": "yard.parcel.bounce"
          }
        ]
      },
      "yard.return": {
        "startOn": [
          "yard.parcel.return"
        ],
        "duration": {
          "tuning": "bounceBackMs"
        },
        "due": [
          {
            "command": "checkpoint.yard.parcel"
          }
        ]
      }
    },
    "replies": {
      "yard.parcel.tray": {
        "from": "gate",
        "say": [
          "",
          "the parcel slides through the hatch and into the pickup tray.",
          "ok"
        ]
      },
      "yard.parcel.bonk": {
        "from": "gate",
        "say": [
          "",
          "the parcel hits the closed hatch. the crane fishes it back.",
          "err"
        ]
      }
    }
  },
  "checkpoint": [
    {
      "command": "checkpoint.yard.parcel",
      "when": {
        "any": [
          {
            "state": "yard.parcelAt",
            "is": "chute"
          },
          {
            "state": "yard.parcelAt",
            "is": "sliding"
          },
          {
            "state": "yard.parcelAt",
            "is": "bounced"
          }
        ]
      }
    }
  ]
}
