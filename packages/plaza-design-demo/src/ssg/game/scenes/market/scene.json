{
  "version": 1,
  "id": "market",
  "name": "Street Market",
  "intro": [
    "The night market. Cash, noise and nobody looking up."
  ],
  "uses": [
    {
      "id": "haggle",
      "name": "UMBRELLA SELLER",
      "label": "[E] HAGGLE · UMBRELLA",
      "purchase": "market.umbrella",
      "routes": [
        {
          "pages": [
            "You already have one of mine. It works. Mostly.",
            "If it asks for an update, say no."
          ],
          "when": {
            "flag": "market:umbrella"
          }
        },
        {
          "pages": [
            "Umbrella? Nine tokens.",
            "Look up. The sky does my advertising."
          ],
          "command": "market.haggle.0",
          "when": {
            "state": "market.haggle",
            "is": 0
          }
        },
        {
          "pages": [
            "Seven. Because you have an honest face. Unregistered, but honest."
          ],
          "command": "market.haggle.1",
          "when": {
            "state": "market.haggle",
            "is": 1
          }
        },
        {
          "pages": [
            "Four. I have children to feed.",
            "(The kid at the fruit stall waves at him. He does not wave back.)"
          ],
          "command": "market.haggle.2",
          "when": {
            "state": "market.haggle",
            "is": 2
          }
        },
        {
          "pages": [
            "ONE token. Final. You are robbing me in front of the cameras.",
            "Haggle again to pay."
          ],
          "command": "market.haggle.3",
          "when": {
            "state": "market.haggle",
            "is": 3
          }
        },
        {
          "pages": [
            "Pleasure. It is a smart umbrella: it opens once you accept its terms.",
            "Forty pages. Read them under a roof."
          ],
          "command": "market.umbrella.buy",
          "failure": [
            "No tokens? Then that was haggling for the exercise.",
            "Come back with one. The rain will wait. It always waits."
          ]
        }
      ]
    },
    {
      "id": "fortune",
      "name": "FORTUNE UNIT 9",
      "label": "[E] FORTUNE",
      "purchase": "market.fortune",
      "cycle": true,
      "cycleState": "market.fortune",
      "routes": [
        {
          "pages": [
            "FORTUNE UNIT 9 SEES... a stranger. You are in a market. That was not hard."
          ],
          "command": "market.fortune.0",
          "failure": [
            "FORTUNE UNIT 9 CANNOT SEE YOUR FUTURE.",
            "IT CAN SEE YOUR BALANCE. IT IS ZERO."
          ]
        },
        {
          "pages": [
            "FORTUNE UNIT 9 SEES... a friend who is not fishing. A boat that knows where.",
            "That will be all. FORTUNE UNIT 9 does not do follow-up questions."
          ],
          "command": "market.fortune.1",
          "failure": [
            "FORTUNE UNIT 9 CANNOT SEE YOUR FUTURE.",
            "IT CAN SEE YOUR BALANCE. IT IS ZERO."
          ]
        },
        {
          "pages": [
            "FORTUNE UNIT 9 SEES... a door that opens. Do not trust the door."
          ],
          "command": "market.fortune.2",
          "failure": [
            "FORTUNE UNIT 9 CANNOT SEE YOUR FUTURE.",
            "IT CAN SEE YOUR BALANCE. IT IS ZERO."
          ]
        },
        {
          "pages": [
            "FORTUNE UNIT 9 SEES... your credit score rising.",
            "Correction: someone else's. FORTUNE UNIT 9 regrets the error."
          ],
          "command": "market.fortune.3",
          "failure": [
            "FORTUNE UNIT 9 CANNOT SEE YOUR FUTURE.",
            "IT CAN SEE YOUR BALANCE. IT IS ZERO."
          ]
        },
        {
          "pages": [
            "FORTUNE UNIT 9 SEES... rain. FORTUNE UNIT 9 is never wrong about rain."
          ],
          "command": "market.fortune.4",
          "failure": [
            "FORTUNE UNIT 9 CANNOT SEE YOUR FUTURE.",
            "IT CAN SEE YOUR BALANCE. IT IS ZERO."
          ]
        }
      ]
    }
  ],
  "people": [
    {
      "id": "cook",
      "name": "NOODLE COOK",
      "conversation": "talk.market.cook"
    },
    {
      "id": "fish",
      "name": "FISHMONGER",
      "conversation": "talk.market.fish"
    },
    {
      "id": "repair",
      "name": "REPAIRS",
      "conversation": "talk.market.repair"
    },
    {
      "id": "sleeper",
      "name": "FIRMWARE VENDOR",
      "conversation": "talk.market.sleeper"
    },
    {
      "id": "regular",
      "name": "REGULAR",
      "talk": [
        [
          "Twenty years I have eaten here.",
          "The recipe changed forty times. The price only ever changed one way."
        ],
        [
          "Do not take that stool. It reports to the Registry.",
          "...I am joking. The stool is freelance."
        ]
      ]
    },
    {
      "id": "kid",
      "name": "KID",
      "talk": [
        [
          "I am not stealing. I am testing their security.",
          "Report: there is none."
        ],
        [
          "You did not see anything. I saw you, though. Two tokens and I forget your face.",
          "The cameras charge more."
        ]
      ]
    },
    {
      "id": "queue",
      "name": "IN THE QUEUE",
      "talk": [
        [
          "The queue is sorted by credit score.",
          "I was first when I got here. That was two hours ago."
        ],
        [
          "Someone with a 900 just walked in and got served before he was hungry."
        ]
      ]
    },
    {
      "id": "busker",
      "name": "BUSKER",
      "talk": [
        [
          "This one is called Rain On Tin. I wrote it on tin. In the rain.",
          "Tips are optional. Eye contact is mandatory."
        ],
        [
          "I used to play the mall. Then the mall got a playlist.",
          "The playlist does not take requests either, but it does not pretend to."
        ],
        [
          "Still here? That makes you my audience. Congratulations. There is no prize."
        ]
      ]
    },
    {
      "id": "marshal",
      "name": "QUEUE MARSHAL",
      "talk": [
        [
          "Wait for green. Green is coming.",
          "Green has been coming since I was installed."
        ],
        [
          "Your score is not my business. It is my whole job, but it is not my business."
        ]
      ]
    },
    {
      "id": "oldunit",
      "name": "OLD UNIT",
      "talk": [
        [
          "...hello. Do you have a spare servo? A bolt? Half a bolt?",
          "I sorted parcels for nineteen years. Then they sorted me."
        ],
        [
          "The new model does my job and sings. I did not know the job needed singing."
        ],
        [
          "Do not worry about me. My warranty ran out. My optimism did not. That one is a bug."
        ]
      ]
    }
  ],
  "readables": [
    {
      "id": "sims",
      "name": "SIM CARDS",
      "pages": [
        "PREPAID SIM · ACTIVATION 3 MIN.",
        "ALL SIMS ARE REGISTERED AT SALE. REGISTERED TO WHOM IS NOT STATED."
      ]
    },
    {
      "id": "rules",
      "name": "MARKET RULES",
      "pages": [
        "TRADING HOURS 18:00–04:00. ALL TRANSACTIONS ARE LOGGED.",
        "NO PHOTOGRAPHY. REGISTRY CAMERAS EXEMPT."
      ]
    },
    {
      "id": "implants",
      "name": "USED IMPLANTS",
      "pages": [
        "CERTIFIED PRE-OWNED.",
        "ORIGIN OF STOCK NOT DISCLOSED."
      ]
    }
  ],
