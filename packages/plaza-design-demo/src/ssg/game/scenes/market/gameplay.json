  "reactions": [],
  "conversations": {
    "talk.market.cook": {
      "entry": [
        {
          "when": {
            "state": "talk.market.cook.cursor",
            "is": 0
          },
          "node": "visit-0"
        },
        {
          "node": "visit-1"
        }
      ],
      "nodes": {
        "visit-0": {
          "speaker": "NOODLE COOK",
          "pages": [
            "Noodles. Two tokens. \"Other\" is one.",
            "The inspector asked what is in them. I said other. He wrote it down. Now it is on the menu."
          ],
          "onEnter": "talk.market.cook.advance-0"
        },
        "visit-1": {
          "speaker": "NOODLE COOK",
          "pages": [
            "Still deciding? The noodles are not."
          ],
          "onEnter": "talk.market.cook.advance-1"
        }
      }
    },
    "talk.market.fish": {
      "entry": [
        {
          "when": {
            "state": "talk.market.fish.cursor",
            "is": 0
          },
          "node": "visit-0"
        },
        {
          "when": {
            "state": "talk.market.fish.cursor",
            "is": 1
          },
          "node": "visit-1"
        },
        {
          "node": "visit-2"
        }
      ],
      "nodes": {
        "visit-0": {
          "speaker": "FISHMONGER",
          "pages": [
            "Fresh today. Which today, I did not say.",
            "You are the friend. The quiet one, Moth, said a friend might come asking.",
            "Moth bought line and hooks off me last week. Said they were not for fish.",
            "Then asked which pier the Registry boats skip. I sell fish. I said the harbor has a lot of piers."
          ],
          "onEnter": "talk.market.fish.advance-0"
        },
        "visit-1": {
          "speaker": "FISHMONGER",
          "pages": [
            "Moth paid cash. Nobody pays cash. Cash is for people who do not want to be remembered."
          ],
          "onEnter": "talk.market.fish.advance-1"
        },
        "visit-2": {
          "speaker": "FISHMONGER",
          "pages": [
            "Buy a fish or go stand in someone else's rain."
          ],
          "onEnter": "talk.market.fish.advance-2"
        }
      }
    },
    "talk.market.repair": {
      "entry": [
        {
          "when": {
            "state": "talk.market.repair.cursor",
            "is": 0
          },
          "node": "visit-0"
        },
        {
          "node": "visit-1"
        }
      ],
      "nodes": {
        "visit-0": {
          "speaker": "REPAIRS",
          "pages": [
            "I fix anything with a screw in it.",
            "Not the Registry. That one is working as intended."
          ],
          "onEnter": "talk.market.repair.advance-0"
        },
        "visit-1": {
          "speaker": "REPAIRS",
          "pages": [
            "Your deck? Nice. Do not let me see the inside, I will want it."
          ],
          "onEnter": "talk.market.repair.advance-1"
        }
      }
    },
    "talk.market.sleeper": {
      "entry": [
        {
          "when": {
            "state": "talk.market.sleeper.cursor",
            "is": 0
          },
          "node": "visit-0"
        },
        {
          "node": "visit-1"
        }
      ],
      "nodes": {
        "visit-0": {
          "speaker": "FIRMWARE VENDOR",
          "pages": [
            "Zzz...",
            "(The note on the counter says BACK IN 5 MIN. The tape has gone yellow.)"
          ],
          "onEnter": "talk.market.sleeper.advance-0"
        },
        "visit-1": {
          "speaker": "FIRMWARE VENDOR",
          "pages": [
            "...not buying, not selling, not awake..."
          ],
          "onEnter": "talk.market.sleeper.advance-1"
        }
      }
    },
    "talk.market.regular": {
      "entry": [
        {
          "when": {
            "state": "talk.market.regular.cursor",
            "is": 0
          },
          "node": "visit-0"
        },
        {
          "node": "visit-1"
        }
      ],
      "nodes": {
        "visit-0": {
          "speaker": "REGULAR",
          "pages": [
            "Twenty years I have eaten here.",
            "The recipe changed forty times. The price only ever changed one way."
          ],
          "onEnter": "talk.market.regular.advance-0"
        },
        "visit-1": {
          "speaker": "REGULAR",
          "pages": [
            "Do not take that stool. It reports to the Registry.",
            "...I am joking. The stool is freelance."
          ],
          "onEnter": "talk.market.regular.advance-1"
        }
      }
    },
    "talk.market.kid": {
      "entry": [
        {
          "when": {
            "state": "talk.market.kid.cursor",
            "is": 0
          },
          "node": "visit-0"
        },
        {
          "node": "visit-1"
        }
      ],
      "nodes": {
        "visit-0": {
          "speaker": "KID",
          "pages": [
            "I am not stealing. I am testing their security.",
            "Report: there is none."
          ],
          "onEnter": "talk.market.kid.advance-0"
        },
        "visit-1": {
          "speaker": "KID",
          "pages": [
            "You did not see anything. I saw you, though. Two tokens and I forget your face.",
            "The cameras charge more."
          ],
          "onEnter": "talk.market.kid.advance-1"
        }
      }
    },
    "talk.market.queue": {
      "entry": [
        {
          "when": {
            "state": "talk.market.queue.cursor",
            "is": 0
          },
          "node": "visit-0"
        },
        {
          "node": "visit-1"
        }
      ],
      "nodes": {
        "visit-0": {
          "speaker": "IN THE QUEUE",
          "pages": [
            "The queue is sorted by credit score.",
            "I was first when I got here. That was two hours ago."
          ],
          "onEnter": "talk.market.queue.advance-0"
        },
        "visit-1": {
          "speaker": "IN THE QUEUE",
          "pages": [
            "Someone with a 900 just walked in and got served before he was hungry."
          ],
          "onEnter": "talk.market.queue.advance-1"
        }
      }
    },
    "talk.market.busker": {
      "entry": [
        {
          "when": {
            "state": "talk.market.busker.cursor",
            "is": 0
          },
          "node": "visit-0"
        },
        {
          "when": {
            "state": "talk.market.busker.cursor",
            "is": 1
          },
          "node": "visit-1"
        },
        {
          "node": "visit-2"
        }
      ],
      "nodes": {
        "visit-0": {
          "speaker": "BUSKER",
          "pages": [
            "This one is called Rain On Tin. I wrote it on tin. In the rain.",
            "Tips are optional. Eye contact is mandatory."
          ],
          "onEnter": "talk.market.busker.advance-0"
        },
        "visit-1": {
          "speaker": "BUSKER",
          "pages": [
            "I used to play the mall. Then the mall got a playlist.",
            "The playlist does not take requests either, but it does not pretend to."
          ],
          "onEnter": "talk.market.busker.advance-1"
        },
        "visit-2": {
          "speaker": "BUSKER",
          "pages": [
            "Still here? That makes you my audience. Congratulations. There is no prize."
          ],
          "onEnter": "talk.market.busker.advance-2"
        }
      }
    },
    "talk.market.marshal": {
      "entry": [
        {
          "when": {
            "state": "talk.market.marshal.cursor",
            "is": 0
          },
          "node": "visit-0"
        },
        {
          "node": "visit-1"
        }
      ],
      "nodes": {
        "visit-0": {
          "speaker": "QUEUE MARSHAL",
          "pages": [
            "Wait for green. Green is coming.",
            "Green has been coming since I was installed."
          ],
          "onEnter": "talk.market.marshal.advance-0"
        },
        "visit-1": {
          "speaker": "QUEUE MARSHAL",
          "pages": [
            "Your score is not my business. It is my whole job, but it is not my business."
          ],
          "onEnter": "talk.market.marshal.advance-1"
        }
      }
    },
    "talk.market.oldunit": {
      "entry": [
        {
          "when": {
            "state": "talk.market.oldunit.cursor",
            "is": 0
          },
          "node": "visit-0"
        },
        {
          "when": {
            "state": "talk.market.oldunit.cursor",
            "is": 1
          },
          "node": "visit-1"
        },
        {
          "node": "visit-2"
        }
      ],
      "nodes": {
        "visit-0": {
          "speaker": "OLD UNIT",
          "pages": [
            "...hello. Do you have a spare servo? A bolt? Half a bolt?",
            "I sorted parcels for nineteen years. Then they sorted me."
          ],
          "onEnter": "talk.market.oldunit.advance-0"
        },
        "visit-1": {
          "speaker": "OLD UNIT",
          "pages": [
            "The new model does my job and sings. I did not know the job needed singing."
          ],
          "onEnter": "talk.market.oldunit.advance-1"
        },
        "visit-2": {
          "speaker": "OLD UNIT",
          "pages": [
            "Do not worry about me. My warranty ran out. My optimism did not. That one is a bug."
          ],
          "onEnter": "talk.market.oldunit.advance-2"
        }
      }
    }
