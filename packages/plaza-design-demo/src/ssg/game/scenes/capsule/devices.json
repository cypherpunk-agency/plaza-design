  "devices": [
    {
      "id": "lock",
      "name": "DOOR LOCK",
      "look": "The lock panel by your door. It answers to CONCIERGE, not to you.",
      "everyday": [
        {
          "noun": "bolt",
          "verb": "open",
          "label": "try the door"
        },
        {
          "noun": "plate",
          "verb": "read",
          "label": "read the plate"
        }
      ],
      "status": [
        {
          "if": "doorOpen",
          "then": "unlocked",
          "else": "locked · rent: {rent}"
        }
      ],
      "layout": {
        "spot": {
          "x": 76,
          "w": 18,
          "h": 62
        },
        "board": {
          "x": 0.12,
          "y": 0.28
        },
        "dir": {
          "bolt": "down",
          "plate": "up"
        },
        "vision": {
          "bolt": "right",
          "plate": "up"
        }
      },
      "nouns": [
        {
          "id": "bolt",
          "kind": "ACT",
          "verbs": [
            "open"
          ],
          "on": {
            "open": [
              {
                "if": "doorOpen",
                "say": [
                  "{via}use bolt --open",
                  "already open.",
                  "dim"
                ]
              },
              {
                "say": [
                  "{via}use bolt --open",
                  "LOCK: managed by CONCIERGE. contact CONCIERGE via the building network.",
                  "err"
                ]
              }
            ]
          }
        },
        {
          "id": "plate",
          "kind": "STORE",
          "verbs": [
            "read"
          ],
          "on": {
            "read": [
              {
                "if": "doorOpen",
                "say": [
                  "cat plate",
                  "RENT: PAID. ACCESS RESTORED."
                ]
              },
              {
                "say": [
                  "cat plate",
                  "RENT: PENDING. DOOR LOCKED UNTIL RECEIPT IS VERIFIED."
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": "fridge",
      "name": "FRIDGE",
      "look": "A fridge with a note on it, in your handwriting, in a bad mood.",
      "everyday": [
        {
          "noun": "inside",
          "verb": "open",
          "label": "open the fridge"
        },
        {
          "noun": "note",
          "verb": "read",
          "label": "read the note"
        }
      ],
      "status": "cold · 1 note",
      "layout": {
        "spot": {
          "x": 122,
          "w": 30,
          "h": 68
        },
        "board": {
          "x": 0.12,
          "y": 0.72
        },
        "dir": {
          "note": "up",
          "inside": "right"
        },
        "vision": {
          "note": "up",
          "inside": "right"
        }
      },
      "nouns": [
        {
          "id": "note",
          "kind": "STORE",
          "verbs": [
            "read"
          ],
          "on": {
            "read": {
              "say": [
                "cat note",
                "\"who set the router to sleep at night? it's a capsule. it is always night in here. —past you\""
              ]
            }
          }
        },
        {
          "id": "inside",
          "kind": "STORE",
          "verbs": [
            "open"
          ],
          "on": {
            "open": {
              "say": [
                "open fridge",
                "one lemon, a battery, hope. the battery is for Pixel. the lemon is for no one.",
                "dim"
              ]
            }
          }
        }
      ]
    },
    {
      "id": "kettle",
      "name": "KETTLE",
      "look": "A smart kettle. According to the blinds, it is your morning routine.",
      "everyday": [
        {
          "noun": "kettle",
          "verb": "boil",
          "label": "boil"
        }
      ],
      "status": "ready",
      "layout": {
        "spot": {
          "x": 186,
          "w": 22,
          "h": 50
        },
        "board": {
          "x": 0.3,
          "y": 0.72
        },
        "dir": {
          "kettle": "up"
        },
        "vision": {
          "kettle": "up"
        }
      },
      "nouns": [
        {
          "id": "kettle",
          "kind": "ACT",
          "verbs": [
            "boil"
          ],
          "events": [
            "boiled"
          ],
          "on": {
            "boil": {
              "do": [
                {
                  "effect": "kettle.boil"
                },
                {
                  "emit": "boiled"
                }
              ],
              "say": [
                "{via}use kettle --boil",
                "KETTLE: boiled. 100°C."
              ]
            }
          }
        }
      ]
    },
    {
      "id": "blinds",
      "name": "BLINDS",
      "look": "Motorised blinds. Privacy mode since the rent went pending.",
      "everyday": [
        {
          "noun": "motor",
          "verb": "open",
          "label": "open"
        },
        {
          "noun": "motor",
          "verb": "close",
          "label": "close"
        }
      ],
      "status": [
        {
          "if": "sun",
          "then": "open",
          "else": "closed"
        },
        {
          "if": "doorOpen",
          "then": "",
          "else": " · privacy mode"
        }
      ],
      "layout": {
        "spot": {
          "x": 262,
          "w": 64,
          "h": 96
        },
        "board": {
          "x": 0.46,
          "y": 0.28
        },
        "dir": {
          "motor": "down"
        },
        "vision": {
          "motor": "down"
        }
      },
      "nouns": [
        {
          "id": "motor",
          "kind": "ACT",
          "verbs": [
            "open",
            "close"
          ],
          "on": {
            "open": [
              {
                "if": "sun",
                "say": [
                  "{via}use motor --open",
                  "already open.",
                  "dim"
                ]
              },
              {
                "if": "doorOpen",
                "do": [
                  {
                    "set": "sun",
                    "to": true
                  }
                ],
                "say": [
                  "{via}use motor --open",
                  "the blinds roll up. privacy mode is off: you exist on paper again."
                ]
              },
              {
                "if": "!signal",
                "say": [
                  "use motor --open",
                  "BLINDS: privacy mode (rent: pending). they only open for your morning routine.",
                  "err"
                ]
              },
              {
                "do": [
                  {
                    "set": "sun",
                    "to": true
                  }
                ],
                "say": [
                  "signal → motor --open",
                  "morning routine detected. the blinds roll up. sun. it lands on the floor.",
                  "ok"
                ]
              }
            ],
            "close": {
              "do": [
                {
                  "set": "sun",
                  "to": false
                }
              ],
              "say": [
                "{via}use motor --close",
                "the blinds roll down.",
                "dim"
              ]
            }
          }
        }
      ]
    },
    {
      "id": "pc",
      "name": "HOME-PC",
      "look": "Your computer. Its fan has been sighing since Tuesday.",
      "deck": true,
      "everyday": [
        {
          "noun": "inbox",
          "verb": "read",
          "label": "check mail"
        }
      ],
      "status": [
        {
          "if": "doorOpen",
          "then": "outbox: empty",
          "else": "outbox: 1 waiting"
        }
      ],
      "layout": {
        "spot": {
          "x": 352,
          "w": 36,
          "h": 64
        },
        "board": {
          "x": 0.66,
          "y": 0.72
        },
        "dir": {
          "outbox": "right",
          "inbox": "up",
          "notes": "left",
          "net": "down"
        },
        "vision": {
          "outbox": "right",
          "inbox": "up",
          "notes": "left"
        }
      },
      "nouns": [
        {
          "id": "outbox",
          "kind": "STORE",
          "verbs": [
            "read",
            "open"
          ],
          "events": [
            "ready"
          ],
          "on": {
            "read": [
              {
                "if": "doorOpen",
                "say": [
                  "ls outbox",
                  "outbox: empty. receipt_rent.pdf was delivered and filed, twice.",
                  "dim"
                ]
              },
              {
                "say": [
                  "ls outbox",
                  "receipt_rent.pdf · rent, capsule 7B · waiting for a network since Tuesday."
                ]
              }
            ],
            "open": {
              "do": [
                {
                  "emit": "ready"
                }
              ],
              "say": [
                "{via}open outbox",
                "receipt_rent.pdf: ready to send. waiting for a recipient."
              ]
            }
          }
        },
        {
          "id": "inbox",
          "kind": "STORE",
          "verbs": [
            "read"
          ],
          "on": {
            "read": {
              "say": [
                "cat inbox",
                "1 message, from Moth, 3 days ago: \"if I go dark, my place is yours. my key is with the noodle fixer. follow the trains.\""
              ]
            }
          }
        },
        {
          "id": "notes",
          "kind": "STORE",
          "verbs": [
            "read"
          ],
          "on": {
            "read": {
              "say": [
                "cat notes",
                "\"Pixel naps on whatever is warmest. last winter: the router. the router did not survive the winter.\""
              ]
            }
          }
        },
        {
          "id": "net",
          "kind": "LINK",
          "link": {
            "known": [
              "concierge"
            ],
            "when": "routerUp"
          }
        }
      ]
    },
    {
      "id": "plug",
      "name": "SMART PLUG",
      "look": "A smart plug on a schedule.",
      "everyday": [
        {
          "noun": "power",
          "verb": "on",
          "label": "switch on"
        },
        {
          "noun": "power",
          "verb": "off",
          "label": "switch off"
        }
      ],
      "affects": [
        "router"
      ],
      "status": [
        {
          "if": "plugOn",
          "then": "on",
          "else": "off"
        },
        " · schedule: night"
      ],
      "layout": {
        "spot": {
          "x": 396,
          "w": 18,
          "h": 26
        },
        "board": {
          "x": 0.5,
          "y": 0.72
        },
        "dir": {
          "power": "up",
          "schedule": "down"
        },
        "vision": {
          "power": "up",
          "schedule": "left"
        }
      },
      "nouns": [
        {
          "id": "power",
          "kind": "ACT",
          "verbs": [
            "on",
            "off"
          ],
          "current": "plugOn",
          "on": {
            "on": [
              {
                "if": "plugOn",
                "say": [
                  "{via}use power --on",
                  "already on.",
                  "dim"
                ]
              },
              {
                "do": [
                  {
                    "set": "plugOn",
                    "to": true
                  },
                  {
                    "effect": "router.boot"
                  }
                ],
                "say": [
                  "{via}use power --on",
                  "click. power on. the router boots."
                ]
              }
            ]
          }
        },
        {
          "id": "schedule",
          "kind": "SENSE",
          "verbs": [
            "read"
          ],
          "events": [
            "night"
          ],
          "on": {
            "read": {
              "say": [
                "cat schedule",
                "rule 1: at night, plug off. night = room light below threshold. current: night."
              ]
            }
          }
        }
      ]
    },
    {
      "id": "router",
      "name": "ROUTER",
      "look": "Your router. Small, warm, and the only way out of here that doesn't need a door.",
      "everyday": [
        {
          "noun": "temp",
          "verb": "read",
          "label": "feel how warm it is"
        }
      ],
      "status": [
        {
          "if": "routerUp",
          "then": "online"
        },
        {
          "if": "booting",
          "then": "booting…"
        },
        {
          "if": "plugOn",
          "else": "no power"
        },
        {
          "if": "plugOn",
          "then": " · {temp}°C"
        },
        {
          "if": "pixelOnRouter",
          "then": " · Pixel asleep on top"
        }
      ],
      "layout": {
        "spot": {
          "x": 438,
          "w": 24,
          "h": 44
        },
        "board": {
          "x": 0.84,
          "y": 0.72
        },
        "dir": {
          "uplink": "up",
          "temp": "right"
        },
        "vision": {
          "uplink": "up",
          "temp": "right"
        }
      },
      "nouns": [
        {
          "id": "uplink",
          "kind": "LINK",
          "link": {
            "known": [
              "concierge"
            ],
            "when": "routerUp"
          }
        },
        {
          "id": "temp",
          "kind": "SENSE",
          "verbs": [
            "read"
          ],
          "on": {
            "read": [
              {
                "if": "!plugOn",
                "say": [
                  "cat temp",
                  "{temp}°C. no power.",
                  "dim"
                ]
              },
              {
                "if": "pixelOnRouter",
                "say": [
                  "cat temp",
                  "{temp}°C and rising. vents blocked: Pixel is asleep on top.",
                  "err"
                ]
              },
              {
                "say": [
                  "cat temp",
                  "{temp}°C. normal."
                ]
              }
            ]
          }
        }
      ]
    }
  ],
  "nodes": [
    {
      "id": "concierge",
      "name": "CONCIERGE",
      "look": "Your building's door daemon. Polite, petty, fond of forms.",
      "status": [
        {
          "if": "doorOpen",
          "then": "7B: paid · door unlocked",
          "else": "7B: rent pending · door locked"
        }
      ],
      "layout": {
        "board": {
          "x": 0.84,
          "y": 0.28
        },
        "dir": {
          "desk": "left",
          "ledger": "up",
          "concierge": "down"
        },
        "vision": {
          "desk": "left",
          "ledger": "up",
          "concierge": "down"
        }
      },
      "nouns": [
        {
          "id": "desk",
          "kind": "ACT",
          "verbs": [
            "verify"
          ],
          "on": {
            "verify": [
              {
                "if": "!signal",
                "say": [
                  "use desk --verify",
                  "CONCIERGE: \"verification requires a document. you are not a document.\"",
                  "err"
                ]
              },
              {
                "if": "doorOpen",
                "say": [
                  "signal → desk --verify",
                  "CONCIERGE: \"verified. again. I have filed the second one under 'enthusiasm'.\"",
                  "dim"
                ]
              },
              {
                "if": "!routerUp",
                "say": [
                  "signal → desk --verify",
                  "the receipt goes nowhere. the router is down.",
                  "err"
                ]
              },
              {
                "if": "hot",
                "say": [
                  "signal → desk --verify",
                  "receipt_rent.pdf: 40% sent… packet loss. the router is at {temp}°C. something warm is lying on it.",
                  "err"
                ]
              },
              {
                "do": [
                  {
                    "set": "doorOpen",
                    "to": true
                  },
                  {
                    "set": "rent",
                    "to": "paid"
                  },
                  {
                    "goal": "door"
                  }
                ],
                "say": [
                  "signal → desk --verify",
                  "CONCIERGE: \"payment verified. how unexpected. your door is unlocked. form 7B-12 is attached, and its own form is attached to it.\"",
                  "ok"
                ]
              }
            ]
          }
        },
        {
          "id": "ledger",
          "kind": "STORE",
          "verbs": [
            "read"
          ],
          "on": {
            "read": [
              {
                "if": "doorOpen",
                "say": [
                  "cat ledger",
                  "7B: paid. late, but in triplicate."
                ]
              },
              {
                "say": [
                  "cat ledger",
                  "7B: rent pending. reason: no receipt. reason for the reason: see form 7B-12."
                ]
              }
            ]
          }
        },
        {
          "id": "concierge",
          "kind": "DAEMON",
          "verbs": [
            "talk"
          ],
          "on": {
            "talk": {
              "do": [
                {
                  "open": "talk"
                }
              ]
            }
          }
        }
      ]
    }
  ],
