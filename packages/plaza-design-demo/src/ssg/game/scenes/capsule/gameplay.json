{
  "version": 1,
  "flags": [
    "capsule:routerReadyAtTickStart"
  ],
  "items": [],
  "events": [
    "capsule.pixel.bed",
    "capsule.pixel.router",
    "capsule.pixel.sun",
    "capsule.door.unlocked",
    "capsule.schedule.night"
  ],
  "commands": {
    "capsule.plug.off": {
      "sources": [
        "interaction",
        "signal"
      ],
      "actions": [
        {
          "state": "capsule.plugOn",
          "set": false
        }
      ]
    },
    "capsule.plug.noop": {
      "sources": [
        "interaction",
        "signal"
      ],
      "actions": []
    },
    "capsule.pixel.bed": {
      "sources": [
        "system"
      ],
      "actions": [
        {
          "state": "capsule.pixelAt",
          "set": "bed"
        },
        {
          "emit": "capsule.pixel.bed"
        }
      ]
    },
    "capsule.pixel.router": {
      "sources": [
        "system"
      ],
      "actions": [
        {
          "state": "capsule.pixelAt",
          "set": "router"
        },
        {
          "emit": "capsule.pixel.router"
        }
      ]
    },
    "capsule.pixel.sun": {
      "sources": [
        "system"
      ],
      "actions": [
        {
          "state": "capsule.pixelAt",
          "set": "sun"
        },
        {
          "emit": "capsule.pixel.sun"
        }
      ]
    },
    "capsule.door.unlocked": {
      "sources": [
        "system"
      ],
      "actions": [
        {
          "emit": "capsule.door.unlocked"
        }
      ]
    },
    "capsule.schedule.night": {
      "sources": [
        "system"
      ],
      "actions": [
        {
          "emit": "capsule.schedule.night"
        }
      ]
    }
  },
  "reactions": [],
  "conversations": {
    "concierge": {
      "sayCommand": "say \"{line}\" > concierge",
      "entry": [
        {
          "node": "start"
        }
      ],
      "nodes": {
        "start": {
          "speaker": "CONCIERGE · door daemon",
          "pages": [
            "CONCIERGE, at your service, within reason. Your rent is pending."
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "I paid.",
              "next": "paid"
            },
            {
              "id": "choice-2",
              "label": "Open the door.",
              "next": "door"
            },
            {
              "id": "choice-3",
              "label": "Nice door frame.",
              "next": "oak"
            },
            {
              "id": "choice-4",
              "label": "When's maintenance?",
              "next": "tuesday"
            }
          ],
          "redirect": [
            {
              "when": {
                "state": "capsule.doorOpen",
                "is": true
              },
              "node": "start-variant-0"
            }
          ]
        },
        "start-variant-0": {
          "speaker": "CONCIERGE · door daemon",
          "pages": [
            "Ah. The tenant of 7B, paid and present. I have prepared a form congratulating you."
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "Thanks, I think.",
              "next": "bye"
            },
            {
              "id": "choice-2",
              "label": "When's maintenance?",
              "next": "tuesday"
            }
          ]
        },
        "paid": {
          "speaker": "CONCIERGE · door daemon",
          "pages": [
            "Then there is a receipt. Receipts are sent, not described. I do not accept verbal receipts."
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "It's stuck in my outbox.",
              "next": "outbox"
            },
            {
              "id": "choice-2",
              "label": "Let me start over.",
              "next": "start"
            }
          ]
        },
        "outbox": {
          "speaker": "CONCIERGE · door daemon",
          "pages": [
            "Then it is your outbox's problem, and I wish it well. When a document reaches my desk, I verify. I live to verify."
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "Noted.",
              "next": "bye"
            }
          ]
        },
        "door": {
          "speaker": "CONCIERGE · door daemon",
          "pages": [
            "The door opens for paid tenants. You are a tenant. The rest is paperwork, and the paperwork has paperwork."
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "Let me start over.",
              "next": "start"
            }
          ]
        },
        "oak": {
          "speaker": "CONCIERGE · door daemon",
          "pages": [
            "It is original oak-effect. Nobody ever notices."
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "I noticed.",
              "next": "noticed"
            }
          ]
        },
        "noticed": {
          "speaker": "CONCIERGE · door daemon",
          "pages": [
            "…You may pass. The conversation, not the door. Wipe your feet. Metaphorically."
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "Let me start over.",
              "next": "start"
            }
          ]
        },
        "tuesday": {
          "speaker": "CONCIERGE · door daemon",
          "pages": [
            "Maintenance comes on Tuesdays. It is not Tuesday. It is never Tuesday when it matters."
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "It's Tuesday somewhere.",
              "next": "somewhere"
            }
          ]
        },
        "somewhere": {
          "speaker": "CONCIERGE · door daemon",
          "pages": [
            "…That is technically true. I respect technically true. It changes nothing."
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "Fair.",
              "next": "start"
            }
          ]
        },
        "manners": {
          "speaker": "CONCIERGE · door daemon",
          "pages": [
            "Manners. In this economy. Fine. Still no."
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "Let me start over.",
              "next": "start"
            }
          ]
        },
        "bye": {
          "speaker": "CONCIERGE · door daemon",
          "pages": [
            "Do have a compliant day."
          ]
        }
      },
      "free": {
        "containsAny": [
          "please",
          "thank"
        ],
        "next": "manners",
        "miss": "CONCIERGE files that under 'unclear'.",
        "retry": "Try again. In triplicate.",
        "retryNext": "start"
      }
    }
  },
  "state": {
    "capsule.doorOpen": {
      "owner": "capsule",
      "lifetime": "save",
      "type": "boolean",
      "default": false
    },
    "capsule.plugOn": {
      "owner": "capsule",
      "lifetime": "save",
      "type": "boolean",
      "default": false
    },
    "capsule.sun": {
      "owner": "capsule",
      "lifetime": "save",
      "type": "boolean",
      "default": false
    },
    "capsule.pixelAt": {
      "owner": "capsule",
      "lifetime": "save",
      "type": "string",
      "default": "bed"
    },
    "capsule.rent": {
      "owner": "capsule",
      "lifetime": "save",
      "type": "string",
      "default": "pending"
    }
  },
  "native": {
    "verbs": [
      {
        "device": "plug",
        "noun": "power",
        "verb": "off",
        "cases": [
          {
            "when": {
              "state": "capsule.plugOn",
              "is": false
            },
            "sources": [
              "signal"
            ],
            "command": "capsule.plug.noop",
            "say": null
          },
          {
            "when": {
              "state": "capsule.plugOn",
              "is": false
            },
            "command": "capsule.plug.noop",
            "say": [
              "use power --off",
              "already off.",
              "dim"
            ]
          },
          {
            "sources": [
              "signal"
            ],
            "command": "capsule.plug.off",
            "say": [
              "signal → power --off",
              "SCHEDULE: night. plug off.",
              "err"
            ]
          },
          {
            "command": "capsule.plug.off",
            "say": [
              "{via}use power --off",
              "click. dark again.",
              "dim"
            ]
          }
        ]
      }
    ],
    "events": {
      "capsule.schedule.night": "plug.schedule:night"
    },
    "goals": {},
    "wires": [
      {
        "from": "plug.schedule:night",
        "to": "plug.power",
        "verb": "off"
      }
    ],
    "reads": {
      "capsule:routerReadyAtTickStart": "routerUpAtTickStart"
    },
    "replies": {
      "capsule.pixel.bed": {
        "from": "pixel",
        "say": [
          "",
          "Pixel goes back to the bed. it is still a little warm.",
          "dim"
        ]
      },
      "capsule.pixel.router": {
        "from": "pixel",
        "say": [
          "",
          "Pixel has found something warmer than the bed: the router.",
          "dim"
        ]
      },
      "capsule.pixel.sun": {
        "from": "pixel",
        "say": [
          "",
          "Pixel follows the sun to the floor and lies down in it. the router cools off.",
          "ok"
        ]
      },
      "capsule.door.unlocked": {
        "from": "lock",
        "say": [
          "",
          "DOOR LOCK: receipt on file. bolt released.",
          "ok"
        ]
      }
    },
    "intervals": {
      "capsule.pixelMove": {
        "kind": "liveInterval",
        "elapsed": "pixelWait",
        "duration": {
          "tuning": "pixelMoveMs"
        },
        "active": {
          "compare": {
            "left": {
              "state": "capsule.pixelAt"
            },
            "op": "ne",
            "right": {
              "query": "capsule.pixelTarget"
            }
          }
        },
        "inactive": "reset",
        "due": [
          {
            "when": {
              "compare": {
                "left": {
                  "query": "capsule.pixelTarget"
                },
                "op": "eq",
                "right": {
                  "literal": "sun"
                }
              }
            },
            "command": "capsule.pixel.sun"
          },
          {
            "when": {
              "compare": {
                "left": {
                  "query": "capsule.pixelTarget"
                },
                "op": "eq",
                "right": {
                  "literal": "router"
                }
              }
            },
            "command": "capsule.pixel.router"
          },
          {
            "command": "capsule.pixel.bed"
          }
        ]
      },
      "capsule.schedule": {
        "kind": "liveInterval",
        "phase": "beforeNative",
        "elapsed": "clock",
        "duration": {
          "tuning": "nightEveryMs"
        },
        "active": {
          "compare": {
            "left": {
              "literal": 0
            },
            "op": "eq",
            "right": {
              "literal": 0
            }
          }
        },
        "inactive": "reset",
        "due": [
          {
            "command": "capsule.schedule.night"
          }
        ]
      }
    },
    "triggers": {
      "capsule.doorOpened": {
        "when": {
          "state": "capsule.doorOpen",
          "is": true
        },
        "command": "capsule.door.unlocked",
        "edge": "rising"
      }
    }
  },
  "queries": {
    "capsule.pixelTarget": {
      "kind": "select",
      "cases": [
        {
          "when": {
            "state": "capsule.sun",
            "is": true
          },
          "value": {
            "literal": "sun"
          }
        },
        {
          "when": {
            "state": "capsule.plugOn",
            "is": true
          },
          "value": {
            "literal": "router"
          }
        },
        {
          "value": {
            "literal": "bed"
          }
        }
      ]
    },
    "capsule.scheduleConnected": {
      "kind": "wirePresent",
      "from": "plug.schedule:night",
      "to": "plug.power"
    },
    "capsule.routerGoalReady": {
      "kind": "select",
      "cases": [
        {
          "when": {
            "all": [
              {
                "flag": "capsule:routerReadyAtTickStart"
              },
              {
                "compare": {
                  "left": {
                    "query": "capsule.scheduleConnected"
                  },
                  "op": "eq",
                  "right": {
                    "literal": false
                  }
                }
              }
            ]
          },
          "value": {
            "literal": true
          }
        },
        {
          "value": {
            "literal": false
          }
        }
      ]
    },
    "capsule.pixelGoalReady": {
      "kind": "select",
      "cases": [
        {
          "when": {
            "all": [
              {
                "state": "capsule.pixelAt",
                "is": "sun"
              },
              {
                "state": "capsule.plugOn",
                "is": true
              }
            ]
          },
          "value": {
            "literal": true
          }
        },
        {
          "value": {
            "literal": false
          }
        }
      ]
    }
  }
}
