  "dialogue": {},
  "goals": [
    {
      "id": "find",
      "text": "find NRLU 404 0451 in the stacks: STS-2's camera reads the codes on the roofs. Tag its slot"
    },
    {
      "id": "lift",
      "text": "get 0451 onto the night ferry. Every lift passes the Port Authority's thermal gate"
    },
    {
      "id": "moth",
      "text": "talk to the reefer on the ferry's deck"
    }
  ],
  "texts": {
    "goals.done": "Act I is done. Moth is on your deck: type msg moth.",
    "talk.aria": "Say something to Moth",
    "lift.hand": [
      "use spreader --lift",
      "STS-2: lifts run on the schedule. the cab lifts when the Registry has cleared the ferry. not before, not by hand.",
      "err"
    ],
    "lift.busy": [
      "{via}use spreader --lift",
      "STS-2: lift in progress. one box at a time.",
      "dim"
    ],
    "lift.box": [
      "{via}use spreader --lift",
      "STS-2: lifting slot {box}: NRLU 404 0451 → NIGHT FERRY 7.",
      "ok"
    ],
