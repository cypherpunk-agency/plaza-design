{
  "id": "stacks",
  "name": "the stacks",
  "tuning": {
    "tamperTrace": 30
  },
  "devices": [
    {
      "id": "sts2",
      "name": "STS-2",
      "look": "Ship-to-shore crane 2, berth 4. It has moved everything. It has asked nothing. Its cab rides the trolley under the boom; its camera looks straight down on the stacks.",
      "everyday": [
        {
          "noun": "schedule",
          "verb": "read",
          "label": "read the schedule"
        },
        {
          "noun": "camera",
          "verb": "view",
          "label": "look through the camera"
        }
      ],
      "status": [
        "{crane}",
        {
          "if": "found",
          "then": " · tagged: slot {box}"
        }
      ],
      "layout": {
        "spot": {
          "x": 770,
          "w": 44,
          "h": 110
        },
        "board": {
          "x": 0.16,
          "y": 0.3
        },
        "dir": {
          "camera": "up",
          "schedule": "left",
          "spreader": "down"
        },
        "row": [
          "camera",
          "schedule",
          "spreader"
        ]
      },
      "nouns": [
        {
          "id": "camera",
          "kind": "SENSE",
          "verbs": [
            "view"
          ],
          "on": {
            "view": {
              "do": [
                {
                  "open": "scope"
                }
              ],
              "say": [
                "cat camera",
                "STS-2 CAM: feed open. looking down on blocks A, B and C."
              ]
            }
          }
        },
        {
          "id": "schedule",
          "kind": "STORE",
          "verbs": [
            "read"
          ],
          "on": {
            "read": [
              {
                "if": "departed",
                "say": [
                  "cat schedule",
                  "BERTH 4 · NIGHT FERRY 7: DEPARTED, 12 OF 12. NEXT FERRY: WHEN FULL."
                ]
              },
              {
                "if": "boxAt=ferry",
                "say": [
                  "cat schedule",
                  "BERTH 4 · NIGHT FERRY 7 · 12 OF 12 LOADED · NRLU 404 0451: ON DECK, SHORE POWER ON."
                ]
              },
              {
                "if": "found",
                "say": [
                  "cat schedule",
                  "BERTH 4 · NIGHT FERRY 7 · NEXT: NRLU 404 0451, REEFER · SLOT {box} (TAGGED) · LIFTS ON CLEARANCE: WHEN THE REGISTRY'S WATCHDOG LEAVES THE FERRY."
                ]
              },
              {
                "say": [
                  "cat schedule",
                  "BERTH 4 · NIGHT FERRY 7 · NEXT: NRLU 404 0451, REEFER · SLOT: NOT FOUND (YARD RECORD LOST) · STS-2 LIFTS THE SLOT TAGGED ON ITS CAMERA; UNTAGGED, IT LIFTS REGULAR CARGO FROM THE CHASSIS · LIFTS RUN ON CLEARANCE: WHEN THE REGISTRY'S WATCHDOG LEAVES THE FERRY."
                ]
              }
            ]
          }
        },
        {
          "id": "spreader",
          "kind": "ACT",
          "verbs": [
            "lift"
          ],
          "events": [
            "lifted"
          ],
          "on": {
            "lift": [
              {
                "if": "!signal",
                "say": "lift.hand"
              },
              {
                "if": "craneBusy",
                "say": "lift.busy"
              },
              {
                "do": [
                  {
                    "effect": "sts2.lift"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": "port",
      "name": "PORT AUTHORITY",
      "look": "The Port Authority's thermal gate at berth 4: two steel posts and a sheet of red light the crane's load passes through on its way to the ferry. A box is meant to be the temperature on its label.",
      "everyday": [
        {
          "noun": "scanner",
          "verb": "read",
          "label": "read the gate"
        },
        {
          "noun": "log",
          "verb": "read",
          "label": "read the scan log"
        }
      ],
      "status": [
        "THERMAL GATE · BERTH 4 · ALARMS TONIGHT: {alarms}"
      ],
      "layout": {
        "spot": {
          "x": 1064,
          "w": 34,
          "h": 150
        },
        "board": {
          "x": 0.5,
          "y": 0.3
        },
        "dir": {
          "scanner": "up",
          "alarm": "right",
          "log": "left"
        },
        "row": [
          "scanner",
          "log",
          "alarm"
        ]
      },
      "nouns": [
        {
          "id": "scanner",
          "kind": "SENSE",
          "verbs": [
            "read"
          ],
          "events": [
            "warm"
          ],
          "on": {
            "read": {
              "say": [
                "cat scanner",
                "THERMAL GATE: every lift is read against the temperature on its label. warmer than its label: warm. a warm box is a box with someone breathing in it. warm → alarm. the Registry's watchdog checks this wiring on every visit."
              ]
            }
          }
        },
        {
          "id": "log",
          "kind": "STORE",
          "verbs": [
            "read"
          ],
          "on": {
            "read": {
              "say": [
                "cat log",
                "SCAN LOG · BERTH 4 · TONIGHT: {loaded} LIFTS CLEARED COLD · ALARMS: {alarms} · INSPECTION BACKLOG: 4 DAYS."
              ]
            }
          }
        },
        {
          "id": "alarm",
          "kind": "ACT",
          "verbs": [
            "sound"
          ],
          "on": {
            "sound": [
              {
                "if": "!signal",
                "say": "alarm.test"
              },
              {
                "do": [
                  {
                    "effect": "port.alarm"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": "ferry",
      "name": "NIGHT FERRY",
      "look": "The night ferry at berth 4: a rust-red hull, an open hatch, a gangway with a purser's terminal. Departs when full. It is waiting for one box.",
      "everyday": [
        {
          "noun": "manifest",
          "verb": "read",
          "label": "read the manifest"
        },
        {
          "noun": "horn",
          "verb": "sound",
          "label": "sound the horn"
        }
      ],
      "status": [
        "{ferryStatus}"
      ],
      "layout": {
        "spot": {
          "x": 1214,
          "w": 30,
          "h": 56
        },
        "board": {
          "x": 0.84,
          "y": 0.3
        },
        "dir": {
          "manifest": "up",
          "horn": "right"
        }
      },
      "nouns": [
        {
          "id": "manifest",
          "kind": "STORE",
          "verbs": [
            "read"
          ],
          "on": {
            "read": [
              {
                "if": "departed",
                "say": [
                  "cat manifest",
                  "NIGHT FERRY 8 · BERTH 4 · 12 SLOTS · REGULAR CARGO · DEPARTS WHEN FULL. (NIGHT FERRY 7: DEPARTED 12 OF 12. DESTINATION: OPEN WATER.)"
                ]
              },
              {
                "say": [
                  "cat manifest",
                  "NIGHT FERRY 7 · BERTH 4 · 12 SLOTS · AWAITED: NRLU 404 0451, REEFER, SET 4°C · SHIPPER: TIDE MARINE (C. BRINE) · CONSIGNEE: REDACTED · DESTINATION: OPEN WATER · DEPARTS WHEN FULL."
                ]
              }
            ]
          }
        },
        {
          "id": "horn",
          "kind": "ACT",
          "verbs": [
            "sound"
          ],
          "on": {
            "sound": [
              {
                "if": "signal",
                "say": [
                  "signal → horn --sound",
                  "NIGHT FERRY 7: horn. one long. the gulls leave and come back.",
                  "dim"
                ]
              },
              {
                "say": [
                  "use horn --sound",
                  "PURSER: the horn is the master's. the master is asleep. please do not test the horn.",
                  "err"
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": "reefer",
      "name": "NRLU 404 0451",
      "look": "A refrigerated container, white once, with a humming unit at one end and a small intercom panel for the crew. Its label says 4°C.",
      "everyday": [
        {
          "noun": "intercom",
          "verb": "talk",
          "label": "talk"
        },
        {
          "noun": "panel",
          "verb": "read",
          "label": "read the panel"
        }
      ],
      "status": [
        "REEFER · SET 4°C · INSIDE 31°C"
      ],
      "layout": {
        "spot": {
          "x": 1452,
          "w": 96,
          "h": 58
        },
        "board": {
          "x": 0.7,
          "y": 0.75
        },
        "dir": {
          "panel": "left",
          "intercom": "up"
        }
      },
      "nouns": [
        {
          "id": "panel",
          "kind": "STORE",
          "verbs": [
            "read"
          ],
          "on": {
            "read": [
              {
                "if": "boxAt=ferry",
                "say": [
                  "cat panel",
                  "REEFER · SET 4°C · INSIDE 31°C · POWER: NIGHT FERRY 7 · DOOR: UNLATCHED FROM INSIDE."
                ]
              },
              {
                "say": [
                  "cat panel",
                  "REEFER · SET 4°C · INSIDE 31°C · POWER: YARD · LAST OPENED: 2 DAYS AGO, FROM INSIDE."
                ]
              }
            ]
          }
        },
        {
          "id": "intercom",
          "kind": "DAEMON",
          "verbs": [
            "talk"
          ],
          "on": {
            "talk": {
              "do": [
                {
                  "open": "talk",
                  "with": "moth"
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "cables": [
