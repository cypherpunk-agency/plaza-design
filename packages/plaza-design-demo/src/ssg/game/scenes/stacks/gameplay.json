          "speaker": "TALLY-4",
          "pages": [
            "COUNT: 1,204 CONTAINERS. COUNT: 1,204. COUNT: 1,203.",
            "RECOUNT."
          ],
          "onEnter": "talk.stacks.tally.advance-0"
        },
        "visit-1": {
          "speaker": "TALLY-4",
          "pages": [
            "BLOCK B, BACK ROW, SLOT 6: YARD RECORD MISSING. CONTAINER PRESENT. CONTAINER CANNOT BE PRESENT. RECOUNT."
          ],
          "onEnter": "talk.stacks.tally.advance-1"
        }
      }
    },
    "talk.stacks.gull1": {
      "entry": [
        {
          "when": {
