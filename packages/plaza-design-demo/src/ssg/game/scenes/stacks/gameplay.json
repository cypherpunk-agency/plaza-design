  "conversations": {
    "moth": {
      "sayCommand": "say \"{line}\" > reefer",
      "entry": [
        {
          "node": "start"
        }
      ],
      "nodes": {
        "start": {
          "speaker": "MOTH · the intercom of NRLU 404 0451",
          "pages": [
            "Took you long enough. Did you feed Sprat?"
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "Sprat is... fine.",
              "next": "notfed"
            },
            {
              "id": "choice-2",
              "label": "Hello to you too.",
              "next": "hello"
            }
          ],
          "redirect": [
            {
              "when": {
                "state": "stacks.talked",
                "is": true
              },
              "node": "start-variant-0"
            },
            {
              "when": {
                "state": "stacks.boxAt",
                "is": "stack"
              },
              "node": "start-variant-1"
            },
            {
              "when": {
                "state": "stacks.boxAt",
                "is": "air"
              },
              "node": "start-variant-2"
            },
            {
              "when": {
                "compare": {
                  "left": {
                    "query": "stacks.spratFed"
                  },
                  "op": "eq",
                  "right": {
                    "literal": true
                  }
                }
              },
              "node": "start-variant-3"
            }
          ]
        },
        "start-variant-0": {
          "speaker": "MOTH · the intercom of NRLU 404 0451",
          "pages": [
            "(The intercom hisses. The ferry is out of range. Moth is on your deck now.)"
          ]
        },
        "start-variant-1": {
          "speaker": "MOTH · the intercom of NRLU 404 0451",
          "pages": [
            "(Static. Then, from somewhere in block B, two knocks. Then nothing. The thermal gate is listening, and so is whoever knocked.)"
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "Knock twice on the panel.",
              "next": "knock"
            },
            {
              "id": "choice-2",
              "label": "Leave it.",
              "next": "quiet"
            }
          ]
        },
        "start-variant-2": {
          "speaker": "MOTH · the intercom of NRLU 404 0451",
          "pages": [
            "(The intercom is all wind and winch.)"
          ]
        },
        "start-variant-3": {
          "speaker": "MOTH · the intercom of NRLU 404 0451",
          "pages": [
            "Took you long enough. Did you feed Sprat?"
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "I fed Sprat.",
              "next": "fed"
            },
            {
              "id": "choice-2",
              "label": "Hello to you too.",
              "next": "hello"
            }
          ]
        },
        "knock": {
          "speaker": "MOTH · the intercom of NRLU 404 0451",
          "pages": [
            "(Two knocks back. A pause. Then one, slow. Moth's knock: wait.)"
          ]
        },
        "quiet": {
          "speaker": "MOTH · the intercom of NRLU 404 0451",
          "pages": [
            "(The reefer hums. Its label says 4°C. It is not 4°C in there.)"
          ]
        },
        "fed": {
          "speaker": "MOTH · the intercom of NRLU 404 0451",
          "pages": [
            "You did? He'll act like you didn't. He holds a grudge like a much bigger fish."
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "Moth. What happened to me?",
              "next": "deleted"
            }
          ]
        },
        "notfed": {
          "speaker": "MOTH · the intercom of NRLU 404 0451",
          "pages": [
            "You didn't. I can hear it in your voice. It's fine. He's a fish. He'll turn it into a story about how he survived."
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "Moth. What happened to me?",
              "next": "deleted"
            }
          ]
        },
        "hello": {
          "speaker": "MOTH · the intercom of NRLU 404 0451",
          "pages": [
            "Hello. Sorry. Two days in a fridge set to warm. Manners go first. Then the left foot."
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "Moth. What happened to me?",
              "next": "deleted"
            }
          ]
        },
        "deleted": {
          "speaker": "MOTH · the intercom of NRLU 404 0451",
          "pages": [
            "Your door says rent: pending. The street looks through you. The turnstiles think about it. That's not a glitch, and it's not your rent. You were deleted. On purpose."
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "On purpose? By who?",
              "next": "list"
            }
          ],
          "redirect": [
            {
              "when": {
                "flag": "stacks:alarms"
              },
              "node": "deleted-variant-0"
            }
          ]
        },
        "deleted-variant-0": {
          "speaker": "MOTH · the intercom of NRLU 404 0451",
          "pages": [
            "First: that alarm. Subtle. I bit my own sleeve. Second: you. Your door says rent: pending, the street looks through you, the turnstiles think about it. That's not a glitch. You were deleted. On purpose."
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "On purpose? By who?",
              "next": "list"
            }
          ]
        },
        "list": {
          "speaker": "MOTH · the intercom of NRLU 404 0451",
          "pages": [
            "The Registry. Tuesday, 03:12, one batch: you and four hundred and six others. I was inside on a boring job, address records, and there was a list. Signed, dated, approved. Your name on it, spelt right for once."
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "What did you do?",
              "next": "took"
            }
          ]
        },
        "took": {
          "speaker": "MOTH · the intercom of NRLU 404 0451",
          "pages": [
            "I took it. Badly. Registry files don't leave in one piece: it came apart into seven root fragments, and each one went back to wherever its key lives. The relay on Downtown's roof had one. You've been carrying a piece of this since before you knew."
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "And the Registry?",
              "next": "knows"
            }
          ]
        },
        "knows": {
          "speaker": "MOTH · the intercom of NRLU 404 0451",
          "pages": [
            "Knows I have it. That's why I'm in a fridge, and why their dog walks this quay. They don't need the list back. They need me. Then you, because you came looking."
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "Where does it end?",
              "next": "spire"
            }
          ]
        },
        "spire": {
          "speaker": "MOTH · the intercom of NRLU 404 0451",
          "pages": [
            "Up. The antenna on Plaza Central, top of the Spire. The list's lock is up there. Put the seven pieces back in and everyone on it comes back. You included. Probably. I didn't read the manual. I stole it."
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "And you?",
              "next": "deck"
            }
          ]
        },
        "deck": {
          "speaker": "MOTH · the intercom of NRLU 404 0451",
          "pages": [
            "The ferry leaves when it's full, and I'm the last box. Out on the water their gates only scan fish. I'll be on your deck: messages, when there's signal. I find out where the pieces are. You go and get them. You were always better with doors."
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "Don't go dark again.",
              "next": "end"
            },
            {
              "id": "choice-2",
              "label": "Moth. Thank you.",
              "next": "end"
            }
          ]
        },
        "end": {
          "speaker": "MOTH · the intercom of NRLU 404 0451",
          "pages": [
            "No promises. I'm a moth. Go on. And feed Sprat."
          ],
          "onEnter": "stacks.moth.finish",
          "redirect": [
            {
              "when": {
                "state": "stacks.talked",
                "is": true
              },
              "node": "end-completed"
            }
          ]
        },
        "end-completed": {
          "speaker": "MOTH · the intercom of NRLU 404 0451",
          "pages": [
            "No promises. I'm a moth. Go on. And feed Sprat."
          ]
        }
      }
    },
    "talk.stacks.gatekeeper": {
      "entry": [
        {
          "when": {
            "state": "talk.stacks.gatekeeper.cursor",
            "is": 0
          },
          "node": "visit-0"
        },
        {
          "node": "visit-1"
        }
      ],
      "nodes": {
        "visit-0": {
          "speaker": "GATEKEEPER",
          "pages": [
            "Terminal 2. Authorised vehicles only.",
            "You are not a vehicle, so the rule does not cover you. I am not paid to extend it."
          ],
          "onEnter": "talk.stacks.gatekeeper.advance-0"
        },
        "visit-1": {
          "speaker": "GATEKEEPER",
          "pages": [
            "Warehouse 4 is down the lane. Registry evidence now. Used to be the Tide's.",
            "I used to wave at the Tide's trucks. Now I wave at nobody, on a schedule."
          ],
          "onEnter": "talk.stacks.gatekeeper.advance-1"
        }
      }
    },
    "talk.stacks.inspector": {
      "entry": [
        {
          "when": {
            "state": "talk.stacks.inspector.cursor",
            "is": 0
          },
          "node": "visit-0"
        },
        {
          "when": {
            "state": "talk.stacks.inspector.cursor",
            "is": 1
          },
          "node": "visit-1"
        },
        {
          "node": "visit-2"
        }
      ],
      "nodes": {
        "visit-0": {
          "speaker": "PORT INSPECTOR",
          "pages": [
            "Thermal inspection. A container is meant to be the temperature on its label.",
            "A reefer at four degrees reads four. If it reads thirty-one, something in it is breathing, and breathing cargo is my paperwork."
          ],
          "onEnter": "talk.stacks.inspector.advance-0"
        },
        "visit-1": {
          "speaker": "PORT INSPECTOR",
          "pages": [
            "The gate wires itself to the alarm. I don't touch it. The Registry's watchdog checks the wiring every round.",
            "When the dog sits on my gate the whole gate freezes. Nothing gets in or out of it. I take my break then. Everyone does."
          ],
          "onEnter": "talk.stacks.inspector.advance-1"
        },
        "visit-2": {
          "speaker": "PORT INSPECTOR",
          "pages": [
            "The crane only lifts once the dog has cleared the ferry. Then it's three seconds and it's back at my gate.",
            "You learn its walk. Port, crane, ferry. Port, crane, ferry. Like a man who forgot why he came into a room."
          ],
          "onEnter": "talk.stacks.inspector.advance-2"
        }
      }
    },
    "talk.stacks.signaller": {
      "entry": [
        {
          "when": {
            "state": "talk.stacks.signaller.cursor",
            "is": 0
          },
          "node": "visit-0"
        },
        {
          "node": "visit-1"
        }
      ],
      "nodes": {
        "visit-0": {
          "speaker": "SIGNALLER",
          "pages": [
            "I wave at the crane. The crane ignores me.",
            "Forty years. Longest relationship I've had."
          ],
          "onEnter": "talk.stacks.signaller.advance-0"
        },
        "visit-1": {
          "speaker": "SIGNALLER",
          "pages": [
            "The camera on STS-2 reads every roof in the blocks. The yard system lost one tonight. The camera never loses anything. Shame about the people upstairs."
          ],
          "onEnter": "talk.stacks.signaller.advance-1"
        }
      }
    },
    "talk.stacks.lasher": {
      "entry": [
        {
          "when": {
            "state": "talk.stacks.lasher.cursor",
            "is": 0
          },
          "node": "visit-0"
        },
        {
          "node": "visit-1"
        }
      ],
      "nodes": {
        "visit-0": {
          "speaker": "LASHER",
          "pages": [
            "Eleven boxes down the hatch, lashed. One slot on deck for a reefer, plug ready.",
            "Schedule says NRLU-something. Yard system says it doesn't exist. I've lashed things that don't exist before. They pay the same."
          ],
          "onEnter": "talk.stacks.lasher.advance-0"
        },
        "visit-1": {
          "speaker": "LASHER",
          "pages": [
            "The ferry leaves when it's full. It's been one box from full since Tuesday.",
            "The captain's asleep in the bridge. He says wake him when it's full. He says it like a man who knows."
          ],
          "onEnter": "talk.stacks.lasher.advance-1"
        }
      }
    },
    "talk.stacks.tally": {
      "entry": [
        {
          "when": {
            "state": "talk.stacks.tally.cursor",
            "is": 0
          },
          "node": "visit-0"
