        }
      ],
      "nodes": {
        "visit-0": {
          "speaker": "GULL",
          "pages": [
            "(The gull looks at you, then at the stack under its feet, then screams as if you own it.)"
          ],
          "onEnter": "talk.stacks.gull1.advance-0"
        },
        "visit-1": {
          "speaker": "GULL",
          "pages": [
            "(It edges along the container roof to keep exactly out of reach.)"
          ],
          "onEnter": "talk.stacks.gull1.advance-1"
        }
      }
    },
    "talk.stacks.gull2": {
      "entry": [
        {
          "when": {
            "state": "talk.stacks.gull2.cursor",
            "is": 0
