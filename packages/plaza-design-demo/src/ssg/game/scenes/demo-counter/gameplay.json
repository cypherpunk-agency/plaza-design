          ],
          "onEnter": "talk.shop.android.advance-0"
        },
        "visit-1": {
          "speaker": "CUSTOMER",
          "pages": [
            "People ask what I do for fun. I queue. I am very good at it. I have never once been served first."
          ],
          "onEnter": "talk.shop.android.advance-1"
        }
      }
    },
