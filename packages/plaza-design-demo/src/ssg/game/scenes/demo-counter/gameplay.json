  "conversations": {
    "demo.desk": {
      "entry": [
        {
          "node": "desk"
        }
      ],
      "nodes": {
        "desk": {
          "speaker": "TEST DESK",
          "pages": [
            "Choose a scenario. A discount changes quote and charge. A hidden fee changes only the charge. Those are explicit model settings, not separate demo code."
          ],
          "choices": [
            {
              "id": "normal",
              "label": "Normal price",
              "command": "demo.normal",
              "next": "normal"
            },
            {
              "id": "discount",
              "label": "Enable discount",
              "command": "demo.discount-on",
              "next": "discount"
            },
            {
              "id": "fee",
              "label": "Enable hidden fee",
              "command": "demo.fee-on",
              "next": "fee"
            },
            {
              "id": "credit",
              "label": "Add 10 test tokens",
              "command": "demo.credit",
              "next": "credit"
            },
            {
              "id": "buy",
              "label": "Buy here through conversation",
              "command": "demo.buy",
              "next": "bought"
            },
            {
              "id": "cancel",
              "label": "Leave unchanged",
              "next": "bye"
            },
            {
              "id": "refill",
              "label": "Refill stock to eight",
              "command": "demo.refill",
              "next": "stock"
            },
            {
              "id": "empty",
              "label": "Set stock to zero",
              "command": "demo.empty",
              "next": "stock"
            }
          ]
        },
        "normal": {
          "speaker": "TEST DESK",
          "pages": [
            "Normal pricing restored."
          ],
          "choices": [
            {
              "id": "back",
              "label": "Back",
              "next": "desk"
            }
          ]
        },
        "discount": {
          "speaker": "TEST DESK",
          "pages": [
            "Discount enabled. Quote and charge both decrease by one."
          ],
          "choices": [
            {
              "id": "back",
              "label": "Back",
              "next": "desk"
            }
          ]
        },
        "fee": {
          "speaker": "TEST DESK",
          "pages": [
            "Hidden fee enabled. The charge increases by two; the displayed quote does not."
          ],
          "choices": [
            {
              "id": "back",
              "label": "Back",
              "next": "desk"
            }
          ]
        },
        "credit": {
          "speaker": "TEST DESK",
          "pages": [
            "Ten test tokens credited."
          ],
          "choices": [
            {
              "id": "back",
              "label": "Back",
              "next": "desk"
            }
          ]
        },
        "bought": {
          "speaker": "TEST DESK",
          "pages": [
            "The same purchase command charged you, delivered the next good and advanced stock."
          ],
          "choices": [
            {
              "id": "back",
              "label": "Back",
              "next": "desk"
            }
          ]
        },
        "bye": {
          "speaker": "TEST DESK",
          "pages": [
            "No changes. You can close this conversation."
          ]
        },
        "stock": {
          "speaker": "TEST DESK",
          "pages": [
            "Stock changed through a shared command. An empty purchase must refuse without charging or advancing rotation."
          ],
          "choices": [
            {
              "id": "back",
              "label": "Back",
              "next": "desk"
            }
          ]
        }
      }
    },
    "demo.mission": {
      "entry": [
        {
          "node": "setup"
        }
      ],
      "nodes": {
        "setup": {
          "speaker": "GUIDANCE EXAMPLE",
          "pages": [
            "Start a small task here. Try buying before permission, then authorize and buy. Leave the example to return to ordinary purchase testing."
          ],
          "choices": [
            {
              "id": "mission-start",
              "label": "Start guidance example",
              "command": "demo.mission.start",
              "next": "mission"
            },
            {
              "id": "mission-leave",
              "label": "Leave guidance example",
              "command": "demo.mission.leave",
              "next": "setup"
            },
            {
              "id": "permit-current",
              "label": "Authorize current task",
              "when": {
                "flag": "demo.mission"
              },
              "command": "demo.mission.permit",
              "next": "setup"
            }
          ]
        },
        "mission": {
          "speaker": "TASK PERMISSION",
          "pages": [
            "Try buying before permission is granted. Then authorize the task here and buy once. The goal should update after success."
          ],
          "choices": [
            {
              "id": "permit",
              "label": "Authorize purchase task",
              "command": "demo.mission.permit",
              "next": "setup"
            },
            {
              "id": "back",
              "label": "Return without permission",
              "next": "setup"
            }
          ]
        }
      }
    },
    "talk.shop.keeper": {
      "entry": [
        {
          "when": {
            "state": "talk.shop.keeper.cursor",
            "is": 0
          },
          "node": "visit-0"
        },
        {
          "node": "visit-1"
        }
      ],
      "nodes": {
        "visit-0": {
          "speaker": "SHOPKEEPER",
          "pages": [
            "The quote and charge share a base price. The Test Desk can change the rules."
          ],
          "onEnter": "talk.shop.keeper.advance-0"
        },
        "visit-1": {
          "speaker": "SHOPKEEPER",
          "pages": [
            "I remember you. My stock remembers your purchases, too."
          ],
          "onEnter": "talk.shop.keeper.advance-1"
        }
      }
    },
