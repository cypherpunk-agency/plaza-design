      "nodes": {
        "visit-0": {
          "speaker": "CUSTOMER",
          "pages": [
            "They moved the cheap noodles to the top shelf.",
            "Top shelf is for people with legs.so. I have the free legs."
          ],
          "onEnter": "talk.shop.browser.advance-0"
        },
        "visit-1": {
          "speaker": "CUSTOMER",
          "pages": [
            "I come in to read the labels. It is warmer than the library and the library closed."
          ],
          "onEnter": "talk.shop.browser.advance-1"
        }
      }
    },
