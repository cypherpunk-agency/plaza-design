{
  "version": 1,
  "id": "harborShift",
  "name": "Harbor · night shift",
  "intro": [
    "Sundown. Another night on transport. The supervisor is waiting by the office."
  ],
  "objectives": [
    {
      "id": "step-1",
      "text": "Walk right to the supervisor · E to talk",
      "when": {
        "flag": "shift:assigned",
        "is": false
      },
      "target": "boss"
    },
    {
      "id": "step-2",
      "text": "Pick up the blue parcel at DISPATCH",
      "when": {
        "flag": "shift:parcel",
        "is": false
      },
      "target": "parcel"
    },
    {
      "id": "step-3",
      "text": "Bring the blue parcel to Mara at RECEIVING",
      "when": {
        "flag": "shift:delivered",
        "is": false
      },
      "target": "mara"
    },
    {
      "id": "step-4",
      "text": "Take the empty case from the receiving counter",
      "when": {
        "flag": "shift:case",
        "is": false
      },
      "target": "case",
      "gentle": true
    },
    {
      "id": "step-5",
      "text": "Return the empty case to its rack",
      "when": {
        "flag": "shift:returned",
        "is": false
      },
      "target": "rack",
      "gentle": true
    },
    {
      "id": "step-6",
      "text": "Report back to the supervisor",
      "when": {
        "flag": "shift:trolley",
        "is": false
      },
      "target": "boss"
    },
    {
      "id": "step-7",
      "text": "Release the red wheel clamp beside the trolley",
      "when": {
        "all": [
          {
            "flag": "shift:inspected",
            "is": true
          },
          {
            "flag": "shift:released",
            "is": false
          }
        ]
      },
      "target": "clamp"
    },
    {
      "id": "step-8",
      "text": "Move the trolley to the marked loading bay",
      "when": {
        "flag": "shift:released",
        "is": false
      },
      "target": "trolley"
    },
    {
      "id": "step-9",
      "text": "Push the released trolley into the loading bay",
      "when": {
        "flag": "shift:parked",
        "is": false
      },
      "target": "trolley"
    },
    {
      "id": "step-10",
      "text": "Return your work tag at CHECKOUT",
      "when": {
        "flag": "shift:checked",
        "is": false
      },
      "target": "checkout"
    },
    {
      "id": "step-11",
      "text": "Read your wage statement",
      "when": {
        "flag": "shift:done",
        "is": false
      },
      "target": "statement"
    },
    {
      "id": "step-12",
      "text": "SHIFT COMPLETE · Your work is done. Take a breath."
    }
  ],
  "time": [
    {
      "when": {
        "flag": "shift:checked",
        "is": true
      },
      "minute": 325
    },
    {
      "when": {
        "flag": "shift:parked",
        "is": true
      },
      "minute": 300
    },
    {
      "when": {
        "flag": "shift:trolley",
        "is": true
      },
      "minute": 180
    },
    {
      "when": {
        "flag": "shift:returned",
        "is": true
      },
      "minute": 60
    },
    {
      "when": {
        "flag": "shift:delivered",
        "is": true
      },
      "minute": 1320
    },
    {
      "minute": 1120
    }
  ],
  "uses": [
    {
      "id": "boss",
      "name": "SUPERVISOR",
      "label": "[E] TALK TO SUPERVISOR",
      "routes": [
        {
          "conversation": "supervisor-shift"
        }
      ],
      "conversationPresentation": "bubble"
    },
    {
      "id": "parcel",
      "name": "DISPATCH",
      "label": "[E] PICK UP BLUE PARCEL",
      "routes": [
        {
          "when": {
            "flag": "shift:parcel",
            "is": true
          },
          "pages": [
            "You have already collected this delivery."
          ]
        },
        {
          "command": "shift.collect",
          "pages": [
            "You pick up the blue parcel. RECEIVING · MARA.",
            "Carry it to the receiving counter on the right."
          ],
          "failure": [
            "The supervisor has not assigned this delivery."
          ]
        }
      ],
      "when": {
        "all": [
          {
            "flag": "shift:assigned",
            "is": true
          },
          {
            "flag": "shift:parcel",
            "is": false
          }
        ]
      }
    },
    {
      "id": "mara",
      "name": "MARA",
      "label": "[E] TALK TO MARA",
      "routes": [
        {
          "conversation": "mara"
        }
      ],
      "when": {
        "flag": "shift:assigned",
        "is": true
      },
      "items": [
        {
          "item": "shift.parcel",
          "label": "give Mara the blue parcel",
          "routes": [
            {
              "when": {
                "flag": "shift:delivered",
                "is": true
              },
              "pages": [
                "Already logged. You can keep your hands free."
              ]
            },
            {
              "command": "shift.deliver",
              "pages": [
                "Thanks. Pump seals. Maybe the floor gets to stay dry tonight.",
                "Could you return the empty case on my counter to the rack?"
              ],
              "failure": [
                "The blue parcel is waiting at dispatch, to the left."
              ]
            }
          ]
        }
      ],
      "conversationPresentation": "bubble"
    },
    {
      "id": "case",
      "name": "EMPTY CASE",
      "label": "[E] TAKE EMPTY CASE",
      "routes": [
        {
          "when": {
            "flag": "shift:case",
            "is": true
          },
          "pages": [
            "The case has already been collected."
          ]
        },
        {
          "command": "shift.collect-case",
          "pages": [
            "You take the empty transport case."
          ],
          "failure": [
            "The delivery has not been registered yet."
          ]
        }
      ],
      "when": {
        "all": [
          {
            "flag": "shift:delivered",
            "is": true
          },
          {
            "flag": "shift:case",
            "is": false
          }
        ]
      }
    },
    {
      "id": "rack",
      "name": "CASE RACK",
      "label": "[E] CASE RETURNS",
      "routes": [
        {
          "when": {
            "flag": "shift:returned",
            "is": true
          },
          "pages": [
            "The case is back in its place."
          ]
        },
        {
          "command": "shift.return-case",
          "pages": [
            "The case settles into the rack. RETURN REGISTERED.",
            "The supervisor has one last job."
          ],
          "failure": [
            "EMPTY CASE RETURNS · Bring a transport case from receiving."
          ]
        }
      ],
      "when": {
        "flag": "shift:delivered",
        "is": true
      },
      "items": [
        {
          "item": "shift.case",
          "label": "put the empty case in the rack",
          "routes": [
            {
              "when": {
                "flag": "shift:returned",
                "is": true
              },
              "pages": [
                "The case is back in its place."
              ]
            },
            {
              "command": "shift.return-case",
              "pages": [
                "The case settles into the rack. RETURN REGISTERED.",
                "The supervisor has one last job."
              ],
              "failure": [
                "EMPTY CASE RETURNS · Bring a transport case from receiving."
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "trolley",
      "name": "LOADING TROLLEY",
      "label": "[E] PUSH TROLLEY",
      "routes": [
        {
          "when": {
            "flag": "shift:released",
            "is": false
          },
          "command": "shift.inspect",
          "pages": [
            "It will not roll. A red wheel clamp is still fastened around the near wheel.",
            "A release handle sits just beside it."
          ]
        },
        {
          "command": "shift.park",
          "pages": [
            "The wheels roll freely. You push the trolley into the striped bay.",
            "LOADING POSITION CONFIRMED. You can check out."
          ]
        }
      ],
      "when": {
        "all": [
          {
            "flag": "shift:trolley",
            "is": true
          },
          {
            "flag": "shift:parked",
            "is": false
          }
        ]
      }
    },
    {
      "id": "clamp",
      "name": "WHEEL CLAMP",
      "label": "[E] RELEASE CLAMP",
      "routes": [
        {
          "command": "shift.release",
          "pages": [
            "You pull the handle. The clamp opens and its indicator turns green."
          ]
        }
      ],
      "when": {
        "all": [
          {
            "flag": "shift:inspected",
            "is": true
          },
          {
            "flag": "shift:released",
            "is": false
          }
        ]
      }
    },
    {
      "id": "checkout",
      "name": "CHECKOUT",
      "label": "[E] CHECK OUT",
      "routes": [
        {
          "when": {
            "flag": "shift:checked",
            "is": true
          },
          "pages": [
            "TAG RETURNED · SHIFT CLOSED. Your statement is ready."
          ]
        },
        {
          "when": {
            "flag": "shift:parked",
            "is": false
          },
          "pages": [
            "SHIFT OPEN · Loading trolley not parked."
          ]
        },
        {
          "command": "shift.checkout",
          "pages": [
            "IDENTITY VERIFIED · TAG RETURNED · SHIFT CLOSED.",
            "Three tokens credited. Your wage statement is ready to read."
          ],
          "failure": [
            "A work tag is required. Ask the supervisor for yours."
          ]
        }
      ],
      "when": {
        "flag": "shift:trolley",
        "is": true
      },
      "items": [
        {
          "item": "shift.tag",
          "label": "return work tag and check out",
          "routes": [
            {
              "when": {
                "flag": "shift:checked",
                "is": true
              },
              "pages": [
                "TAG RETURNED · SHIFT CLOSED. Your statement is ready."
              ]
            },
            {
              "when": {
                "flag": "shift:parked",
                "is": false
              },
              "pages": [
                "SHIFT OPEN · Loading trolley not parked."
              ]
            },
            {
              "command": "shift.checkout",
              "pages": [
                "IDENTITY VERIFIED · TAG RETURNED · SHIFT CLOSED.",
                "Three tokens credited. Your wage statement is ready to read."
              ],
              "failure": [
                "A work tag is required. Ask the supervisor for yours."
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "statement",
      "name": "WAGE STATEMENT",
      "label": "[E] READ STATEMENT",
      "routes": [
        {
          "command": "shift.statement",
          "pages": [
            "NIGHT SHIFT · GROSS 4 TOKENS · EQUIPMENT ACCESS 1 TOKEN · NET 3 TOKENS.",
            "STATUS: PAID. YOUR IDENTITY REMAINS IN GOOD STANDING.",
            "Shift complete. The morning train is next. For now, your work is done."
          ]
        }
      ],
      "when": {
        "flag": "shift:checked",
        "is": true
      }
    }
  ],
