{
  "version": 1,
  "flags": ["shift:assigned","shift:parcel","shift:delivered","shift:case","shift:returned","shift:trolley","shift:inspected","shift:released","shift:parked","shift:checked","shift:done"],
  "items": ["shift.tag","shift.parcel","shift.case"],
  "events": ["assignment.accepted","work-tag.issued","parcel.collected","parcel.transferred","delivery.completed","case.collected","case.returned","trolley.assigned","clamp.discovered","clamp.released","trolley.parked","shift.checked-out","wages.paid","statement.read"],
  "commands": {
    "shift.accept": {"sources":["conversation"],"when":{"flag":"shift:assigned","is":false},"actions":[{"flag":"shift:assigned","value":true},{"emit":"assignment.accepted"}]},
    "shift.issue-tag": {"sources":["system"],"actions":[{"item":"shift.tag","add":1},{"emit":"work-tag.issued"}]},
    "shift.replace-tag": {"sources":["interaction"],"when":{"all":[{"flag":"shift:checked","is":false},{"not":{"item":"shift.tag","atLeast":1}}]},"actions":[{"item":"shift.tag","add":1},{"emit":"work-tag.issued"}]},
    "shift.collect": {"sources":["interaction"],"when":{"all":[{"flag":"shift:assigned"},{"flag":"shift:parcel","is":false}]},"actions":[{"item":"shift.parcel","add":1},{"flag":"shift:parcel","value":true},{"emit":"parcel.collected"}]},
    "shift.deliver": {"sources":["interaction","signal"],"when":{"all":[{"flag":"shift:assigned"},{"flag":"shift:delivered","is":false},{"item":"shift.parcel","atLeast":1}]},"actions":[{"item":"shift.parcel","add":-1},{"emit":"parcel.transferred"}]},
    "shift.record-delivery": {"sources":["system"],"actions":[{"flag":"shift:delivered","value":true},{"emit":"delivery.completed"}]},
    "shift.collect-case": {"sources":["interaction"],"when":{"all":[{"flag":"shift:delivered"},{"flag":"shift:case","is":false}]},"actions":[{"item":"shift.case","add":1},{"flag":"shift:case","value":true},{"emit":"case.collected"}]},
    "shift.return-case": {"sources":["interaction"],"when":{"all":[{"flag":"shift:returned","is":false},{"item":"shift.case","atLeast":1}]},"actions":[{"item":"shift.case","add":-1},{"flag":"shift:returned","value":true},{"emit":"case.returned"}]},
    "shift.assign-trolley": {"sources":["conversation"],"when":{"all":[{"flag":"shift:returned"},{"flag":"shift:trolley","is":false}]},"actions":[{"flag":"shift:trolley","value":true},{"emit":"trolley.assigned"}]},
    "shift.inspect": {"sources":["interaction"],"when":{"all":[{"flag":"shift:trolley"},{"flag":"shift:released","is":false}]},"actions":[{"flag":"shift:inspected","value":true},{"emit":"clamp.discovered"}]},
    "shift.release": {"sources":["interaction"],"when":{"all":[{"flag":"shift:inspected"},{"flag":"shift:released","is":false}]},"actions":[{"flag":"shift:released","value":true},{"emit":"clamp.released"}]},
    "shift.park": {"sources":["interaction"],"when":{"all":[{"flag":"shift:trolley"},{"flag":"shift:released"},{"flag":"shift:parked","is":false}]},"actions":[{"flag":"shift:parked","value":true},{"emit":"trolley.parked"}]},
    "shift.checkout": {"sources":["interaction"],"when":{"all":[{"flag":"shift:parked"},{"flag":"shift:checked","is":false},{"item":"shift.tag","atLeast":1}]},"actions":[{"item":"shift.tag","add":-1},{"flag":"shift:checked","value":true},{"emit":"shift.checked-out"}]},
    "shift.credit-wages": {"sources":["system"],"actions":[{"tokens":3},{"emit":"wages.paid"}]},
    "shift.statement": {"sources":["interaction"],"when":{"flag":"shift:checked"},"actions":[{"flag":"shift:done","value":true},{"emit":"statement.read"}]}
  },
  "reactions": [
    {"event":"assignment.accepted","command":"shift.issue-tag"},
    {"event":"parcel.transferred","command":"shift.record-delivery"},
    {"event":"shift.checked-out","command":"shift.credit-wages"}
  ],
  "conversations": {
    "supervisor": {
      "entry": [
        {"when":{"flag":"shift:assigned","is":false},"node":"offer"},
        {"when":{"all":[{"flag":"shift:returned"},{"flag":"shift:trolley","is":false}]},"node":"trolley-offer"},
        {"when":{"flag":"shift:done"},"node":"off-duty"},
        {"node":"reminder"}
      ],
      "nodes": {
        "offer": {"speaker":"SUPERVISOR","pages":["You are on transport. There is a parcel for receiving."],"choices":[{"id":"accept","label":"I'll take the assignment.","command":"shift.accept","next":"assigned"},{"id":"later","label":"Give me a moment.","next":"later"}]},
        "assigned": {"speaker":"SUPERVISOR","pages":["You are on transport. Here is your work tag.","Pick up the blue parcel at dispatch, just to my right. Bring it to Mara at receiving.","The Registry pays for completed movements. Try to have some."]},
        "later": {"speaker":"SUPERVISOR","pages":["The parcel will be here. So will I."]},
        "trolley-offer": {"speaker":"SUPERVISOR","pages":["One last job before checkout."],"choices":[{"id":"accept","label":"What's the last job?","command":"shift.assign-trolley","next":"trolley"}]},
        "trolley": {"speaker":"SUPERVISOR","pages":["Last job. Move the trolley into the striped loading bay, then check out.","The day crew needs the space. They are very particular about other people doing their work."]},
        "off-duty": {"speaker":"SUPERVISOR","pages":["You are off the clock. I am contractually unable to notice you."]},
        "reminder": {"speaker":"SUPERVISOR","pages":["{objective}.","Ask if you need the assignment again."]}
      }
    },
    "mara": {
      "entry":[{"when":{"flag":"shift:delivered","is":false},"node":"waiting"},{"when":{"flag":"shift:returned","is":false},"node":"case"},{"node":"thanks"}],
      "nodes":{
        "waiting":{"speaker":"MARA","pages":["Blue parcel for me? Use “give Mara the blue parcel” when you have it.","He makes every shift sound like a national emergency."]},
        "case":{"speaker":"MARA","pages":["The empty case goes in the rack to the left. Thank you."]},
        "thanks":{"speaker":"MARA","pages":["You got the case back. That is one less thing for the next shift.","Same train home? Get some sleep when you can."]}
      }
    }
  }
}
