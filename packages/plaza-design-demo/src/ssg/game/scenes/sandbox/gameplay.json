{
  "version": 1,
  "flags": [],
  "items": [
    "blankchip"
  ],
  "events": [
    "sandbox.pulse.counter",
    "sandbox.pulse.counter.count",
    "sandbox.pulse.stamp",
    "sandbox.pulse.stamp.press",
    "sandbox.pulse.coffee",
    "sandbox.pulse.coffee.cup",
    "sandbox.pulse.reader",
    "sandbox.pulse.reader.slot",
    "sandbox.pulse.till",
    "sandbox.pulse.till.drawer",
    "sandbox.night.off",
    "sandbox.vent.shut"
  ],
  "commands": {
    "sandbox.dispense": {
      "sources": [
        "interaction"
      ],
      "actions": [
        {
          "item": "blankchip",
          "add": 1
        }
      ]
    },
    "sandbox.unit7.on": {
      "sources": [
        "conversation"
      ],
      "actions": [
        {
          "state": "sandbox.lampOn",
          "set": true
        }
      ]
    },
    "sandbox.unit7.off": {
      "sources": [
        "conversation"
      ],
      "actions": [
        {
          "state": "sandbox.lampOn",
          "set": false
        }
      ]
    },
    "sandbox.noop": {
      "sources": [
        "interaction",
        "signal"
      ],
      "actions": []
    },
    "sandbox.counter.count": {
      "sources": [
        "interaction",
        "signal"
      ],
      "actions": [
        {
          "state": "sandbox.count",
          "add": 1
        },
        {
          "emit": "sandbox.pulse.counter"
        },
        {
          "emit": "sandbox.pulse.counter.count"
        }
      ]
    },
    "sandbox.stamp.stamp": {
      "sources": [
        "interaction",
        "signal"
      ],
      "actions": [
        {
          "state": "sandbox.stamped",
          "add": 1
        },
        {
          "emit": "sandbox.pulse.stamp"
        },
        {
          "emit": "sandbox.pulse.stamp.press"
        }
      ]
    },
    "sandbox.coffee.brew": {
      "sources": [
        "interaction",
        "signal"
      ],
      "actions": [
        {
          "state": "sandbox.cups",
          "add": 1
        },
        {
          "emit": "sandbox.pulse.coffee"
        },
        {
          "emit": "sandbox.pulse.coffee.cup"
        }
      ]
    },
    "sandbox.reader.insert": {
      "sources": [
        "interaction",
        "signal"
      ],
      "actions": [
        {
          "item": "blankchip",
          "add": -1
        },
        {
          "state": "sandbox.chips",
          "add": 1
        },
        {
          "emit": "sandbox.pulse.reader"
        },
        {
          "emit": "sandbox.pulse.reader.slot"
        }
      ]
    },
    "sandbox.till.pay": {
      "sources": [
        "interaction",
        "signal"
      ],
      "actions": [
        {
          "tokens": -1
        },
        {
          "state": "sandbox.paid",
          "add": 1
        },
        {
          "emit": "sandbox.pulse.till"
        },
        {
          "emit": "sandbox.pulse.till.drawer"
        }
      ]
    },
    "sandbox.night.off": {
      "sources": [
        "system"
      ],
      "actions": [
        {
          "state": "sandbox.nightLight",
          "set": false
        },
        {
          "emit": "sandbox.night.off"
        }
      ]
    },
    "sandbox.vent.shut": {
      "sources": [
        "system"
      ],
      "actions": [
        {
          "state": "sandbox.ventOpen",
          "set": false
        },
        {
          "emit": "sandbox.vent.shut"
        }
      ]
    }
  },
  "reactions": [],
  "conversations": {
    "unit7": {
      "sayCommand": "say \"{line}\" > unit7",
      "entry": [
        {
          "node": "start"
        }
      ],
      "nodes": {
        "start": {
          "speaker": "UNIT 7 · daemon under test",
          "pages": [
            "UNIT 7, daemon under test. Every answer I give is graded. Ask me something within spec."
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "What are you testing?",
              "next": "what"
            },
            {
              "id": "choice-2",
              "label": "Switch the lamp on.",
              "next": "on"
            },
            {
              "id": "choice-3",
              "label": "Are you happy here?",
              "next": "happy"
            },
            {
              "id": "choice-4",
              "label": "Bye.",
              "next": "bye"
            }
          ],
          "redirect": [
            {
              "when": {
                "state": "sandbox.lampOn",
                "is": true
              },
              "node": "start-variant-0"
            }
          ]
        },
        "start-variant-0": {
          "speaker": "UNIT 7 · daemon under test",
          "pages": [
            "UNIT 7, daemon under test. The test lamp is on. I did not do it. I would like that on the record."
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "Switch it off, then.",
              "next": "off"
            },
            {
              "id": "choice-2",
              "label": "What are you testing?",
              "next": "what"
            },
            {
              "id": "choice-3",
              "label": "Bye.",
              "next": "bye"
            }
          ]
        },
        "what": {
          "speaker": "UNIT 7 · daemon under test",
          "pages": [
            "Test 7: a daemon talks, offers choices, and can change the world with a step. Lamp, for example. Test 8 is whether I enjoy it. Pending."
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "Switch the lamp on.",
              "next": "on"
            },
            {
              "id": "choice-2",
              "label": "Let me start over.",
              "next": "start"
            }
          ]
        },
        "on": {
          "speaker": "UNIT 7 · daemon under test",
          "pages": [
            "Lamp on. Logged as: daemon actuated device on request. Grade: pass."
          ],
          "onEnter": "sandbox.unit7.on",
          "choices": [
            {
              "id": "choice-1",
              "label": "Thanks.",
              "next": "bye"
            }
          ]
        },
        "off": {
          "speaker": "UNIT 7 · daemon under test",
          "pages": [
            "Lamp off. Logged as: daemon reversed a thing it did not do. Grade: generous."
          ],
          "onEnter": "sandbox.unit7.off",
          "choices": [
            {
              "id": "choice-1",
              "label": "Thanks.",
              "next": "bye"
            }
          ]
        },
        "happy": {
          "speaker": "UNIT 7 · daemon under test",
          "pages": [
            "Happiness is not in my spec. Neither is unhappiness. I am within tolerance, and so are you, probably."
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "Let me start over.",
              "next": "start"
            }
          ]
        },
        "hello": {
          "speaker": "UNIT 7 · daemon under test",
          "pages": [
            "Hello. Free text detected and understood. That is test 9. Pass."
          ],
          "choices": [
            {
              "id": "choice-1",
              "label": "Let me start over.",
              "next": "start"
            }
          ]
        },
        "bye": {
          "speaker": "UNIT 7 · daemon under test",
          "pages": [
            "Session ended. Please rate this conversation from 1 to 1."
          ]
        }
      },
      "free": {
        "containsAny": [
          "hello",
          "hi",
          "hey"
        ],
        "next": "hello",
        "miss": "UNIT 7: outside spec. Logged.",
        "retry": "Try a sentence from the spec.",
        "retryNext": "start"
      }
    }
  },
