  "native": {
    "verbs": [
      {
        "device": "counter",
        "noun": "count",
        "verb": "count",
        "cases": [
          {
            "command": "sandbox.counter.count",
            "template": true,
            "say": [
              "{via}count",
              "COUNTER: {state:sandbox.count}.",
              "dim"
            ]
          }
        ]
      },
      {
        "device": "stamp",
        "noun": "press",
        "verb": "stamp",
        "cases": [
          {
            "command": "sandbox.stamp.stamp",
            "template": true,
            "say": [
              "{via}stamp",
              "STAMP: APPROVED. ({state:sandbox.stamped} today)",
              "ok"
            ]
          }
        ]
      },
      {
        "device": "coffee",
        "noun": "cup",
        "verb": "brew",
        "cases": [
          {
            "command": "sandbox.coffee.brew",
            "template": true,
            "say": [
              "{via}brew",
              "COFFEE: one cup. logged. {state:sandbox.cups} today.",
              "ok"
            ]
          }
        ]
      },
      {
        "device": "reader",
        "noun": "slot",
        "verb": "insert",
        "cases": [
          {
            "command": "sandbox.reader.insert",
            "template": true,
            "say": [
              "insert chip",
              "CHIP READER: chip read, chip kept. tested: {state:sandbox.chips}.",
              "ok"
            ],
            "when": {
              "item": "blankchip",
              "atLeast": 1
            }
          },
          {
            "command": "sandbox.noop",
            "say": [
              "insert chip",
              "CHIP READER: no blank chip. the dispenser beside it has some.",
              "err"
            ]
          }
        ]
      },
      {
        "device": "till",
        "noun": "drawer",
        "verb": "pay",
        "cases": [
          {
            "command": "sandbox.till.pay",
            "template": true,
            "say": [
              "pay 1",
              "TILL: 1 token received. receipt printed. total: {state:sandbox.paid}.",
              "ok"
            ],
            "when": {
              "tokensAtLeast": 1
            }
          },
          {
            "command": "sandbox.noop",
            "say": [
              "pay 1",
              "TILL: 1 token required. none presented.",
              "err"
            ]
          }
        ]
      }
    ],
