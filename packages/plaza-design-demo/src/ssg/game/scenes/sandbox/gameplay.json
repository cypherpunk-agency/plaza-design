    },
    "triggers": {
      "sandbox.daylight": {
        "when": {
          "all": [
            {
              "state": "sandbox.nightLight",
              "is": true
            },
            {
              "time": {
                "from": "06:00",
                "to": "18:00"
              }
            }
          ]
        },
        "command": "sandbox.night.off"
      },
      "sandbox.weather": {
        "when": {
          "all": [
            {
              "state": "sandbox.ventOpen",
              "is": true
            },
            {
              "weather": [
                "rain",
                "storm",
                "smog"
              ]
            }
          ]
        },
        "command": "sandbox.vent.shut"
      }
    },
    "replies": {
      "sandbox.night.off": {
        "from": "nightlight",
        "say": [
          "photocell",
          "NIGHT LIGHT: daylight. off by itself.",
          "dim"
        ]
      },
      "sandbox.vent.shut": {
        "from": "vent",
        "say": [
          "vent",
          "VENT: {world:weather} detected. shut by itself.",
          "dim"
        ],
        "template": true
      }
    }
