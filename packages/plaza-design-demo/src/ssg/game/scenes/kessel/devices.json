{
  "id": "kessel",
  "name": "Noodle stall kitchen",
  "tuning": {},
  "devices": [
    {
      "id": "shutter",
      "name": "PRIVACY SHUTTER",
      "look": "A roller shutter over an alcove. Clinic privacy, motorised, the kind a building controls and a doctor pretends to.",
      "status": [
        {
          "if": "shutterOpen",
          "then": "open",
          "else": "closed · privacy mode"
        }
      ],
      "layout": {
        "spot": {
          "x": 596,
          "y": -100,
          "w": 64,
          "h": 66
        },
        "board": {
          "x": 0.5,
          "y": 0.7
        }
      },
      "nouns": [
        {
          "id": "motor",
          "layer": "hardware",
          "function": "act",
          "verbs": [
            "open",
            "close"
          ],
          "on": {
            "open": [
              {
                "if": "shutterOpen",
                "say": [
                  "{via}use motor --open",
                  "already open.",
                  "dim"
                ]
              },
              {
                "do": [
                  {
                    "set": "shutterOpen",
                    "to": true
                  }
                ],
                "say": [
                  "{via}use motor --open",
                  "the shutter rattles up. behind it: shells. robot bodies, empty, waiting.",
                  "ok"
                ]
              }
            ],
            "close": {
              "do": [
                {
                  "set": "shutterOpen",
                  "to": false
                }
              ],
              "say": [
                "{via}use motor --close",
                "the shutter rolls down.",
                "dim"
              ]
            }
          }
        }
      ]
    }
  ],
  "cables": [],
  "dialogue": {},
  "goals": [],
  "texts": {}
}
