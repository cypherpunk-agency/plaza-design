{
  "version": 1,
  "id": "kessel",
  "name": "Kessel's rooms",
  "intro": [],
  "uses": [
    {
      "id": "kessel",
      "name": "DR. KESSEL",
      "label": "[E] TALK",
      "conversationPresentation": "bubble",
      "routes": [
        {
          "conversation": "talk.kessel.kessel"
        }
      ]
    },
    {
      "id": "cook",
      "name": "COOK",
      "label": "[E] TALK",
      "conversationPresentation": "bubble",
      "routes": [
        {
          "conversation": "talk.kessel.cook"
        }
      ]
    }
  ],
  "readables": [
    {
      "id": "theatre",
      "name": "THE THEATRE",
      "pages": [
        "A cradle under a ring of lamps. Racks of something that breathes coolant. An empty robot frame on a stand.",
        "A strip of tape on the frame: FOR EMERGENCIES. In Kessel's handwriting: ONLY."
      ]
    }
  ],
  "manifest": {
    "version": 1,
    "width": 900,
    "spawn": "spawn",
    "uses": {
      "kessel": {
        "instance": "use-kessel",
        "responseH": 0,
        "responseAboveFloor": true,
        "promptH": 62,
        "promptAboveFloor": true
      },
      "cook": {
        "instance": "use-cook",
        "responseH": 0,
        "responseAboveFloor": true,
        "promptH": 62,
        "promptAboveFloor": true
      }
    },
    "readables": {
      "theatre": {
        "instance": "read-theatre",
        "responseH": 0,
        "responseAboveFloor": true
      }
    },
    "compile": {
      "groups": [
        "uses",
        "readables",
        "rests",
        "exits"
      ],
      "groundExits": false,
      "omitGroundRestHeight": true,
      "elevatedResponses": true
    }
  },
  "environment": {
    "outdoor": false,
    "ambient": {
      "sky": false,
      "weather": false
    }
  },
  "companion": {
    "mode": "off"
  },
  "stage": {
    "values": {
      "shutterRaised": {
        "if": {
          "state": "kessel.shutterOpen"
        },
        "then": 1,
        "else": 0
      }
    }
  },
  "phases": {
    "ch1-kessel": {
      "goal": "Kessel: down the hatch beside the stall, after dark (a stool at the stall to wait on)"
    },
    "ch1-shutter": {
      "goal": "open the shutter: H, then a verb",
      "ping": {
        "device": "shutter"
      }
    },
    "ch1-latch": {
      "goal": "home: the service latch, down Block 7's areaway"
    },
    "ch1-wait": {
      "goal": "noodles with Moth at ten (the stall)"
    },
    "ch1-street": {
      "goal": "the noodle stall: Moth said ten"
    },
    "ch1-registry": {
      "goal": "the Registry service point (open 08:00 to 18:00)"
    },
    "ch1-referral": {
      "goal": "back to the stall: tell the fixer"
    },
    "ch1-home": {
      "goal": "get some sleep"
    }
  }
}
