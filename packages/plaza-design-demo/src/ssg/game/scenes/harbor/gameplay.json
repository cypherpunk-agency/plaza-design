      "lifetime": "save",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 2
    },
    "harbor.bribe.asked": {
      "owner": "harbor.bribe",
      "lifetime": "save",
      "type": "boolean",
      "default": false
