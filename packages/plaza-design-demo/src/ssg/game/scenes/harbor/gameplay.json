      "goods": [
        {
          "item": "fish",
          "quantity": 1
        }
      ]
    },
    "harbor.tea": {
      "basePrice": 1,
      "goods": [
        {
          "item": "tea",
          "quantity": 1
        }
      ]
    },
    "harbor.bribe": {
      "service": true,
      "basePrice": 3,
      "modifiers": [
        {
          "id": "harbor.bribe.introduction-or-owned",
