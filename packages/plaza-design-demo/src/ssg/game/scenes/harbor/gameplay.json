    "harbor.cat.feed": {
      "sources": [
        "interaction"
      ],
      "when": {
        "item": "fish",
        "atLeast": 1
      },
      "actions": [
        {
          "item": "fish",
          "add": -1
        },
        {
          "flag": "harbor:cat",
          "value": true
        }
      ]
