        ]
      },
      "actions": [
        {
          "item": "tea",
          "add": -1
        },
        {
          "tokens": 1
        },
        {
          "flag": "harbor:crane",
          "value": true
        },
        {
          "state": "harbor.crane.first",
          "set": false
        },
        {
          "emit": "harbor.crane.tea"
        }
      ]
    },
    "harbor.crane.repeat": {
      "sources": [
        "interaction"
      ],
      "when": {
        "all": [
          {
            "item": "tea",
            "atLeast": 1
          },
          {
            "state": "harbor.crane.first",
            "is": false
          }
        ]
      },
      "actions": [
        {
          "item": "tea",
          "add": -1
        },
        {
          "emit": "harbor.crane.tea"
        }
      ]
    },
    "harbor.bribe.ask": {
      "sources": [
        "interaction"
      ],
      "when": {
        "all": [
          {
            "state": "harbor.bribe.asked",
            "is": false
          },
          {
            "not": {
              "flag": "harbor:bribed"
            }
          }
        ]
      },
      "actions": [
        {
          "state": "harbor.bribe.asked",
          "set": true
        }
      ]
    },
    "harbor.bribe.pay": {
      "sources": [
        "interaction"
      ],
      "when": {
        "all": [
          {
            "state": "harbor.bribe.asked",
            "is": true
          },
          {
            "not": {
              "flag": "harbor:bribed"
            }
          }
        ]
      },
      "actions": [
        {
          "purchase": "harbor.bribe"
        },
        {
          "flag": "harbor:bribed",
          "value": true
        }
      ]
    },
    "harbor.mark": {
      "sources": [
        "interaction"
      ],
      "when": {
        "flag": "harbor:bribed"
      },
      "actions": [
        {
          "flag": "harbor:ghostmark",
          "value": true
        }
      ]
