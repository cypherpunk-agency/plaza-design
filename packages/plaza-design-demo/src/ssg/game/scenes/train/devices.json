{
  "id": "train",
  "name": "Metro car",
  "tuning": {
    "dwellMs": 5500,
    "closeMs": 600,
    "openMs": 600,
    "runMs": 13000,
    "runLongMs": 20800,
    "brakeDecel": 115.2,
    "brakeWindow": 260,
    "resumeSpeed": 280,
    "haltTrackMs": 4000,
    "haltSidingMs": 7000,
    "haltOpenMs": 40000,
    "homeRunMs": 30000,
    "homeAheadMs": 4000
  },
  "devices": [
    {
      "id": "train",
      "name": "TRAIN-0",
      "look": "LINE 0's train, from its emergency panel at the end of car 3: the brake, a plate, a slot for a pass. It goes round. It never says where.",
      "everyday": [
        {
          "noun": "brake",
          "verb": "pull",
          "label": "pull the brake"
        },
        {
          "noun": "emergency.reg",
          "verb": "read",
          "label": "read the register"
        },
        {
          "noun": "plate",
          "verb": "read",
          "label": "read the brake plate"
        }
      ],
      "items": [
        {
          "item": "maglev.pass",
          "noun": "brake",
          "label": "show the maglev pass",
          "on": {
            "say": "brake.pass"
          }
        }
      ],
      "status": [
        "LINE 0 · {where}"
      ],
      "layout": {
        "spot": {
          "x": 1140,
          "y": 22,
          "w": 26,
          "h": 40
        },
        "board": {
          "x": 0.5,
          "y": 0.5
        },
        "dir": {
          "position": "up",
          "emergency.reg": "left",
          "plate": "left",
          "brake": "right",
          "doors": "down",
          "car": "down",
          "tunnel": "up",
          "approach": "up"
        },
        "row": [
          "position",
          "emergency.reg",
          "plate",
          "brake",
          "doors",
          "car",
          "tunnel",
          "approach"
        ]
      },
      "nouns": [
        {
          "id": "position",
          "layer": "hardware",
          "function": "sense",
          "verbs": [
            "read"
          ],
          "events": [
            "tunnel",
            "harbor siding"
          ],
          "on": {
            "read": [
              {
                "if": "train.positionStation",
                "say": "pos.station"
              },
              {
                "if": "train.positionHalted",
                "say": "pos.halted"
              },
              {
                "if": "train.positionBetween",
                "say": "pos.between"
              },
              {
                "say": [
                  "cat position",
                  "POSITION: physical observation unavailable.",
                  "err"
                ]
              }
            ]
          }
        },
        {
          "id": "emergency.reg",
          "layer": "data",
          "function": "hold",
          "verbs": [
            "read"
          ],
          "on": {
            "read": {
              "say": [
                "cat emergency.reg",
                "#0451 · registered by MOTH · 2 days ago · reason: a friend needs to get off at the harbor. they'll know when."
              ]
            }
          }
        },
        {
          "id": "plate",
          "layer": "data",
          "function": "hold",
          "verbs": [
            "read"
          ],
          "on": {
            "read": {
              "say": [
                "cat plate",
                "EMERGENCY BRAKE. PULL ONLY IN AN EMERGENCY. EMERGENCIES MUST BE REGISTERED AT LEAST 48 HOURS IN ADVANCE. MISUSE IS RECORDED AGAINST YOUR REGISTRY ID."
              ]
            }
          }
        },
        {
          "id": "brake",
          "layer": "hardware",
          "function": "act",
          "verbs": [
            "pull"
          ],
          "events": [
            "stopped"
          ],
          "on": {
            "pull": [
              {
                "if": "train.unpaidEven",
                "do": [
                  {
                    "command": "train.unpaid.even"
                  }
                ],
                "say": "brake.notyours"
              },
              {
                "if": "train.unpaidOther",
                "do": [
                  {
                    "command": "train.unpaid.other"
                  }
                ],
                "say": "brake.queued"
              },
              {
                "if": "train.paidStanding",
                "do": [
                  {
                    "effect": "train.brake"
                  }
                ],
                "say": "brake.standing"
              },
              {
                "if": "train.paidAlready",
                "do": [
                  {
                    "effect": "train.brake"
                  }
                ],
                "say": "brake.already"
              },
              {
                "if": "train.paidReady",
                "do": [
                  {
                    "effect": "train.brake"
                  }
                ],
                "say": "brake.pulled"
              },
              {
                "say": [
                  "{via}use brake --pull",
                  "BRAKE: passenger verification unavailable. pull not accepted.",
                  "err"
                ]
              }
            ]
          }
        },
        {
          "id": "doors",
          "layer": "hardware",
          "function": "act",
          "verbs": [
            "open",
            "lock"
          ],
          "mover": {
            "wired": false,
            "ease": "linear",
            "start": "open",
            "stops": {
              "shut": 0,
              "open": 1
            },
            "paths": {
              "open": [
                {
                  "to": "open",
                  "ms": "openMs"
                }
              ],
              "shut": [
                {
                  "to": "shut",
                  "ms": "closeMs"
                }
              ],
              "set.open": [
                {
                  "to": "open",
                  "ms": 0
                }
              ],
              "set.shut": [
                {
                  "to": "shut",
                  "ms": 0
                }
              ]
            }
          },
          "on": {
            "open": [
              {
                "if": "!trainBetween",
                "say": "doors.station"
              },
              {
                "if": "!signal",
                "say": "doors.hand"
              },
              {
                "if": "!trainHalted",
                "say": "doors.moving"
              },
              {
                "if": "!trainAtSiding",
                "say": "doors.wall"
              },
              {
                "do": [
                  {
                    "effect": "train.doors"
                  },
                  {
                    "goal": "siding"
                  }
                ],
                "say": "doors.siding"
              }
            ],
            "lock": [
              {
                "if": "!trainBetween",
                "say": "doors.station"
              },
              {
                "do": [
                  {
                    "effect": "train.lock"
                  }
                ],
                "say": "doors.locked"
              }
            ]
          }
        },
        {
          "id": "car",
          "layer": "hardware",
          "function": "act",
          "events": [
            "started",
            "arrived",
            "depart",
            "arrive",
            "stopped",
            "resumed"
          ],
          "milestone": {
            "stopped": "train.halted",
            "resumed": "train.resumed"
          },
          "relay": {
            "stopped": "brake:stopped"
          },
          "mover": {
            "wired": false,
            "axis": "x",
            "ring": 9000,
            "start": "downtown",
            "auto": "board",
            "stops": {
              "downtown": {
                "place": "downtown"
              },
              "galleria": {
                "place": "galleria"
              },
              "harbor": {
                "place": "harbor"
              },
              "siding": {
                "place": "siding"
              }
            },
            "brake": {
              "decel": "brakeDecel",
              "snap": [
                {
                  "stop": "siding",
                  "window": "brakeWindow"
                }
              ],
              "then": {
                "track": "halt",
                "siding": "halt.siding"
              },
              "load": "braking",
              "event": "stopped"
            },
            "paths": {
              "board": [
                {
                  "ms": "dwellMs",
                  "load": "dwell",
                  "drives": "doors:set.open"
                },
                {
                  "ms": "closeMs",
                  "ease": "linear",
                  "load": "closing",
                  "drives": "doors:shut",
                  "event": "depart",
                  "cue": "close"
                },
                {
                  "run": "go"
                }
              ],
              "stand": [
                {
                  "ms": "openMs",
                  "ease": "linear",
                  "load": "opening",
                  "drives": "doors:open"
                },
                {
                  "ms": "dwellMs",
                  "load": "dwell"
                },
                {
                  "ms": "closeMs",
                  "ease": "linear",
                  "load": "closing",
                  "drives": "doors:shut",
                  "event": "depart",
                  "cue": "close"
                },
                {
                  "run": "go"
                }
              ],
              "go": [
                {
                  "if": "trainPass",
                  "then": [
                    {
                      "to": "@trainNext",
                      "ms": "runLongMs",
                      "ease": "sine",
                      "load": "running",
                      "event": "arrive",
                      "cue": "open"
                    }
                  ],
                  "else": [
                    {
                      "to": "@trainNext",
                      "ms": "runMs",
                      "ease": "sine",
                      "load": "running",
                      "event": "arrive",
                      "cue": "open"
                    }
                  ]
                },
                {
                  "run": "stand"
                }
              ],
              "halt": [
                {
                  "ms": "haltTrackMs",
                  "load": "halted",
                  "event": "resumed"
                },
                {
                  "to": "@trainHeading",
                  "speed": "resumeSpeed",
                  "ease": "smooth",
                  "load": "resuming",
                  "event": "arrive",
                  "cue": "open"
                },
                {
                  "run": "stand"
                }
              ],
              "halt.siding": [
                {
                  "ms": "haltSidingMs",
                  "load": "halted",
                  "event": "resumed"
                },
                {
                  "to": "@trainHeading",
                  "speed": "resumeSpeed",
                  "ease": "smooth",
                  "load": "resuming",
                  "event": "arrive",
                  "cue": "open"
                },
                {
                  "run": "stand"
                }
              ],
              "halt.siding.open": [
                {
                  "ms": "haltOpenMs",
                  "load": "halted",
                  "drives": "doors:open"
                },
                {
                  "if": "trainDoorsAjar",
                  "then": [
                    {
                      "ms": "closeMs",
                      "ease": "linear",
                      "load": "halted",
                      "drives": "doors:shut"
                    }
                  ]
                },
                {
                  "ms": 0,
                  "load": "halted",
                  "event": "resumed"
                },
                {
                  "to": "@trainHeading",
                  "speed": "resumeSpeed",
                  "ease": "smooth",
                  "load": "resuming",
                  "event": "arrive",
                  "cue": "open"
                },
                {
                  "run": "stand"
                }
              ],
              "home": [
                {
                  "from": "harbor"
                },
                {
                  "to": "downtown",
                  "ms": "homeRunMs",
                  "ease": "sine",
                  "ahead": "homeAheadMs",
                  "load": "running",
                  "drives": "doors:set.shut",
                  "event": "arrive",
                  "cue": "open"
                },
                {
                  "ms": "openMs",
                  "ease": "linear",
                  "load": "opening",
                  "drives": "doors:open"
                }
              ]
            }
          }
        },
        {
          "id": "tunnel",
          "layer": "hardware",
          "function": "sense",
          "events": [
            "enters",
            "leaves"
          ],
          "relay": {
            "enters": "position:tunnel"
          },
          "zone": {
            "from": {
              "place": "tunnelIn"
            },
            "to": {
              "place": "tunnelOut"
            },
            "watch": "train.car"
          }
        },
        {
          "id": "approach",
          "layer": "hardware",
          "function": "sense",
          "events": [
            "enters",
            "leaves"
          ],
          "relay": {
            "enters": "position:harbor siding"
          },
          "zone": {
            "from": {
              "place": "siding",
              "plus": -110
            },
            "to": 8999,
            "watch": "train.car",
            "track": "stop"
          }
        }
      ]
    }
  ],
  "cables": [
    {
      "id": "safety",
      "from": "train.brake:stopped",
      "to": "train.doors",
      "verb": "lock"
    }
  ],
  "dialogue": {},
  "goals": [
    {
      "id": "siding",
      "text": "the train passes an old siding before the harbor, too fast to see. Stop there, and get the doors open"
    }
  ],
  "texts": {
    "goals.done": "the doors open on a platform that is on no map. a stair goes up. the harbor is open now.",
    "pos.station": [
      "cat position",
      "standing at {trainStopName}. doors {query:train.positionDoors}."
    ],
    "pos.between": [
      "cat position",
      "between {trainStopName} and {trainNextName}. track km {trainKilometres}."
    ],
    "pos.halted": [
      "cat position",
      "stopped between {trainStopName} and {trainNextName}. track km {trainKilometres}. not a station."
    ],
    "brake.notyours": [
      "{via}use brake --pull",
      "BRAKE: emergency #0451 is registered to another passenger. pull not accepted.",
      "err"
    ],
    "brake.queued": [
      "{via}use brake --pull",
      "BRAKE: a new emergency has been registered in your name. it will be ready in 48 hours.",
      "err"
    ],
    "brake.standing": [
      "{via}use brake --pull",
      "BRAKE: the train is standing. there is nothing to stop.",
      "dim"
    ],
    "brake.already": [
      "{via}use brake --pull",
      "BRAKE: already braking.",
      "dim"
    ],
    "brake.pass": [
      "show maglev.pass",
      "BRAKE: pass read · MOTH, second holder: you · emergency #0451 is registered to you. pull when ready.",
      "ok"
    ],
    "brake.pulled": [
      "{via}use brake --pull",
      "BRAKE: emergency #0451 · passenger verified (MAGLEV PASS) · braking.",
      "ok"
    ],
    "halt.track": [
      "train",
      "the train stops {haltWhere}. the lights flicker. nobody looks up.",
      "dim"
    ],
    "halt.siding": [
      "train",
      "the train stops beside an old platform with no name on it. a stair goes up into the dark. it smells of the sea.",
      "ok"
    ],
    "resume": [
      "train",
      "a voice apologises for the delay. the train restarts.",
      "dim"
    ],
    "doors.locked": [
      "{via}use doors --lock",
      "DOORS: locked. for your safety, doors stay shut between stations.",
      "dim"
    ],
    "doors.hand": [
      "use doors --{verb}",
      "DOORS: manual release disabled. doors open at stations.",
      "err"
    ],
    "doors.moving": [
      "{via}use doors --open",
      "DOORS: the train is moving. request refused.",
      "err"
    ],
    "doors.station": [
      "{via}use doors --{verb}",
      "DOORS: at a station the doors keep their own schedule.",
      "dim"
    ],
    "doors.wall": [
      "{via}use doors --open",
      "DOORS: open. outside, a wall, forty centimetres away. they close again.",
      "dim"
    ],
    "doors.siding": [
      "{via}use doors --open",
      "DOORS: open. an old platform, a service stair up. the emergency registration is closed: #0451 · resolved.",
      "ok"
    ],
    "halt.where.tunnel": "in the tunnel under the mall",
    "halt.where.bridge": "on the bridge, over black water",
    "halt.where.containers": "among the containers",
    "halt.where.towers": "between two towers",
    "halt.where.viaduct": "on the viaduct, over the roofs",
    "halt.where.mall": "by the mall's glass front",
    "halt.where.downtown": "over Downtown's streets",
    "status.siding": "STOPPED · NOT A STATION",
    "status.halted": "EMERGENCY STOP",
    "status.next": "NEXT: {stop}",
    "status.station": "AT {stop}",
    "position.doors.open": "open",
    "position.doors.shut": "shut"
  }
}
