          "onEnter": "talk.warehouse.mender.advance-1"
        },
        "visit-2": {
          "speaker": "TIDE HAND",
          "pages": [
            "I mend nets out here because they let me. Nobody seizes a net. Too many holes to file."
          ],
          "onEnter": "talk.warehouse.mender.advance-2"
        }
      }
    },
