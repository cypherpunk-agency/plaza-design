  "native": {
    "verbs": [
      {
        "device": "kiosk",
        "noun": "meter",
        "verb": "run",
        "cases": [
          {
            "command": "beach.meter.run",
            "say": [
              "{via}use meter --run",
              "METER: billing resumed. thank you for your patience.",
              "dim"
            ]
          }
        ]
      },
      {
        "device": "kiosk",
        "noun": "meter",
        "verb": "pause",
        "cases": [
          {
            "command": "beach.meter.pause",
            "say": [
              "{via}use meter --pause",
              "METER: billing paused. maintenance mode. the kiosk's screen keeps smiling.",
              "ok"
            ]
          }
        ]
      },
      {
        "device": "mixer",
        "noun": "pump",
        "verb": "pour",
        "cases": [
          {
            "when": {
              "state": "beach.freeDrink",
              "is": true
            },
            "command": "beach.pour.repeat",
            "say": [
              "signal → pump --pour",
              "the mixer pours another on the beat. LIME moves it out of your reach. \"one. the machine and I agreed on one.\"",
              "dim"
            ]
          },
          {
            "command": "beach.pour",
            "say": [
              "signal → pump --pour",
              "the mixer pours a SALT SPECIAL on the beat. nobody ordered it. LIME slides it over: \"the machine insists. who am I to argue with the machine.\"",
              "ok"
            ]
          }
        ],
        "denied": [
          "use pump --pour",
          "MIXER: manual pour disabled. pours on an order from the till.",
          "err"
        ]
      },
      {
        "device": "kiosk",
        "noun": "rent",
        "verb": "rent",
        "cases": [
          {
            "when": {
              "state": "beach.rented",
              "is": true
            },
            "command": "beach.noop",
            "say": [
              "use rent --rent",
              "KIOSK: you already rent sunbed 7. one sunbed per identity.",
              "dim"
            ]
          },
          {
            "when": {
              "tokensAtLeast": 1
            },
            "command": "beach.rent",
            "say": [
              "use rent --rent",
              "KIOSK: SUNBED 7 RENTED. 1 TOKEN DEBITED. BILLING CONTINUES PER MINUTE. ENJOY THE SUN.",
              "ok"
            ]
          },
          {
            "command": "beach.noop",
            "say": [
              "use rent --rent",
              "KIOSK: INSUFFICIENT BALANCE. SUNBEDS ARE 1 TOKEN PER MINUTE.",
              "err"
            ]
          }
        ]
      },
      {
        "device": "kiosk",
        "noun": "rent",
        "verb": "end",
        "cases": [
          {
            "when": {
              "state": "beach.rented",
              "is": true
            },
            "command": "beach.end",
            "template": true,
            "say": [
              "use rent --end",
              "KIOSK: RENTAL ENDED. TOTAL: {state:beach.billed} TOKENS. THANK YOU FOR RELAXING."
            ]
          },
          {
            "command": "beach.noop",
            "say": [
              "use rent --end",
              "KIOSK: no rental to end.",
              "dim"
            ]
          }
        ]
      }
    ],
    "events": {
      "beach.poured": "mixer.pump:poured"
    },
    "goals": {
      "beach.freeGranted": "free",
      "beach.rent.started": "sunbed"
    },
    "wires": [
      {
        "id": "party",
        "from": "jukebox.songs:played",
        "to": "mixer.lights",
        "verb": "flash"
      },
      {
        "id": "pier.on",
        "from": "pier.clock:on",
        "to": "pier.lamps",
        "verb": "on"
      },
      {
        "id": "pier.off",
        "from": "pier.clock:off",
        "to": "pier.lamps",
        "verb": "off"
      }
    ],
    "intervals": {
      "beach.billing": {
        "kind": "liveInterval",
        "elapsed": "minute",
        "duration": {
          "tuning": "minuteMs"
        },
        "active": {
          "all": [
            {
              "state": "beach.rented",
              "is": true
            },
            {
              "not": {
                "state": "beach.billing",
                "is": "pause"
              }
            }
          ]
        },
        "inactive": "hold",
        "resetOn": [
          "beach.rent.started"
        ],
        "due": [
          {
            "when": {
              "tokensAtLeast": 1
            },
            "command": "beach.bill"
          },
          {
            "command": "beach.exhaust"
          }
        ]
      },
      "beach.danger": {
        "kind": "liveInterval",
