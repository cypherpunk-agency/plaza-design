{
  "version": 1,
  "flags": [
    "beach:drink"
  ],
  "items": [],
  "events": [
    "beach.poured",
    "beach.freeGranted",
    "beach.gull.shooed",
    "beach.rent.started",
    "beach.minute.charged",
    "beach.rent.exhausted",
    "beach.drone.cleared"
  ],
  "commands": {
    "beach.meter.run": {
      "sources": [
        "interaction",
        "signal"
      ],
      "actions": [
        {
          "state": "beach.billing",
          "set": "run"
        }
      ]
    },
    "beach.meter.pause": {
      "sources": [
        "interaction",
        "signal"
      ],
      "actions": [
        {
          "state": "beach.billing",
          "set": "pause"
        }
      ]
    },
    "beach.pour": {
      "sources": [
        "signal"
      ],
      "actions": [
        {
          "state": "beach.freeDrink",
          "set": true
        },
        {
          "emit": "beach.poured"
        },
        {
          "emit": "beach.freeGranted"
        }
      ]
    },
    "beach.pour.repeat": {
      "sources": [
        "signal"
      ],
      "actions": [
        {
          "emit": "beach.poured"
        }
      ]
    },
    "beach.order": {
      "sources": [
        "interaction"
      ],
      "actions": [
        {
          "purchase": "beach.order"
        },
        {
          "flag": "beach:drink",
          "value": true
        }
      ]
    },
    "beach.gull.0": {
      "sources": [
        "interaction"
      ],
      "actions": [
        {
          "state": "beach.gull.cursor",
          "set": 1
        },
        {
          "emit": "beach.gull.shooed"
        }
      ]
    },
    "beach.gull.1": {
      "sources": [
        "interaction"
      ],
      "actions": [
        {
          "state": "beach.gull.cursor",
          "set": 0
        },
        {
          "emit": "beach.gull.shooed"
        }
      ]
    },
    "beach.crab.0": {
      "sources": [
        "interaction"
      ],
      "actions": [
        {
          "state": "beach.crab.cursor",
          "set": 1
        }
      ]
    },
    "beach.crab.1": {
      "sources": [
        "interaction"
      ],
      "actions": [
        {
          "state": "beach.crab.cursor",
          "set": 0
        }
      ]
    },
    "beach.noop": {
      "sources": [
        "interaction",
        "signal"
      ],
      "actions": []
    },
    "beach.rent": {
      "sources": [
        "interaction",
        "signal"
      ],
      "actions": [
        {
          "tokens": -1
        },
        {
          "state": "beach.rented",
          "set": true
        },
        {
          "state": "beach.billed",
          "set": 1
        },
        {
          "emit": "beach.rent.started"
        }
      ]
    },
    "beach.end": {
      "sources": [
        "interaction",
        "signal"
      ],
      "actions": [
        {
          "state": "beach.rented",
          "set": false
        }
      ]
    },
    "beach.bill": {
      "sources": [
        "system"
      ],
      "actions": [
        {
          "tokens": -1
        },
        {
          "state": "beach.billed",
          "add": 1
        },
        {
          "emit": "beach.minute.charged"
        }
      ]
    },
    "beach.exhaust": {
      "sources": [
        "system"
      ],
      "actions": [
        {
          "state": "beach.rented",
          "set": false
        },
        {
          "emit": "beach.rent.exhausted"
        }
      ]
    },
    "beach.calm": {
      "sources": [
        "system"
      ],
      "actions": [
        {
          "state": "beach.flag",
          "set": "clear"
        },
        {
          "emit": "beach.drone.cleared"
        }
      ]
    }
  },
  "reactions": [],
  "conversations": {},
  "state": {
    "beach.billing": {
      "owner": "beach",
      "lifetime": "save",
      "type": "enum",
      "default": "run",
      "options": [
        "run",
        "pause"
      ]
    },
    "beach.freeDrink": {
      "owner": "beach",
      "lifetime": "save",
      "type": "boolean",
      "default": false
    },
    "beach.gull.cursor": {
      "owner": "beach.gull",
      "lifetime": "save",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 1
    },
    "beach.crab.cursor": {
      "owner": "beach.crab",
      "lifetime": "save",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 1
    },
    "beach.rented": {
      "owner": "beach",
      "lifetime": "save",
      "type": "boolean",
      "default": false
    },
    "beach.billed": {
      "owner": "beach",
      "lifetime": "save",
      "type": "number",
      "default": 0,
      "min": -9007199254740991,
      "max": 9007199254740991
    },
    "beach.flag": {
      "owner": "beach",
      "lifetime": "save",
      "type": "string",
      "default": "clear"
    },
    "beach.song": {
      "owner": "beach",
      "lifetime": "save",
      "type": "number",
      "default": 0,
      "integer": false,
      "min": -9007199254740991,
      "max": 9007199254740991
    },
    "beach.lamps": {
      "owner": "beach",
      "lifetime": "save",
      "type": "string",
      "default": "on"
    },
    "beach.pierClock": {
      "owner": "beach",
      "lifetime": "save",
      "type": "string",
      "default": "on"
    }
  },
  "native": {
    "verbs": [
      {
        "device": "kiosk",
        "noun": "meter",
        "verb": "run",
        "cases": [
          {
            "command": "beach.meter.run",
            "say": [
              "{via}use meter --run",
              "METER: billing resumed. thank you for your patience.",
              "dim"
            ]
          }
        ]
      },
      {
        "device": "kiosk",
        "noun": "meter",
        "verb": "pause",
        "cases": [
          {
            "command": "beach.meter.pause",
            "say": [
              "{via}use meter --pause",
              "METER: billing paused. maintenance mode. the kiosk's screen keeps smiling.",
              "ok"
            ]
          }
        ]
      },
      {
        "device": "mixer",
        "noun": "pump",
        "verb": "pour",
        "cases": [
          {
            "when": {
              "state": "beach.freeDrink",
              "is": true
            },
            "command": "beach.pour.repeat",
            "say": [
              "signal → pump --pour",
              "the mixer pours another on the beat. LIME moves it out of your reach. \"one. the machine and I agreed on one.\"",
              "dim"
            ]
          },
          {
            "command": "beach.pour",
            "say": [
              "signal → pump --pour",
              "the mixer pours a SALT SPECIAL on the beat. nobody ordered it. LIME slides it over: \"the machine insists. who am I to argue with the machine.\"",
              "ok"
            ]
          }
        ],
        "denied": [
          "use pump --pour",
          "MIXER: manual pour disabled. pours on an order from the till.",
          "err"
        ]
      },
      {
        "device": "kiosk",
        "noun": "rent",
        "verb": "rent",
        "cases": [
          {
            "when": {
              "state": "beach.rented",
              "is": true
            },
            "command": "beach.noop",
            "say": [
              "use rent --rent",
              "KIOSK: you already rent sunbed 7. one sunbed per identity.",
              "dim"
            ]
          },
          {
            "when": {
              "tokensAtLeast": 1
            },
            "command": "beach.rent",
            "say": [
              "use rent --rent",
              "KIOSK: SUNBED 7 RENTED. 1 TOKEN DEBITED. BILLING CONTINUES PER MINUTE. ENJOY THE SUN.",
              "ok"
            ]
          },
          {
            "command": "beach.noop",
            "say": [
              "use rent --rent",
              "KIOSK: INSUFFICIENT BALANCE. SUNBEDS ARE 1 TOKEN PER MINUTE.",
              "err"
            ]
          }
        ]
      },
      {
        "device": "kiosk",
        "noun": "rent",
        "verb": "end",
        "cases": [
          {
            "when": {
              "state": "beach.rented",
              "is": true
            },
            "command": "beach.end",
            "template": true,
            "say": [
              "use rent --end",
              "KIOSK: RENTAL ENDED. TOTAL: {state:beach.billed} TOKENS. THANK YOU FOR RELAXING."
            ]
          },
          {
            "command": "beach.noop",
            "say": [
              "use rent --end",
              "KIOSK: no rental to end.",
              "dim"
            ]
          }
        ]
      }
    ],
    "events": {
      "beach.poured": "mixer.pump:poured"
    },
    "goals": {
      "beach.freeGranted": "free",
      "beach.rent.started": "sunbed"
    },
    "wires": [
      {
        "id": "party",
        "from": "jukebox.songs:played",
        "to": "mixer.lights",
        "verb": "flash"
      },
      {
        "id": "pier.on",
        "from": "pier.clock:on",
        "to": "pier.lamps",
        "verb": "on"
      },
      {
        "id": "pier.off",
        "from": "pier.clock:off",
        "to": "pier.lamps",
        "verb": "off"
      }
    ],
    "intervals": {
      "beach.billing": {
        "kind": "liveInterval",
        "elapsed": "minute",
        "duration": {
          "tuning": "minuteMs"
        },
        "active": {
          "all": [
            {
              "state": "beach.rented",
              "is": true
            },
            {
              "not": {
                "state": "beach.billing",
                "is": "pause"
              }
            }
          ]
        },
        "inactive": "hold",
        "resetOn": [
          "beach.rent.started"
        ],
        "due": [
          {
            "when": {
              "tokensAtLeast": 1
            },
            "command": "beach.bill"
          },
          {
            "command": "beach.exhaust"
          }
        ]
      },
      "beach.danger": {
        "kind": "liveInterval",
        "elapsed": "danger",
        "duration": {
          "tuning": "dangerMs"
        },
        "active": {
          "state": "beach.flag",
          "is": "danger"
        },
        "inactive": "reset",
        "due": [
          {
            "command": "beach.calm"
          }
        ]
      }
    },
    "replies": {
      "beach.minute.charged": {
        "from": "kiosk",
        "say": [
          "meter",
          "KIOSK: 1 MINUTE. 1 TOKEN DEBITED. TOTAL: {state:beach.billed}.",
          "dim"
        ],
        "template": true
      },
      "beach.rent.exhausted": {
        "from": "kiosk",
        "say": [
          "meter",
          "KIOSK: BALANCE EXHAUSTED. RENTAL ENDED. PLEASE VACATE SUNBED 7.",
          "err"
        ]
      },
      "beach.drone.cleared": {
        "from": "drone",
        "say": [
          "drone",
          "DRONE: no threat confirmed. FLAG: GREEN. swimming resumes.",
          "dim"
        ]
      }
    }
  },
  "purchases": {
    "beach.order": {
      "service": true,
      "basePrice": 2
    }
  }
}
