          "id": "lock",
          "layer": "hardware",
          "function": "act",
          "verbs": [
            "open",
            "shut"
          ],
          "current": "lock",
          "on": {
            "open": [
              {
                "if": "end",
                "say": [
                  "{via}use lock --open",
                  "already open. held open: market hours.",
                  "dim"
                ]
              },
              {
                "if": "!signal",
                "say": [
                  "use lock --open",
                  "ACCESS DENIED. Scanner signature required. Password entry not supported.",
                  "err"
                ]
              },
              {
                "if": "!scanned",
                "say": [
                  "signal \u2192 lock --open",
                  "the lock wants the scanner's word. that signal is not the scanner.",
                  "err"
                ]
              },
              {
                "do": [
                  {
                    "set": "lock",
                    "to": "open"
                  }
                ],
                "say": [
                  "signal \u2192 lock --open",
                  "signature matched. the shutter rolls up.",
                  "ok"
