      ],
      "nodes": {
        "visit-0": {
          "speaker": "VALET",
          "pages": [
            "I hold the umbrella. He holds the opinions."
          ],
          "onEnter": "talk.bot-voices.robot.valet.advance-0"
        },
        "visit-1": {
          "speaker": "VALET",
          "pages": [
            "Bags carried this year: four thousand. Thank-yous: none. Both figures are logged."
          ],
          "onEnter": "talk.bot-voices.robot.valet.advance-1"
        },
        "visit-2": {
          "speaker": "VALET",
          "pages": [
            "Do not address the client. The client bills by the minute."
          ],
          "onEnter": "talk.bot-voices.robot.valet.advance-2"
        }
      }
    },
