        },
        {
          "node": "visit-2"
        }
      ],
      "nodes": {
        "visit-0": {
          "speaker": "COURIER UNIT",
          "pages": [
            "Parcel for someone. Not you. I checked your face against the label."
          ],
          "onEnter": "talk.bot-voices.robot.android.advance-0"
        },
        "visit-1": {
          "speaker": "COURIER UNIT",
          "pages": [
            "I walk. The van was worth more sold than charged."
          ],
          "onEnter": "talk.bot-voices.robot.android.advance-1"
        },
        "visit-2": {
          "speaker": "COURIER UNIT",
          "pages": [
            "Signature required. Not yours. Please step out of my route."
          ],
          "onEnter": "talk.bot-voices.robot.android.advance-2"
        }
      }
    },
    "talk.bot-voices.robot.valet": {
