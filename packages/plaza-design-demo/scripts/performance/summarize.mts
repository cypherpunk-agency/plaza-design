import fs from 'node:fs';import path from 'node:path';
import {validateReport} from './validate-report';
import {workloads,repetitions} from './workloads';
const dir=path.resolve(process.argv[2]??'');if(!process.argv[2])throw new Error('Usage: tsx scripts/performance/summarize.mts <recording directory>');
const manifest=JSON.parse(fs.readFileSync(path.join(dir,'manifest.json'),'utf8'));
const reports=fs.readdirSync(dir).filter(f=>/^[a-z-]+-[1-3]\.json$/.test(f)&&!f.startsWith('smoke-')).map(file=>{const r=JSON.parse(fs.readFileSync(path.join(dir,file),'utf8'));return{file,report:r,quality:validateReport(r,manifest.source)};});
const median=(a:number[])=>[...a].sort((a,b)=>a-b)[Math.floor(a.length/2)];
const rows=workloads.map(w=>{const runs=reports.filter(r=>r.quality.workload===w.id),valid=runs.filter(r=>r.quality.status==='BASELINE');const spans=Array.from(new Set(valid.flatMap(r=>Object.keys(r.report.summary))));return{id:w.id,lane:w.lane,status:valid.length===repetitions?'MEASURED':'INCOMPLETE',runs:runs.map(r=>({file:r.file,quality:r.quality,durationMs:r.report.durationMs,samples:r.report.samples.length,summary:r.report.summary,calibration:r.report.environment.calibration})),variability:Object.fromEntries(spans.map(span=>{const values=valid.map(r=>r.report.summary[span]).filter(Boolean);return[span,{runs:values.length,medianRunP50:median(values.map(v=>v.p50)),medianRunP95:median(values.map(v=>v.p95)),p95Min:Math.min(...values.map(v=>v.p95)),p95Max:Math.max(...values.map(v=>v.p95)),sampleCounts:values.map(v=>v.count)}];}))};});
// Rank exclusive CPU durations; RAF gaps and timer lateness are waiting, not CPU contributors.
const exclusive=new Map<string,number[]>();
for(const {report,quality}of reports){if(quality.status!=='BASELINE')continue;const children=new Map<number,number>();for(const s of report.samples)if(s.parent>=0&&!['raf.gap','timer.lateness'].includes(s.span))children.set(s.parent,(children.get(s.parent)??0)+s.duration);const sums=new Map<string,number>();for(const s of report.samples){if(['raf.gap','timer.lateness','play.start','play.stop'].includes(s.span))continue;const key=s.span+(s.owner?'@'+s.owner:'');sums.set(key,(sums.get(key)??0)+Math.max(0,s.duration-(children.get(s.id)??0)));}for(const[key,total]of sums){const values=exclusive.get(key)??[];values.push(total/report.durationMs*1000);exclusive.set(key,values);}}
const contributors=[...exclusive].map(([span,values])=>({span,medianCpuMsPerRecordedSecond:median(values),runCount:values.length})).sort((a,b)=>b.medianCpuMsPerRecordedSecond-a.medianCpuMsPerRecordedSecond).slice(0,3);
const output={status:rows.every(r=>r.status==='MEASURED')?'MEASURED':'INCOMPLETE',source:manifest.source,harness:manifest.harness,rows,topThreeExclusiveCpuContributors:contributors,optimization:'No optimization retained by this report. Compare interleaved paired runs against variability/overhead before keeping a candidate.',limitations:['Native CPU submission only; RAF gaps are not presented FPS. play.start/play.stop are elapsed lifecycle latencies including asynchronous waits, excluded from CPU contributor rankings.','Fresh opaque frames and this browser scheduler may have irregular cadence; inspect raw gaps, sample counts and visibility.','P99 is unstable at short sample counts; repeats remain separate.','No CPU/GPU model, refresh-rate, thermal or mobile claim.','Exclusive CPU attribution uses direct recorded parent relationships; uninstrumented browser work is not included.']};
fs.writeFileSync(path.join(dir,'summary.json'),JSON.stringify(output,null,2)+'\n');console.log(JSON.stringify({status:output.status,source:output.source,rows:rows.map(r=>({id:r.id,status:r.status,runs:r.runs.length})),contributors},null,2));
