import fs from 'node:fs';import path from 'node:path';import {createHash} from 'node:crypto';import {execFileSync} from 'node:child_process';import {build} from 'esbuild';
import {demoStyles} from '../../src/ssg/render';
import {gameSourceIdentity} from '../scene-system/source-identity.mts';
import {workloads,repetitions,capacity,viewport} from './workloads';
import {playStartupBootstrap} from '../scene-system/build-play-runtime.mts';
const game=path.resolve('src/ssg/game'),output=path.resolve('../../.performance/native-workloads'),source=gameSourceIdentity(game);fs.mkdirSync(output,{recursive:true});
// PERF_PROFILE=1: readable function names for a CDP CPU profile (whitespace/syntax still minified); not a timing acquisition.
const profile=process.env.PERF_PROFILE==='1';
const result=await build({entryPoints:{frame:'scripts/performance/frame.ts',runner:'scripts/performance/runner.ts'},outdir:output,bundle:true,format:'iife',platform:'browser',target:'es2022',minifyWhitespace:true,minifySyntax:true,minifyIdentifiers:!profile,keepNames:profile,legalComments:'none',metafile:true});
if(Object.keys(result.metafile!.inputs).some(p=>p.replaceAll('\\','/').includes('/authoring/server/')))throw new Error('Source service reached performance build');
const hash=createHash('sha256');for(const name of fs.readdirSync('scripts/performance').sort())if(/\.(ts|mts)$/.test(name)){hash.update(name);hash.update(fs.readFileSync('scripts/performance/'+name));}
const manifest={version:1,source,harness:'sha256:'+hash.digest('hex'),revision:execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim(),mode:profile?'esbuild profile build (identifiers kept) native Game':'esbuild minified production-style native Game',viewport,repetitions,capacity,workloads};
fs.writeFileSync(path.join(output,'manifest.json'),JSON.stringify(manifest,null,2)+'\n');
const core=await build({entryPoints:[path.resolve('../plaza-design-core/plaza.css')],bundle:true,write:false,loader:{'.woff2':'dataurl'},logLevel:'warning'});
let css=core.outputFiles[0].text.replace(/@font-face\s*\{[^}]*\}/g,'')+'\n'+demoStyles;
for(const weight of [400,500,600,700]){const bytes=fs.readFileSync('dist-homepage/fonts/ibm-plex-mono-latin-'+weight+'-normal.woff2');css+='\n@font-face{font-family:"IBM Plex Mono";font-weight:'+weight+';font-style:normal;src:url(data:font/woff2;base64,'+bytes.toString('base64')+')}';}
// Same trusted pre-CSS observer as native editor Play; only the message channel differs.
const bootstrap=playStartupBootstrap.replaceAll("channel:'editor-play'","channel:'performance-workloads'"),bootstrapHash=createHash('sha256').update(bootstrap,'utf8').digest('base64');
const meta=`<meta charset="utf-8"><meta name="game-source" content="${source}"><meta name="viewport" content="width=device-width,initial-scale=1">`;
fs.writeFileSync(path.join(output,'frame.html'),`<!doctype html><html class="game-mode"><head>${meta}<meta http-equiv="Content-Security-Policy" content="default-src 'none';script-src 'self' 'sha256-${bootstrapHash}';style-src 'unsafe-inline';font-src data:;img-src data:"><script>${bootstrap}</script><style>${css}\nhtml,body{margin:0;width:100%;height:100%;background:#000}.demo-window{position:relative!important;inset:auto!important;width:100%!important;height:100%!important;max-width:none!important;max-height:none!important;border:0!important;border-radius:0!important}#input-host{position:absolute;bottom:0}</style></head><body><section class="demo-window"><header hidden></header><footer hidden></footer><div id="input-host"></div></section><script id="editor-play-runtime" src="frame.js"></script></body></html>`);
fs.writeFileSync(path.join(output,'index.html'),`<!doctype html><html><head>${meta}<meta http-equiv="Content-Security-Policy" content="default-src 'none';script-src 'self';style-src 'unsafe-inline';frame-src 'self';connect-src 'self'"><style>body{margin:16px;background:#15191e;color:#e5e9ef;font:14px system-ui}button{padding:8px;margin-right:10px}iframe{display:block}#results{max-height:160px;overflow:auto}#status{font-weight:bold}</style></head><body><h1>Native performance workloads · local only</h1><p>960 × 540 CSS game viewport; native DPR and quality. Fresh private realms. Keep this tab visible. CPU submission is not presented FPS. Smoke recordings are never baselines.</p><label>Workload <select id="workload" aria-label="Workload"></select></label> <label>Repeat <select id="repeat" aria-label="Repeat"><option>1</option><option>2</option><option>3</option></select></label><button id="selected">Run selected repeat</button><button id="smoke">Validate fixtures</button><button id="run">Run all six · three repeats</button><p id="status" role="status">Ready · ${source}</p><ol id="results"></ol><details><summary>Frame startup observations</summary><pre id="startup"></pre></details><div id="stage"></div><script src="runner.js"></script></body></html>`);
console.log(JSON.stringify({output,...manifest},null,2));
