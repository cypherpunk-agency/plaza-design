import assert from 'node:assert/strict';
import {SCENES} from '../../src/ssg/game/scenes';
import {SceneModel} from '../../src/ssg/game/engine/model';
import {GameplaySession} from '../../src/ssg/game/engine/gameplay/session';
import {attachNativeGameplay} from '../../src/ssg/game/engine/gameplay/native-bindings';
import {mergeValues,resolveValues} from '../../src/ssg/game/engine/gameplay/state';
import {sceneStateView} from '../../src/ssg/game/engine/gameplay/scene-state';
import {compileGameWorld} from '../../src/ssg/game/world/compiled-world';
import {placeFrom,placementCoordinates} from '../../src/ssg/game/world/zone-graph';
import {levelVehicleFrames} from '../../src/ssg/game/engine/level-vehicles';
import {vehicleDoors} from '../../src/ssg/game/world/vehicles';
const scene=SCENES['harbor-station'],definition=scene.gameplay!;
let state:any={flags:{'prologue:started':true},items:{},tokens:0,values:{}};mergeValues(state.values,resolveValues(definition,state));
const model=new SceneModel({say(){},open(){},changed(){}},scene.data!,undefined,undefined,undefined,undefined,sceneStateView(state.values,scene.id,definition),definition);
model.peopleLevel={...scene.level!,vehicleZones:placementCoordinates(placeFrom(compileGameWorld(SCENES),scene.id,Infinity))};
const session=new GameplaySession(definition,{read:()=>state,write:next=>{mergeValues(state.values,next.values??{});state={...next,values:state.values};}});attachNativeGameplay(model,session);
const frame=()=>levelVehicleFrames(model.peopleLevel!,model).find(f=>f.vehicle.id==='service')!;
assert(session.eligibility('intro.hold','system').ok);assert.equal(model.movers.position('service.frame'),0,'eligibility is pure');
assert(session.dispatch('intro.hold','system').ok);assert.equal(model.movers.position('service.frame'),6520);assert.equal(vehicleDoors(frame().vehicle,model),0);
model.tick(10000,true);assert.equal(model.movers.position('service.frame'),6520,'the live mover holds, not a painted substitute');
model.locks.set('service',model.wall()+1000);assert.equal(session.dispatch('intro.arrive','system').ok,false,'system direction retains native lock checks');assert.equal(model.movers.position('service.frame'),6520);model.locks.delete('service');
assert(session.dispatch('intro.arrive','system').ok);model.tick(10500,true);const middle=model.movers.position('service.frame')!;assert(middle>3000&&middle<3500,'the ordinary mover interpolates the arrival');
model.tick(10500,true);assert.equal(model.movers.position('service.frame'),0);assert.equal(frame().pose.zone,'harbor-station');assert.equal(frame().pose.x,20);assert.equal(vehicleDoors(frame().vehicle,model),1,'physical and visible doors open together');
const time=model.now();assert(session.dispatch('intro.release','system').ok);model.tick(16,true);assert.equal(model.now(),time+16,'release never resets the model clock');assert.equal(model.movers.lastRun('service.frame'),'service');assert.equal(frame().pose.x,20);
session.dispose();model.dispose();console.log('Directed mover: pure eligibility, real path/route pose, native guards, shared doors and uninterrupted model release PASS');
