import {SceneModel} from '../../src/ssg/game/engine/model';import {GameplaySession} from '../../src/ssg/game/engine/gameplay/session';import {attachNativeGameplay} from '../../src/ssg/game/engine/gameplay/native-bindings';import {fixtureGameplayPort} from './model-gameplay-fixture.mts';
import assert from 'node:assert/strict';
import * as current from '../../src/ssg/game/world/transport/line';import {createCityModel} from '../../src/ssg/game/world/city';import source from '../../src/ssg/game/world/city.json';import {SCENES} from '../../src/ssg/game/scenes';import {frameView} from '../../src/ssg/game/art/core/view';import {startLevel} from '../../src/ssg/game/ui/sudo';import {boardRide} from '../../src/ssg/game/engine/gameplay/mechanisms/line-ride';
import {advance,tickUntil} from './train-ride.mts';
const model=createCityModel(source);
// Two sessions: the closed stop and the platform clocks of one never reach the other. The platform timetable is a pure function of the timeline it is given.
const a=current.createLineSystem(),b=current.createLineSystem(),tl={t:300,shift:0};const untouched=b.platformTrainVisual('downtown',tl,150);a.lineOpen.harbor=false;assert.deepEqual(b.platformTrainVisual('downtown',tl,150),untouched);assert.equal(b.lineOpen.harbor,true);
const shifted=a.platformShiftFor('downtown',300,100);assert.deepEqual(a.platformTrainVisual('downtown',{t:300,shift:shifted},150)!.open>0,true);assert(a.platformOpen('downtown',{t:300,shift:shifted}),'the shift puts the train you stepped off at the platform');assert(Math.abs(a.platformLeft('downtown',{t:300,shift:shifted})-100)<1e-6,'with its doors open for the time left');
// the same time with and without a scene: a picture painted without a scene model follows view.t, with one its timeline
assert.deepEqual(current.viewTimeline({t:7}),{t:7,shift:0});assert.deepEqual(current.viewTimeline({t:7,timetable:{t:9,shift:3}}),{t:9,shift:3});
// the pending route order and names reach the platform pictures and the actual TRAIN rules; two train models do not share a ride
const edit=structuredClone(source);edit.LINE=['downtown','harbor','galleria'];edit.STATIONS.harbor.name='PENDING HARBOR';edit.STATIONS.downtown.name='PENDING DOWNTOWN';const city=createCityModel(edit),metro=current.createLineSystem(city);assert.equal(metro.nextStation('downtown'),'harbor');assert.equal(b.nextStation('downtown'),'galleria');
const world={city,metro},trainScene=SCENES.train.bindWorld!(world);
const build=(scene:any)=>new SceneModel({say(){},changed(){},open(){}},scene.data!,scene.rules as any);
const m=build(trainScene);m.setPaused(true);assert.equal(metro.rideView(m.movers).say,'PENDING DOWNTOWN');
boardRide(m,'downtown',120);advance(m,1);assert.equal(metro.rideStop(m.movers),'downtown');tickUntil(m,()=>metro.ridePhase(m.movers)==='running');assert.equal(metro.rideView(m.movers).say,'NEXT: PENDING HARBOR');assert.equal(metro.rideNext(m.movers),'harbor');
const other=build(SCENES.train.bindWorld!({city:model,metro:b}));other.setPaused(true);assert.equal(b.rideStop(other.movers),'downtown');assert.equal(b.ridePhase(other.movers),'dwell','another game\'s train stands where it started');
for(const id of ['metro','galleriaStation','harborStation','train'] as const){const scene=SCENES[id].bindWorld!(world);assert.notEqual(scene,SCENES[id]);const view={...frameView(640),t:300,cam:0,viewW:640,viewH:360,gy:280,sx:(x:number)=>x,y:(h:number)=>280-h,flags:{'harbor:open':true}};
 if(id==='train'){let state:any={flags:{},items:{},tokens:0};const lines:any[]=[],tm=new SceneModel({say:line=>lines.push(line),changed(){},open(){}},scene.data!,scene.rules as any);tm.setPaused(true);boardRide(tm,'downtown',120);tickUntil(tm,()=>metro.ridePhase(tm.movers)==='running');const engine={hover:null,m:tm} as any;scene.preparePresentation?.(view,engine);const env=scene.visualEnvironment!(view,engine);const session=new GameplaySession(scene.gameplay!,fixtureGameplayPort(scene.gameplay!,{read:()=>state,write:next=>{state=next;}},()=>tm));attachNativeGameplay(tm,session);try{assert.equal(tm.value('where'),'NEXT: PENDING HARBOR');const before=structuredClone(metro.rideView(tm.movers));tm.act('train','position','read');assert.equal(lines.length,1);assert(lines[0][1].includes('PENDING HARBOR'));assert.deepEqual(metro.rideView(tm.movers),before,'reading position never advances the ride');assert.deepEqual((env.bindings!['train.frame'] as any).visual.ride,metro.rideView(tm.movers));}finally{session.dispose();tm.reset();tm.setPaused(true);}}
 else{scene.preparePresentation?.(view, {hover:null} as any);const env=scene.visualEnvironment!(view,{hover:null} as any);if(id==='metro')assert.equal((env.bindings!['station.departure'] as any).destination,'PENDING HARBOR');}}
// P14's level boards the car at Galleria, by the car's own order
const levelModel=build(SCENES.train.bindWorld!({city:model,metro:b}));levelModel.setPaused(true);assert.equal(startLevel('p14',{board:(station,left)=>boardRide(levelModel,station,left)}),'train');assert.equal(b.rideStop(levelModel.movers),'galleria');assert.equal(b.rideLeft(levelModel.movers),240);
console.log('Metro sessions PASS: independent platform clocks and closed stops, the shift puts the train you stepped off at the platform, scene-time timeline over view.t, pending route/name in platform/train visuals and actual TRAIN rules, one ride per train model, P14 boarding.');
