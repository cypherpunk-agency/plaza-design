import assert from 'node:assert/strict';
import {SCENES} from '../../src/ssg/game/scenes';
import {openingDocuments} from '../../src/ssg/game/story/title/documents';
import {sequenceInspection} from '../../src/ssg/game/authoring/sequence-inspection';
import {worldSequenceSources} from '../../src/ssg/game/runtime/sequence-commands';
import {GameplaySession} from '../../src/ssg/game/engine/gameplay/session';
import {attachGameplayHandoffs} from '../../src/ssg/game/engine/gameplay/handoffs';
import {art} from '../../src/ssg/game/art';
import {sequenceWorldZones,sequenceWorldLayout} from '../../src/ssg/game/runtime/prepare-frame';
import {sequenceProgram} from '../../src/ssg/game/art/core/sequence';
import {lightAt} from '../../src/ssg/game/world/light';
const sequence=openingDocuments.timeline.sequences.find(s=>s.id==='glide')!;
const renamed=structuredClone(openingDocuments);renamed.composition.instances.find(n=>n.type==='sequence.world-control')!.id='direction';
for(const track of renamed.composition.sequence!.tracks)if('instance'in track.target&&track.target.instance==='sky')track.target.instance='direction';
renamed.timeline=sequenceProgram(renamed.compositions);
const layout=sequenceWorldLayout(renamed,'glide',68,{width:690,height:302,reduced:true,ambientTime:68,lighting:lightAt(1,1140,90,null)},1);
assert.equal(layout.minute,1140,'direction follows the registered settings instance, not a hard-coded sky ID');assert.equal(layout.fit,1);
const nodes=openingDocuments.composition.instances.find(n=>n.type==='sequence.world-control')!;
const inspection=sequenceInspection(SCENES,sequence,nodes.props!.zones as string[]);
const first=inspection.sample(0).model('harbor-station')!;
assert.equal(first.movers.position('service.frame'),6520);
assert.equal(inspection.sample(43.5).model('harbor-station'),first);
const mid=inspection.sample(54).model('harbor-station')!.movers.position('service.frame')!;
assert(mid>3000&&mid<3500);
assert.equal(inspection.sample(65).model('harbor-station')!.movers.position('service.frame'),0);
assert.equal(first.movers.position('service.doors'),1);
assert.throws(()=>inspection.sample(0),/backwards/);inspection.dispose();
const again=sequenceInspection(SCENES,sequence,nodes.props!.zones as string[]);
assert.equal(again.sample(0).model('harbor-station')!.movers.position('service.frame'),6520,'a backward reconstruction is deterministic');again.dispose();
const sources=worldSequenceSources(SCENES);assert.equal(sources['boundary-pan'].sequence.duration,8);
const west=SCENES['boundary-west'].artwork!,settings=art.properties('sequence.world-control',west.instances.find(n=>n.type==='sequence.world-control')!.props);
const alternate=sequenceInspection(SCENES,{...sources['boundary-pan'].sequence,commands:[{id:'switch',time:0,scene:'boundary-west',command:'mount-blue',skip:'run'}]},sequenceWorldZones(settings,SCENES));
const projected=alternate.sample(1),scope=sequenceWorldZones(settings,SCENES,projected.compositions);
assert(scope.includes('boundary-door-blue'));assert(!scope.includes('boundary-door'));assert(projected.model('boundary-door-blue'));
assert.equal(projected.flags['demo:boundary-blue'],true,'mount and scalar changes use one isolated command transaction');alternate.dispose();
let state:any={flags:{},items:{},tokens:0,values:{}},requested='';
const session=new GameplaySession(SCENES['boundary-west'].gameplay!,{read:()=>state,write:s=>{state=s;}});
attachGameplayHandoffs(session,{schedule(){throw Error('No timer required');},cutscene:id=>{requested=id;}});
assert(session.dispatch('request-view','interaction').ok);assert.equal(requested,'boundary-pan');
assert.equal(state.flags['demo:boundary-pan'],undefined,'requesting direction does not execute completion');
session.dispose();console.log('Sequence inspection: shipping commands/movers, deterministic isolated samples, and source-discovered event handoff PASS');
