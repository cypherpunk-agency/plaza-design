export class DialogueElement{children:DialogueElement[]=[];attributes:Record<string,string>={};value='';checked=false;disabled=false;hidden=false;listeners:Record<string,Function[]>={};private text='';get textContent(){return this.text;}set textContent(value:string){this.text=value;this.children=[];}onchange?:()=>void;onclick?:()=>void;append(...n:DialogueElement[]){this.children.push(...n);}appendChild(n:DialogueElement){this.append(n);return n;}replaceChildren(...n:DialogueElement[]){this.children=[...n];this.text='';}setAttribute(k:string,v:string){this.attributes[k]=v;}addEventListener(k:string,fn:Function){(this.listeners[k]??=[]).push(fn);}click(){this.onclick?.();for(const fn of this.listeners.click??[])fn({stopPropagation(){}});}remove(){}}
export const descendants=(e:DialogueElement):DialogueElement[]=>[e,...e.children.flatMap(descendants)];
