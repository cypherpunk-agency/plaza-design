import assert from 'node:assert/strict';
import {runtimeChunkStatuses,preparedChunkStatus} from '../../src/ssg/game/runtime/chunk-status';
import {createScenesState} from '../../src/ssg/game/runtime/state';
const scenes=createScenesState();scenes.here='boundary-west';
scenes.zoneTiers=new Map([['boundary-west','active'],['boundary-east','visible'],['capsule','near'],['downtown','unloaded'],['train','unloaded']]);
scenes.zoneReasons=new Map([['boundary-east','visible: camera intersects chunk'],['capsule','held: a panel is open'],['downtown','unloaded: past the eviction distance']]);
const host=(extra={})=>({overlayOpen:false,popupOpen:false,visionOn:false,acknowledgmentPending:false,...extra}) as any;
scenes.hosts.set('boundary-west',host());scenes.hosts.set('boundary-east',host());scenes.hosts.set('capsule',host({popupOpen:true}));
scenes.mobiles.set('train',{model:{} as any});
const entities=[{source:'train',vehicles:[{id:'train/car',zone:'boundary-east'}],people:[{key:'passenger#1',zone:'boundary-west'}]}];
const before=[scenes.hosts.size,scenes.mobiles.size,scenes.zoneTiers.size];
const rows=runtimeChunkStatuses(scenes,id=>id,entities),row=(id:string)=>rows.find(r=>r.id===id)!;
assert.deepEqual(row('boundary-west').statuses,['Player']);
assert.deepEqual(row('boundary-east').statuses,['Visible']);assert.equal(row('boundary-east').sceneryLoaded,true);
assert.deepEqual(row('capsule').statuses,['Nearby','Retained']);assert(row('capsule').reasons.includes('An interaction is open.'));
assert.deepEqual(row('downtown').statuses,['Unloaded']);assert.equal(row('downtown').modelLoaded,false);
assert.deepEqual(row('train').statuses,['Retained'],'retained mobile models are not labelled unloaded');assert.equal(row('train').sceneryLoaded,false);assert.equal(row('train').modelLoaded,true);
assert.equal(row('train').entities[0].zone,'boundary-east');assert.equal(row('train').entities[1].zone,'boundary-west');
assert.deepEqual([scenes.hosts.size,scenes.mobiles.size,scenes.zoneTiers.size],before,'inspection cannot load or evict anything');
row('train').entities[0].zone='capsule';assert.equal(entities[0].vehicles[0].zone,'boundary-east','inspection is detached');
const edit=preparedChunkStatus('boundary-west','West');assert.equal(edit.mode,'editing');assert.deepEqual(edit.statuses,['Prepared for editing']);assert(!edit.modelLoaded,'editing never claims gameplay model residency');
console.log('Chunk status: actual hosts, held interactions, unloaded scenery, retained mobile models, detached inspection and explicit editing context PASS');
