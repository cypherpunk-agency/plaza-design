const type='g7.temporary-signal';
art.register({type,version:1,label:'Temporary clip probe',category:'G7 fixture',fields:{},visualFields:{open:{kind:'boolean',label:'Open',default:false,animatable:true},intensity:{kind:'number',label:'Lamp intensity',default:1,min:0,max:1,animatable:true}},animationClips:{pulse:{duration:2,loop:true,sample:phase=>phase/2},steady:{duration:1,loop:true,sample:()=>1}},parts:['backdrop'],bounds:()=>({x:0,h:6,w:6,tall:6}),anchors:()=>({origin:{x:0,h:0,role:'origin'}}),draw(ctx,_view,_props,state){ctx.globalAlpha=Number(state.intensity);ctx.fillStyle=state.open?'#00ff00':'#ff0000';ctx.fillRect(0,-6,6,6);}});
const composition:Composition={version:1,scene:'g7-temporary',instances:[{id:'carrier',type:'furniture.stool',props:{seed:2},placement:{x:20,h:0},order:0,layer: 'backdrop'},{id:'lamp',type,props:{},placement:{x:3,h:2},attach:{instance:'carrier',anchor:'seat'},order:1,layer: 'backdrop'}]};
const timeline:TimelineDocument={version:1,sequences:['gate-arrival','gate-departure'].map((id,i)=>({id,duration:4,composition:'room',shots:[{id:'wide',from:0,to:2,camera:{x:0,h:0,zoom:1}},{id:'close',from:2,to:4,camera:{x:10,h:0,zoom:1.5}}],tracks:[{id:'move-carrier',target:{kind:'instance',instance:'carrier',property:'x'},keys:[{time:0,value:20},{time:4,value:100}],reduced:'freeze'},{id:'gate-state',target:{kind:'state',instance:'lamp',property:'open'},keys:[{time:0,value:false,ease:'hold'},{time:2,value:true}]},{id:'lamp-clip',target:{kind:'clip',instance:'lamp',property:'intensity'},keys:[{time:0,value:'pulse',ease:'hold'},{time:2,value:'steady'}],reduced:'normal'}],text:[{id:'caption',from:.5,to:3,text:i?'RETURN TO THE GATE':'FOLLOW THE LIGHT',x:40,h:-40}],fades:[{id:'exit',from:3,to:4,start:0,end:1,color:'#010203'}],beats:[{id:'close-shot',time:2}],handoff:{scene:'capsule',entrance:'door'}}))};
const destinations=Object.fromEntries(Object.entries(SCENES).map(([id,scene])=>[id,scene.exits.map(exit=>exit.id)]));
const sourceContext=createSequenceValidationContext(art,{room:composition},destinations),previewConfig=createSequencePreview(art),context={destinations,clips:previewConfig.clips,motionTracks:previewConfig.motionTracks};
assert.deepEqual(sourceContext.clips?.[type],['pulse','steady'],'Source validator discovers actual registry clips');assert.deepEqual(previewConfig.clips[type],sourceContext.clips?.[type],'Actual editor preview exposes the same catalog');validateTimeline(timeline,sourceContext);const invalid=structuredClone(timeline);invalid.sequences[0].tracks[2].keys[0].value='unregistered-clip';assert.throws(()=>validateTimeline(invalid,sourceContext),'Source validation rejects absent registry clip');
const initial:EditorDocument[]=[{id:'room',kind:'composition',revision:'temporary-room',value:composition},{id:'motion',kind:'timeline',revision:'temporary-motion',value:timeline}];
const editor=new ComposerModel(art,context);editor.load(initial);const exported=JSON.stringify(editor.list());const imported=new ComposerModel(art,context);imported.load(JSON.parse(exported));assert.deepEqual(imported.list(),editor.list());const restored=imported.get('motion').value as TimelineDocument,room=imported.get('room').value as Composition,sourceBefore=JSON.stringify(initial),ctx=imported.timelineContext();
function recorder(){const commands:unknown[][]=[];let gradient=0;const stack:Record<string,unknown>[]=[],values:Record<string,unknown>={globalAlpha:1,lineWidth:1,font:'',getTransform:()=>({a:1}),measureText:(text:string)=>({width:text.length*6})};const canvas=new Proxy(values,{get(t,k:string){if(k in t)return t[k];if(k==='save')return()=>{stack.push({...t});commands.push(['save']);};if(k==='restore')return()=>{const restored=stack.pop();if(!restored)throw new Error('Unbalanced Canvas.restore');Object.keys(t).forEach(key=>delete t[key]);Object.assign(t,restored);commands.push(['restore']);};if(k==='createLinearGradient'||k==='createRadialGradient')return(...args:unknown[])=>{const id=++gradient;commands.push([k,...args,id]);return{id,addColorStop:(...args:unknown[])=>commands.push(['stop',id,...args])};};return(...args:unknown[])=>commands.push([k,...args]);},set(t,k:string,value){t[k]=value;commands.push(['set',k,value]);return true;}})as unknown as CanvasRenderingContext2D;return{canvas,commands};}
let storageCalls=0;(globalThis as any).localStorage={getItem(){storageCalls++;throw new Error('No player-save access');},setItem(){storageCalls++;throw new Error('No player-save writes');}};(globalThis as any).document={documentElement:{classList:{remove(){}}}};
const native=createNativePreview({'g7-temporary':{validate:value=>art.validate(value),definition:(doc,state,options)=>({id:'g7-temporary',name:'G7 temporary composition',width:900,spawn:0,exits:[],drawBackdrop:(canvas,view)=>drawComposition(canvas,art,doc,{view,state,...options},'backdrop')}),environment:(_doc,view)=>({view,state:{},reduced:false})}});
function paint(id:string,time:number,reduced=false){const r=recorder(),frame=evaluateTimeline(restored,id,time,ctx,{reduced});native.render({width:640,height:360,getContext:()=>r.canvas}as unknown as HTMLCanvasElement,{composition:room,frame,time,reduced,overlays:false,environment:{}});return canonicalPaint(r.commands);}
for(const sequence of restored.sequences){const id=sequence.id;for(const reduced of[false,true]){const mid=paint(id,1,reduced),lamp=mid.find(p=>p[0]==='fillRect'&&(p.at(-1)as any).style==='#ff0000')!,look=lamp.at(-1)as any;assert.equal(look.alpha,.5,'Actual registered pulse clip is sampled during drawing');assert.equal(look.matrix[4],reduced?23:43,'Rendered attached lamp follows moving shared library stool');assert.equal(look.matrix[5],294,'Attached seat height is used by the rendered signal');assert.ok(mid.some(p=>p[0]==='fillText'&&p[1]===sequence.text[0].text));const close=paint(id,2.5,reduced),green=close.find(p=>p[0]==='fillRect'&&(p.at(-1)as any).style==='#00ff00')!.at(-1)as any;assert.equal(green.alpha,1,'Actual steady clip and held discrete state drive rendered output');assert.equal(green.matrix[4],reduced?20:95,'Second shot and attachment compose through native camera');const fade=paint(id,3.5,reduced).find(p=>p[0]==='fillRect'&&(p.at(-1)as any).style==='#010203')!.at(-1)as any;assert.equal(fade.alpha,.5,'Authored fade paints during temporary native scene playback');for(const t of[0,1,2.5,3.5,1,0,2.5])assert.deepEqual(paint(id,t,reduced),paint(id,t,reduced),'Absolute forward/backward scrub is deterministic');}
 for(const reduced of[false,true])for(const skip of[false,true]){const r=recorder(),scene:Cutscene={id,title:id,duration:sequence.duration,next:sequence.handoff!.scene,cards:[],ownsFade:true,render:(_canvas,view,time)=>{const frame=evaluateTimeline(restored,id,time,ctx,{reduced:view.reduced});native.render({width:view.viewW,height:view.viewH,getContext:()=>r.canvas}as unknown as HTMLCanvasElement,{composition:room,frame,time,reduced:view.reduced,overlays:false,lighting:view.lighting,environment:{}});}};const player=new CutscenePlay(scene,{reduced,touch:false}),arrivals:unknown[][]=[],game=Object.create(Game.prototype)as any;game.cut=player;game.cutThen=()=>game.handTo(sequence.handoff!.scene,sequence.handoff!.entrance);game.handTo=(...args:unknown[])=>arrivals.push(args);game.x=r.canvas;game.k=1;game.viewW=640;game.viewH=360;game.here='capsule';Object.defineProperty(game,'placeName',{value:'Test capsule'});game.syncHud=()=>{};game.canvas={setAttribute(){}};
  assert.equal(player.skip(),false,'Skip grace stays active');player.timeline.seek(4);game.stepCutscene(0);assert.equal(player.done,false);assert.equal(arrivals.length,0,'Scrub to end never commits handoff');player.timeline.seek(0);for(let i=0;i<60;i++)game.stepCutscene(1);const paused=player.t;game.stepCutscene(0);game.stepCutscene(0);assert.equal(player.t,paused,'Pause does not advance runtime playback');assert.equal(arrivals.length,0);if(skip)assert.equal(player.skip(),true);for(let i=0;game.cut&&i<300;i++)game.stepCutscene(1);assert.equal(player.done,true);assert.deepEqual(arrivals,[['capsule','door']],`${id} ${skip?'skip':'completion'} hands off once`);game.endCutscene(true);game.endCutscene(true);assert.equal(arrivals.length,1);
 }
}
assert.equal(JSON.stringify(initial),sourceBefore,'Runtime/roundtrip never mutate authored source');assert.equal(storageCalls,0,'Authoring playback never touches player saves');console.log('G7 temporary authoring integration passed: actual registry-derived source/editor clip catalogs; two round-tripped multi-shot sequences, shared stool/attached moving signal, named clips/discrete state/text/fade, deterministic scrub/reduced preview, real Game+CutscenePlay normal/reduced pause/skip/completion handoff exactly once, zero player-save access.');
