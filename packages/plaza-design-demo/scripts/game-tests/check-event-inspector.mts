for(const[kind,count]of Object.entries({noun:nouns,event:events,action:actions,case:cases}))assert.equal(graph.nodes.filter(n=>n.kind===kind).length,count,'Every active native '+kind+' represented; shared routes replace legacy proxy steps');
for(const kind of['attachment','travel','signal','network','conditional','handoff'])assert.ok(graph.edges.some(e=>e.kind===kind),kind);
for(const kind of['guard','dialogue','sector','clock','watchdog','link','opaque-callback','opaque-effect','opaque-use','engine-noun'])assert.ok(graph.nodes.some(n=>n.kind===kind),kind);
assert.ok(byId.has('noun:train:train.emergency.reg'));assert.ok(byId.has('noun:sandbox:cabinet.seq'));
for(const n of graph.nodes){assert.ok(existsSync(join(root,n.source.file)),n.id+': '+n.source.file);if(n.source.pointer&&n.source.file.endsWith('.json')){let v:unknown=JSON.parse(readFileSync(join(root,n.source.file),'utf8'));for(const p of n.source.pointer.slice(1).split('/')){v=(v as Record<string,unknown>)?.[p.replace(/~1/g,'/').replace(/~0/g,'~')];assert.notEqual(v,undefined,n.id+' '+n.source.pointer);}}}
const condition=graph.nodes.find(n=>n.kind==='condition')!,d=condition.details as{expression:string;device?:string;noun?:string},capture={origin:'captured-runtime' as const,scene:condition.scene,...d,result:true};
for(const[result,status]of[[true,'active'],[false,'blocked']]as const)assert.equal(buildEventInspection({snapshots:{conditions:{[condition.id]:{...capture,result}}}}).nodes.find(n=>n.id===condition.id)?.status,status);
assert.equal(buildEventInspection({snapshots:{conditions:{[condition.id]:{...capture,expression:'wrong'}}}}).nodes.find(n=>n.id===condition.id)?.status,'unbound');assert.equal(buildEventInspection({snapshots:{conditions:{[condition.id]:{...capture,device:'wrong'}}}}).nodes.find(n=>n.id===condition.id)?.status,'unbound');
const cable=graph.nodes.find(n=>n.kind==='cable')!,inactive=buildEventInspection({snapshots:{states:{[cable.id]:{origin:'captured-runtime',scene:cable.scene,status:'inactive',reason:'Captured cut'}}}});assert.equal(inactive.nodes.find(n=>n.id===cable.id)?.status,'inactive');assert.ok(inactive.edges.some(e=>(e.from===cable.id||e.to===cable.id)&&e.status==='inactive'));
const bad=buildEventInspection({documents:[{id:'missing-attachment',kind:'composition',revision:'test',value:{version:1,scene:'sandbox',instances:[{id:'test',type:'furniture.stool',props:{},placement:{x:0,h:0},attach:{instance:'absent',anchor:'seat'}}]}},{id:'missing-handoff',kind:'composition',revision:'test',value:{version:1,scene:'test-sequence',instances:[],sequence:{id:'test',duration:1,tracks:[],handoff:{scene:'absent',entrance:'door'}}}}]});assert.ok(bad.edges.some(e=>e.kind==='attachment'&&e.status==='missing'));assert.ok(bad.edges.some(e=>e.kind==='handoff'&&e.status==='missing'));
const prior=SCENES.sandbox.onEnter;SCENES.sandbox.onEnter=()=>{throw Error('Controller callback invoked');};try{assert.ok(buildEventInspection().nodes.some(n=>n.id==='callback:sandbox:onEnter'&&n.status==='opaque'));}finally{SCENES.sandbox.onEnter=prior;}
// Current validated behavior document takes precedence over stale statically imported Sandbox data.
const overlay=cloneBehavior(documents),behavior=overlay.find(d=>d.id==='sandbox-devices')!;
assert.ok(behavior,'Actual protected behavior document is registered');const authored=behavior.value as import('../../src/ssg/game/data').SceneData;behaviorNoun(authored,'lamp.lamp').on!.on={do:[{set:'lampOn',to:false}],say:['EDITED','Draft handler']};authored.cables.find(c=>c.id==='sbx.motion')!.verb='off';const overlayBefore=JSON.stringify(overlay),draft=buildEventInspection({documents:overlay});
assert.ok(draft.nodes.some(n=>n.scene==='sandbox'&&n.kind==='case'&&JSON.stringify(n.details).includes('Draft handler')));assert.equal((draft.nodes.find(n=>n.id==='cable:sandbox:sbx.motion')!.details as{verb:string}).verb,'off');assert.ok(draft.edges.some(e=>e.scene==='sandbox'&&e.from==='cable:sandbox:sbx.motion'&&e.label==='off'));assert.deepEqual(draft.nodes.filter(n=>n.scene!=='sandbox'),graph.nodes.filter(n=>n.scene!=='sandbox'));assert.equal(JSON.stringify(overlay),overlayBefore,'Overlay validation/projection does not mutate caller drafts');
const invalid=cloneBehavior(overlay);behaviorNoun(invalid.find(d=>d.id==='sandbox-devices')!.value as import('../../src/ssg/game/data').SceneData,'lamp.lamp').on!.on={do:[{set:'missing-state',to:true}]};const rejected=buildEventInspection({documents:invalid});assert.ok(rejected.diagnostics.some(d=>d.startsWith('Rejected Sandbox behavior draft:')));const sandboxNodes=(inspection:typeof graph)=>inspection.nodes.filter(n=>n.scene==='sandbox').map(node=>{const copy=structuredClone(node),spot=(copy.details as any)?.layout?.spot;if(copy.kind==='device'&&spot)spot.y??=0;return copy;});assert.deepEqual(sandboxNodes(rejected),sandboxNodes(graph),'Invalid overlay rejected; registered declarations retained with omitted zero height normalized');
console.log(JSON.stringify({milestone:'S12',coverage:graph.coverage,counts:{nodes:graph.nodes.length,edges:graph.edges.length,nouns,events,actions,cases},verified:['current scene registry','all nested declarations','19 scene compositions + four sequences + manifest pilot / 6 sequences','source files/JSON pointers','captured active/blocked/inactive/mismatch','missing attachment/handoff','immutable inputs','model/storage/callback traps','validated Sandbox draft handler/cable overlay','unrelated scenes unchanged; invalid draft rejected'],limitations:['DOM integration separate','conditions unbound without exact captures','controller code explicitly opaque']},null,2));
