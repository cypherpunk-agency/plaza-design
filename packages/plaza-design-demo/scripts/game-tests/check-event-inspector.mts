const root=fileURLToPath(new URL('../../src/ssg/game/',import.meta.url));
const documents:EditorDocument[]=sourceDocuments.map(d=>({id:d.id,kind:d.kind,revision:'read-only-test',value:JSON.parse(readFileSync(join(root,d.file),'utf8'))}));
const freeze=(v:unknown)=>{if(v&&typeof v==='object'){Object.freeze(v);Object.values(v).forEach(freeze);}};freeze(documents);const before=JSON.stringify(documents),sourceBefore=JSON.stringify([Object.values(SCENES).map(s=>s.data),NET,LOGIC]);
const methods=['snapshot','restore','act','tick'],proto=SceneModel.prototype as unknown as Record<string,unknown>,saved=methods.map(k=>proto[k]);methods.forEach(k=>proto[k]=()=>{throw Error('Model lifecycle invoked: '+k);});
