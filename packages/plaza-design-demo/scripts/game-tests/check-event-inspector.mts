const scan=(v:unknown)=>{if(!v||typeof v!=='object')return;if(Array.isArray(v)){v.forEach(scan);return;}const row=v as Record<string,unknown>;if(Array.isArray(row.do))actions+=row.do.length;for(const[k,x]of Object.entries(row))if(k!=='on'||!('noun'in row))scan(x);};
