assert.equal(JSON.stringify(documents),before);assert.equal(JSON.stringify([Object.values(SCENES).map(s=>s.data),NET,LOGIC]),sourceBefore);assert.equal(graph.coverage.sceneCount,Object.keys(SCENES).length);assert.equal(graph.coverage.declarativeScenes,Object.keys(SCENES).length);assert.equal(graph.coverage.compositionDocuments,documents.filter(d=>d.kind==='composition').length);assert.equal(graph.coverage.timelineSequences,5);assert.equal(graph.coverage.missingNodes,0,JSON.stringify(graph.nodes.filter(n=>n.status==='missing')));
