/** Exact allowlist/path/query/UTF8/size checks for the real source-reader used by compose.mts. */
import assert from'node:assert/strict';
import*as fs from'node:fs';import*as path from'node:path';import*as os from'node:os';import{fileURLToPath}from'node:url';
import{SourceReader,SourceReadError,readSourceRequest}from'../../src/ssg/game/authoring/server/source-reader';
import{extractSourcePointer}from'../../src/ssg/game/authoring/source-viewer';
import{buildEventInspection}from'../../src/ssg/game/authoring/event-inspector-model';
import{sourceDocuments}from'../../src/ssg/game/authoring/source-documents';
import type {EditorDocument} from '../../src/ssg/game/authoring/contracts';
const tmp=fs.mkdtempSync(path.join(os.tmpdir(),'plaza-source-')),game=path.join(tmp,'game'),outside=path.join(tmp,'outside');fs.mkdirSync(game);fs.mkdirSync(outside);fs.writeFileSync(path.join(game,'allowed.ts'),'<script>alert("literal only")</script>');fs.writeFileSync(path.join(game,'doc.json'),'{"a/b":{"~name":false}}');fs.writeFileSync(path.join(game,'unknown.ts'),'secret');fs.writeFileSync(path.join(outside,'escape.ts'),'outside');
const failure=(fn:()=>unknown,status:number)=>assert.throws(fn,e=>e instanceof SourceReadError&&e.status===status);
try{const reader=new SourceReader(game,['allowed.ts','doc.json']);assert.equal(reader.read('allowed.ts').text,'<script>alert("literal only")</script>');assert.equal(extractSourcePointer(reader.read('doc.json').text,'/a~1b/~0name'),false);assert.throws(()=>extractSourcePointer('{}','/__proto__'));assert.throws(()=>extractSourcePointer('{}','/~9'));
 for(const name of['../outside/escape.ts','/etc/passwd','C:/secret.ts','allowed.ts:stream.ts','a\\b.ts','a/../allowed.ts','allowed.js','a\0.ts'])failure(()=>reader.read(name),400);failure(()=>reader.read('unknown.ts'),404);
 for(const query of['','?file=allowed.ts&extra=1','?file=allowed.ts&file=doc.json','?other=allowed.ts'])failure(()=>readSourceRequest(reader,new URL('http://127.0.0.1/source'+query)),400);assert.equal(readSourceRequest(reader,new URL('http://127.0.0.1/source?file=doc.json')).file,'doc.json');
 fs.writeFileSync(path.join(game,'default-large.ts'),'x'.repeat(512*1024+1));failure(()=>new SourceReader(game,['default-large.ts']).read('default-large.ts'),413);fs.writeFileSync(path.join(game,'large.ts'),'x'.repeat(513));failure(()=>new SourceReader(game,['large.ts'],512).read('large.ts'),413);fs.writeFileSync(path.join(game,'bad.ts'),Buffer.from([0xff,0xfe]));failure(()=>new SourceReader(game,['bad.ts']).read('bad.ts'),422);
 fs.mkdirSync(path.join(game,'nested'));fs.writeFileSync(path.join(game,'nested','escape.ts'),'initial');const bound=new SourceReader(game,['nested/escape.ts']);fs.renameSync(path.join(game,'nested'),path.join(game,'retained'));fs.symlinkSync(outside,path.join(game,'nested'),'junction');failure(()=>bound.read('nested/escape.ts'),403);failure(()=>new SourceReader(game,['nested/escape.ts']),403);fs.unlinkSync(path.join(game,'nested'));
 const actualRoot=fileURLToPath(new URL('../../src/ssg/game/',import.meta.url));const documents:EditorDocument[]=sourceDocuments.map(d=>({id:d.id,kind:d.kind,revision:'readonly',value:JSON.parse(fs.readFileSync(path.join(actualRoot,d.file),'utf8'))}));const graph=buildEventInspection({documents});const files=new Set([...graph.nodes,...graph.edges].map(n=>n.source.file)),actual=new SourceReader(actualRoot,files);for(const file of files)assert.equal(actual.read(file).file,file);console.log(JSON.stringify({milestone:'S12-source-viewer',allowlistedSources:files.size,verified:['exact inspector-derived sources','unknown/traversal/absolute/ADS paths rejected','duplicate/extra/missing query rejected','512KiB default size bound','invalid UTF8 rejected','junction escape rejected at setup and after setup','literal unsafe-looking source preserved','escaped JSON pointer resolution; prototype pointer rejected'],limitations:['Browser DOM/source navigation integration separate; viewer uses textContent only']},null,2));
}finally{fs.rmSync(tmp,{recursive:true,force:true});}
