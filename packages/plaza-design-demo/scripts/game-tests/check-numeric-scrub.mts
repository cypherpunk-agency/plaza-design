import assert from 'node:assert/strict';
import {numericScrubStep,numericScrubValue} from '../../src/ssg/game/authoring/numeric-scrub';
import {ArtRegistry,type ChunkDocument} from '../../src/ssg/game/art/core/composition';
import {ComposerModel} from '../../src/ssg/game/authoring/composer-model';
const any={step:'any',min:'',max:''};
assert.equal(numericScrubStep(any),1);assert.equal(numericScrubStep({...any,min:'.0001'}),.01);assert.equal(numericScrubStep({...any,min:'0',max:'1'}),.01);assert.equal(numericScrubStep({...any,step:'.1'}),.1);
assert.equal(numericScrubValue(10,4,any),14);assert.equal(numericScrubValue(10,-4,any),6);assert.equal(numericScrubValue(10,.4,{...any,step:'1'}),10);assert.equal(numericScrubValue(10,1.4,{...any,step:'1'}),11);
assert.equal(numericScrubValue(.5,100,{...any,min:'0',max:'1'}),1);assert.equal(numericScrubValue(.5,-100,{...any,min:'0',max:'1'}),0);
assert.equal(numericScrubValue(.5,.001,any),.501);assert(Math.abs(numericScrubValue(0,1/60,{...any,step:String(1/60)})-1/60)<1e-8);
const registry=new ArtRegistry().register({type:'test',version:1,label:'Test',category:'test',fields:{size:{kind:'number',label:'Size',default:1,min:1}},parts:['backdrop'],bounds:()=>({x:0,h:0,w:10,tall:10}),anchors:()=>({}),draw(){}});
const composition:ChunkDocument={version:1,scene:'test',instances:[{id:'box',type:'test',props:{},placement:{x:0,h:0},layer:'backdrop',order:0}]};
const model=new ComposerModel(registry);model.load([{id:'scene',kind:'composition',revision:'initial',value:composition}]);
const x=()=> (model.get('scene').value as ChunkDocument).instances[0].placement.x,move=(value:number)=>model.updateInstance('scene','box','Move box',n=>n.placement.x=value);
const gesture=model.beginInteraction('Change X');move(10);move(20);move(30);assert.equal(x(),30,'Preview uses current validated source');assert(!model.canUndo,'Preview samples are not history steps');gesture.commit();assert.equal(model.undoLabel,'Change X');model.undo();assert.equal(x(),0);assert(!model.canUndo,'One Undo restores the whole drag');model.redo();assert.equal(x(),30);model.undo();
const before=model.sourceVersion,cancel=model.beginInteraction('Cancel X');move(5);move(11);cancel.cancel();assert.equal(x(),0);assert.equal(model.sourceVersion,before,'Cancellation restores the immutable source snapshot');assert(model.canRedo,'Cancellation preserves prior redo');
const noop=model.beginInteraction('No change');move(7);move(0);noop.commit();assert(!model.canUndo);assert(model.canRedo,'Returning to the starting value preserves history');
const invalid=model.beginInteraction('Invalid size');assert.throws(()=>model.updateInstance('scene','box','Invalid size',n=>n.props.size=0));invalid.commit();assert.equal(x(),0);assert(!model.canUndo);assert(model.canRedo,'A rejected sample does not destroy history');
const saved=model.beginInteraction('During save');move(14);const confirmed=model.get('scene');confirmed.revision='saved';model.confirmSaved([confirmed]);saved.cancel();assert.equal(x(),0);assert.equal(model.get('scene').revision,'saved','Cancellation cannot roll back an arriving source-save revision');
const transaction=model.beginInteraction('Nested sources');assert.throws(()=>model.beginInteraction('Nested'));assert.throws(()=>model.undo());transaction.cancel();
const constrained=new ComposerModel(registry,{},doc=>{if(doc.kind==='composition'&&(doc.value as ChunkDocument).instances[0].placement.x>25)throw Error('Cross-source constraint');});constrained.load([{id:'scene',kind:'composition',revision:'initial',value:composition}]);
const invalidRelease=constrained.beginInteraction('Invalid release');constrained.updateInstance('scene','box','Sample',n=>n.placement.x=30);assert(constrained.interactionPreview(),'Artwork samples use the existing transient preview');assert.throws(()=>invalidRelease.commit(),/Cross-source constraint/);assert(!constrained.canUndo);assert(!constrained.dirty(),'Rejected full validation rolls the entire gesture back');
console.log('Numeric scrub: precision/ranges, validated previews, one Undo, cancel/no-op/rejection preserves redo, source-save metadata and lifecycle PASS');
