import {createPendingCity,validatePendingCity} from '../../src/ssg/game/authoring/pending-city';
import {validationSnapshot} from '../../src/ssg/game/authoring/validation-snapshot';
import {NATIVE_SCENES} from '../../src/ssg/game/scenes';
import {deviceSourceIdentity} from '../../src/ssg/game/authoring/device-document-ids';
import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import {Element} from './rules-harness.mts';
import {TypedForm} from '../../src/ssg/game/authoring/typed-form';
import {renderSettingsAuthoring} from '../../src/ssg/game/authoring/render-settings-authoring';
import {climateAuthoring} from '../../src/ssg/game/authoring/climate-authoring';
import {sourceDocuments,validateSourceDocuments} from '../../src/ssg/game/authoring/source-documents';
import {AuthoringStore} from '../../src/ssg/game/authoring/server/store';
import {ComposerModel} from '../../src/ssg/game/authoring/composer-model';
import {createDocumentBundle,readDocumentBundle} from '../../src/ssg/game/authoring/document-bundle';
import {createSequenceValidationContext} from '../../src/ssg/game/art/core/sequence-context';
import {art,type ChunkDocument} from '../../src/ssg/game/art';
import {SCENES} from '../../src/ssg/game/scenes';
import {validateWorldCompositions,type WorldCompositions} from '../../src/ssg/game/world/compositions';
import {validateCitySource} from '../../src/ssg/game/world/city-source';
import {createCityModel,type CitySource} from '../../src/ssg/game/world/city';
import {renderPolicy} from '../../src/ssg/game/world/render-policy';
import {weatherAt} from '../../src/ssg/game/world/weather';
import {pendingRegistry,authoringValidationInputs} from '../../src/ssg/game/authoring/pending-registry';
const scratch=path.resolve('../../.game-test-output/local-presentation-authoring');fs.mkdirSync(scratch,{recursive:true});
const root=fs.mkdtempSync(path.join(scratch,'run-'));
assert(path.resolve(root).startsWith(scratch+path.sep));
try{
 for(const doc of sourceDocuments){const to=path.join(root,doc.file);fs.mkdirSync(path.dirname(to),{recursive:true});fs.copyFileSync(path.join('src/ssg/game',doc.file),to);}
 const store=new AuthoringStore({root,documents:sourceDocuments,validateAll:validateSourceDocuments}),initial=store.list();
 const context=createSequenceValidationContext(art,{},Object.fromEntries(Object.entries(SCENES).map(([id,s])=>[id,s.exits.map(e=>e.id)])));
 const validate=(d:any)=>{if(d.id==='city-source')validateCitySource(d.value);if(d.id==='world-compositions')validateWorldCompositions(d.value);};
 const pristine=validationSnapshot(initial),pristineRegistry=pendingRegistry(pristine);
 const cityModel=createPendingCity(pristine.get('city-source'),pristine);assert.equal(createPendingCity(pristine.get('city-source'),pristine),cityModel);
 const detachedCity=validatePendingCity(pristine.get('city-source'),pristine);detachedCity.CLIMATES.harbor.weights.rain=-1;assert.notEqual(cityModel.source.CLIMATES.harbor.weights.rain,-1,'Editable returned source cannot mutate a cached city model');assert.throws(()=>validatePendingCity(detachedCity,pristine),'Mutable drafts do not use immutable source cache');
 const climateOnly=initial.map(doc=>doc.id==='city-source'?{...doc,value:(()=>{const city=structuredClone(doc.value) as CitySource;city.CLIMATES.harbor.fixed='fog';return city;})()}:doc);
 assert.equal(pendingRegistry(validationSnapshot(climateOnly)),pristineRegistry,'Climate changes reuse scene definitions; frame/weather consumers receive the changed city source');
 const allNative=initial.map(doc=>Object.values(NATIVE_SCENES).some(scene=>deviceSourceIdentity(scene.id).scene===doc.id)?{...doc,value:{...(doc.value as any),environment:{...(doc.value as any).environment,rendering:{grade:false}}}}:doc);
 const nativeRegistry=pendingRegistry(validationSnapshot(allNative));
 for(const id of Object.keys(NATIVE_SCENES))assert.equal(nativeRegistry[id].rendering?.grade,false,'Native chunk consumes its environment rendering: '+id);
 console.log('Native source coverage: '+Object.keys(NATIVE_SCENES).length+' / '+Object.keys(NATIVE_SCENES).length+' chunk environments consume rendering settings.');
 const model=new ComposerModel(art,context,validate,[],undefined,authoringValidationInputs);model.load(initial);
 const host=new Element(),errors:unknown[]=[],form=new TypedForm(e=>errors.push(e));
 const all=(node:Element):Element[]=>[node,...node.children.flatMap(all)];
 const change=(label:string,value:string)=>{const field=all(host).find(e=>e.attributes['aria-label']===label);assert(field,label);field.value=value;field.onchange!();assert.deepEqual(errors,[]);};
 function rendering(){host.replaceChildren();const doc=model.get('sequence-opening').value as ChunkDocument;
  renderSettingsAuthoring(form,host as any,doc.sequence!.rendering,value=>model.edit('sequence-opening','Edit sequence rendering',raw=>{const d=raw as ChunkDocument;if(value)d.sequence!.rendering=value;else delete d.sequence!.rendering;return d;}));
 }
 rendering();change('Rendering · Color grading','on');
 assert.equal((model.get('sequence-opening').value as ChunkDocument).sequence!.rendering!.grade,true);
 model.undo();assert.equal((model.get('sequence-opening').value as ChunkDocument).sequence!.rendering!.grade,false);model.redo();
 rendering();change('Rendering · Color grading','inherit');assert.equal((model.get('sequence-opening').value as ChunkDocument).sequence!.rendering!.grade,undefined);model.undo();
 model.edit('world-compositions','Override arrival rendering',raw=>{const d=raw as WorldCompositions;d.compositions['harbor-world'].rendering={lights:false};d.compositions['harbor-world'].members[0].rendering={lights:true};return d;});
 const stationSource=deviceSourceIdentity('harborStation').scene;
 model.edit(stationSource,'Edit chunk rendering',raw=>{const d=raw as any;d.environment={...d.environment,rendering:{shade:false}};return d;});
 const groupId=(model.get('world-compositions').value as WorldCompositions).compositions['harbor-world'].members.find(m=>m.group)!.group!;
 model.edit('world-compositions','Edit shared group rendering',raw=>{const d=raw as WorldCompositions;d.groups[groupId].rendering={vision:false};return d;});
 model.edit('city-source','Edit district rendering',raw=>{const d=raw as CitySource;d.DISTRICTS.find(d=>d.id==='harbor')!.rendering={grade:false};return d;});
 host.replaceChildren();const city=model.get('city-source').value as CitySource;
 climateAuthoring(form,host as any,'harbor',city.CLIMATES.harbor,fn=>model.edit('city-source','Edit district climate',raw=>{fn((raw as CitySource).CLIMATES.harbor);return raw;}));
 change('Climate harbor fixed weather','fog');
 const beforeInvalid=JSON.stringify(model.get('city-source').value);assert.throws(()=>model.edit('city-source','Reject invalid climate even with warm scene cache',raw=>{(raw as CitySource).CLIMATES.harbor.weights.rain=-1;return raw;}));assert.equal(JSON.stringify(model.get('city-source').value),beforeInvalid);
 const values=()=>new Map(model.list().map(d=>[d.id,d.value]));validateSourceDocuments(values());
 const receiver=new ComposerModel(art,context,validate,[],undefined,authoringValidationInputs);receiver.load(initial);receiver.importDocuments(readDocumentBundle(createDocumentBundle(model.edits(),model.list()),receiver.list()));
 assert.deepEqual(receiver.edits(),model.edits());
 const before=store.read('city-source'),bad=structuredClone(before.value) as CitySource;bad.CLIMATES.harbor.weights={rain:-1};
 assert.throws(()=>store.save([{...before,value:bad}]));assert.equal(store.read('city-source').revision,before.revision);
 const result=store.save(model.edits());model.confirmSaved(result.documents);assert.equal(model.dirty(),false);
 const fresh=new AuthoringStore({root,documents:sourceDocuments,validateAll:validateSourceDocuments});
 const savedCity=createCityModel(fresh.read('city-source').value as CitySource),world=validateWorldCompositions(fresh.read('world-compositions').value),sequence=(fresh.read('sequence-opening').value as ChunkDocument).sequence!;
 assert.equal(weatherAt('harbor',1,1200,3,savedCity.source).kind,'fog');
 const scenes=pendingRegistry(new Map(fresh.list().map(d=>[d.id,d.value])));
 assert.equal(scenes.harborStation.rendering?.shade,false,'Chunk override survives protected Save and native reconstruction');
 assert.equal(world.groups[groupId].rendering?.vision,false,'Shared group override survives bundle and protected Save');
 assert.equal(world.compositions['harbor-world'].rendering?.lights,false);
 assert.equal(world.compositions['harbor-world'].members[0].rendering?.lights,true);
 assert.equal(savedCity.source.DISTRICTS.find(d=>d.id==='harbor')!.rendering?.grade,false);
 assert.deepEqual(renderPolicy(scenes['harbor-station'],savedCity.source,world,sequence,'harbor-world').sources.grade,{kind:'sequence',id:'glide'});
 assert.equal(renderPolicy(scenes['harbor-station'],savedCity.source,world,sequence,'harbor-world').values.grade,true);
 console.log('Local presentation authoring PASS: typed controls, reset, Undo/Redo, bundle import, rejection, protected Save, fresh source reconstruction and native settings/forecast.');
}finally{fs.rmSync(root,{recursive:true,force:true});}
