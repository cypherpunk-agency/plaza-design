/** Containment of actual native machinery drawing commands, independent of an image oracle. */
import assert from'node:assert/strict';import fs from'node:fs';import path from'node:path';
import{vehicleState,prepareVehiclePreview,paintVehiclePreview}from'../../src/ssg/game/authoring/vehicle-workbench';
function geometry(width:number,height:number){let a=1,d=1,e=0,f=0;const stack:number[][]=[],points:[number,number][]=[],props:Record<string,unknown>={canvas:{width,height}},gradient={addColorStop(){}};
 const point=(x:number,y:number)=>{points.push([x*a+e,y*d+f]);};
 const ctx=new Proxy(props,{set(o,k,v){o[String(k)]=v;return true;},get(o,k){if(k in o)return o[String(k)];switch(k){case'save':return()=>stack.push([a,d,e,f]);case'restore':return()=>{[a,d,e,f]=stack.pop()!;};case'translate':return(x:number,y:number)=>{e+=a*x;f+=d*y;};case'scale':return(x:number,y:number)=>{a*=x;d*=y;};case'getTransform':return()=>({a,b:0,c:0,d,e,f});case'measureText':return(s:string)=>({width:s.length*5});case'createLinearGradient':case'createRadialGradient':return()=>gradient;case'fillRect':case'strokeRect':case'rect':return(x:number,y:number,w:number,h:number)=>{if(k==='fillRect'&&props.fillStyle==='#0c0a12')return;point(x,y);point(x+w,y+h);};case'moveTo':case'lineTo':return point;case'arc':return(x:number,y:number,r:number)=>{point(x-r,y-r);point(x+r,y+r);};case'ellipse':return(x:number,y:number,rx:number,ry:number)=>{point(x-rx,y-ry);point(x+rx,y+ry);};default:return()=>{};}}}) as unknown as CanvasRenderingContext2D;return{ctx,points};}
const rows=[];for(const id of ['ground.straddle','ground.stacker'])for(const[width,height]of [[800,420],[900,460]])for(const facing of [1,-1] as const)for(const pose of [0,.5,.85,1])for(const cargo of [false,true]){
 const g=geometry(width,height),s={...vehicleState(id),facing,pose,cargo,time:2.283333333333333};paintVehiclePreview(g.ctx,prepareVehiclePreview(s,width,height));assert.ok(g.points.length>=20);const xs=g.points.map(p=>p[0]),ys=g.points.map(p=>p[1]),bounds={left:Math.min(...xs),right:Math.max(...xs),top:Math.min(...ys),bottom:Math.max(...ys)};assert.ok(bounds.left>=8&&bounds.right<=width-8&&bounds.top>=8&&bounds.bottom<=height-8,JSON.stringify({id,width,height,facing,pose,cargo,bounds}));rows.push({id,width,height,facing,pose,cargo,bounds,nativeGeometryPoints:g.points.length});
}
fs.writeFileSync(path.resolve('../../.game-test-output/evidence/S10-native-machinery-containment.json'),JSON.stringify({cases:rows.length,source:'Actual native rect/path/arc/ellipse commands transformed through workbench camera; no duplicate arm/cargo coordinate formulas.',allHardGeometryContained:true,marginPixels:8,scope:['straddle complete cab/beacon/cargo','stacker complete arm/spreader/cargo at reach0..1'],rows},null,2));console.log('Native machinery geometry containment passed '+rows.length+' facing/reach/lift/cargo/viewport cases.');
