import assert from 'node:assert/strict';
import {PerformanceRecorder,perfBegin,perfEnd,perfSample,startPerformance,stopPerformance,calibratePerformance} from '../../src/ssg/game/runtime/diagnostics/performance';
assert.equal(perfBegin('game.frame'),-1);perfEnd(-1);perfSample('raf.gap',10);assert.equal(stopPerformance(),undefined);
let clock=0;const recorder=new PerformanceRecorder({source:'fixture:1',scenario:'nested-and-async',capacity:16},()=>clock);
const root=recorder.begin('game.frame');clock=1;const child=recorder.begin('game.update');clock=3;recorder.end(child);clock=5;recorder.end(root);clock=8;const async=recorder.begin('host.tick','background-scene');clock=9;recorder.end(async);recorder.sample('raf.gap',16.67);
let report=recorder.stop();assert.equal(report.samples[0].duration,5);assert.equal(report.samples[1].parent,0);assert.equal(report.samples[1].duration,2);assert.equal(report.samples[2].parent,-1);assert.equal(report.samples[2].owner,'background-scene');assert.equal(report.summary['host.tick']!.count,1);assert.equal(report.summary['raf.gap']!.p95,16.67);assert.equal(report.incomplete,0);assert.equal(report.invalidEnds,0);assert.equal(recorder.begin('save.write'),-1);
report.environment.changed=true;assert.equal(recorder.report().environment.changed,undefined);
const bounded=new PerformanceRecorder({source:'fixture:2',scenario:'overflow',capacity:16},()=>clock);for(let i=0;i<100;i++){const token=bounded.begin('game.frame');bounded.end(token);}report=bounded.stop();assert.equal(report.samples.length,16);assert.equal(report.overflow,84);
const bad=new PerformanceRecorder({source:'fixture:3',scenario:'unfinished',capacity:16},()=>clock);const a=bad.begin('game.frame'),b=bad.begin('game.render');bad.end(a);bad.end(b);report=bad.stop();assert.equal(report.incomplete,1);assert.equal(report.invalidEnds,1);assert.equal(report.samples[0].id,1);assert.equal(report.samples[0].parent,0);
assert.throws(()=>new PerformanceRecorder({source:'x',scenario:'x',capacity:1}));startPerformance({source:'fixture:4',scenario:'singleton'});assert.throws(()=>startPerformance({source:'x',scenario:'x'}));assert.throws(()=>calibratePerformance());perfEnd(perfBegin('save.write'));assert.equal(stopPerformance()!.samples.length,1);assert.equal(perfBegin('game.frame'),-1);
const overhead=calibratePerformance();assert.equal(overhead.rounds.length,5);assert(Number.isFinite(overhead.medianExtraMicrosecondsPerSpan));
console.log(JSON.stringify({status:'PASS',scope:'bounded recorder, nesting/async, overflow, incomplete samples, no-op/disposal, synthetic Node overhead only',node:process.version,platform:process.platform,overhead}));
