import assert from 'node:assert/strict';
import {SceneModel} from '../../src/ssg/game/engine/model';
import {SCENES} from '../../src/ssg/game/scenes';
import {GameplaySession} from '../../src/ssg/game/engine/gameplay/session';
import {nativeLiveConditionsTick} from '../../src/ssg/game/engine/gameplay/native-live-conditions';
const definition={version:1,flags:['inside','allowed'],items:[],events:[],commands:{reward:{sources:['system'],when:{flag:'allowed'},actions:[{tokens:1}]}},reactions:[],conversations:{},native:{verbs:[],events:{},goals:{},triggers:{arrival:{when:{flag:'inside'},command:'reward',once:true}}}};
let state:any={flags:{inside:true,allowed:true},items:{},tokens:0},snapshot:any;
const model=new SceneModel({say(){},changed(){},open(){}},SCENES.capsule.data!);
const session=new GameplaySession(definition,{read:()=>state,write:s=>state=s},()=>{snapshot=model.snapshot();});
const tick=()=>nativeLiveConditionsTick(model,session,run=>run());
tick();assert.equal(state.tokens,0,'initial true condition only establishes a baseline');
state.flags.inside=false;tick();state.flags.inside=true;state.flags.allowed=false;tick();assert.equal(state.tokens,0);assert(!model.triggerHistory.has('arrival'),'failed command does not consume the trigger');
state.flags.inside=false;tick();state.flags.allowed=true;state.flags.inside=true;tick();
assert.equal(state.tokens,1);assert.deepEqual(snapshot.triggers,['arrival'],'receipt exists during afterCommit persistence');
state.flags.inside=false;tick();state.flags.inside=true;tick();assert.equal(state.tokens,1,'once-only reward does not repeat');
model.restore(snapshot);tick();state.flags.inside=false;tick();state.flags.inside=true;tick();assert.equal(state.tokens,1,'save/reload preserves the activation without replay');
model.reset();tick();state.flags.inside=false;tick();state.flags.inside=true;tick();assert.equal(state.tokens,2,'new run resets activation history');
session.dispose();model.reset();
console.log('Trigger history: baseline, failed eligibility, atomic persistence, repeated entry, reload and new run PASS');
