import assert from 'node:assert/strict';import fs from 'node:fs';import {sourceDocuments} from '../../src/ssg/game/authoring/source-documents';import {pendingFixtureVocabulary,validatePendingFixtures} from '../../src/ssg/game/authoring/pending-fixtures';import {validatePlayFixtures,fixtureSave} from '../../src/ssg/game/world/checkpoints';import {renameWorldFlagDocuments} from '../../src/ssg/game/authoring/world-flag-references';
const documents=new Map(sourceDocuments.map(d=>[d.id,JSON.parse(fs.readFileSync('src/ssg/game/'+d.file,'utf8'))]));for(const change of renameWorldFlagDocuments(documents,'harbor:open','review.harbor.open'))documents.set(change.id,change.value);const network=structuredClone(documents.get('network'));network.programs.push({id:'review-fixture.so',name:'REVIEW',look:'Fixture program',foundIn:'library'});network.keyring.push({id:'review.fixture-key',kind:'key',label:'Review fixture key'});documents.set('network',network);const library=structuredClone(documents.get('library-devices'));library.devices[0].nouns.push({id:'review.program',layer:'data',function:'hold',verbs:['read'],on:{read:{do:[{give:'review-fixture.so'}]}}});documents.set('library-devices',library);const fixtures=structuredClone(documents.get('play-fixtures')),fixture=fixtures.fixtures.find((f:any)=>f.id==='train-siding-open');fixture.keyring=['review.fixture-key'];fixture.programs=['scan.so','review-fixture.so'];const vocabulary=pendingFixtureVocabulary(documents);assert(vocabulary.flags.has('review.harbor.open'));assert(!vocabulary.flags.has('harbor:open'));assert(vocabulary.keyring.has('review.fixture-key'));assert(vocabulary.programs.has('review-fixture.so'));validatePendingFixtures(fixtures,documents);const save=fixtureSave(fixture,[],vocabulary);assert.equal(save.flags['review.harbor.open'],true);assert.deepEqual(save.keyring,['review.fixture-key']);assert.deepEqual(save.programs,['scan.so','review-fixture.so']);
for(const kind of['flags','keyring','programs']as const){const missing={...vocabulary,[kind]:new Set<string>()};assert.throws(()=>validatePlayFixtures({version:1,fixtures:[fixture]},true,[],missing),kind+' override replaces rather than appends shipping metadata');assert.throws(()=>fixtureSave(fixture,[],missing));}
for(const kind of['keyring','programs']as const){const changed=new Map(documents),net=structuredClone(network);net[kind]=net[kind].filter((row:any)=>!/^review[.-]/.test(row.id));changed.set('network',net);assert.throws(()=>validatePendingFixtures(fixtures,changed),'removed pending '+kind+' reference rejects');}
const old=structuredClone(fixtures);delete old.fixtures.find((f:any)=>f.id==='train-siding-open').flags['review.harbor.open'];old.fixtures.find((f:any)=>f.id==='train-siding-open').flags['harbor:open']=true;assert.throws(()=>validatePendingFixtures(old,documents),'removed world role never falls back to shipping vocabulary');const missing=new Map(documents);missing.delete('network');assert.throws(()=>pendingFixtureVocabulary(missing),/requires network/);console.log('Pending fixture vocabulary PASS: actual flags/keys/programs, fresh Save, explicit context replaces shipping defaults, removed role/key/program rejection and required pending metadata.');

