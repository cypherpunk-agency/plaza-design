const store=new AuthoringStore({root,documents:sourceDocuments,validateAll:validateSourceDocuments}),initial=store.list(),descriptor=sourceDocuments.find(d=>d.id==='opening-story')!,original=fs.readFileSync(path.join(root,descriptor.file),'utf8');
