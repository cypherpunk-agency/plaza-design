import assert from 'node:assert/strict';
import {source} from '../../src/ssg/game/world/city';
import {validateCitySource} from '../../src/ssg/game/world/city-source';
import {renderPolicy} from '../../src/ssg/game/world/render-policy';
import {validateRenderSettings,RENDER_PASSES} from '../../src/ssg/game/world/render-settings';
import {validateWorldCompositions,type WorldCompositions} from '../../src/ssg/game/world/compositions';
import {weatherAt,sceneClimate,screenLine,forecast,reportLines} from '../../src/ssg/game/world/weather';
const city=structuredClone(source),district=city.DISTRICTS.find(d=>d.id==='harbor')!;
const scene='harbor-station';
assert.equal(city.PLACES.find(p=>(p.scenes as string[]).includes(scene))?.district,'harbor');
const world:WorldCompositions={version:1,groups:{arrival:{name:'Arrival',members:[{id:'station',chunk:scene,placement:{x:0,h:0},rendering:{grade:false}}],connections:[],exports:{}}},compositions:{test:{name:'Test',members:[{id:'arrival',group:'arrival',placement:{x:0,h:0},rendering:{grade:true}}],connections:[],rendering:{grade:false}}}};
district.rendering={grade:false};
const policy=(local?:{grade?:boolean},sequence?:Parameters<typeof renderPolicy>[3])=>renderPolicy({id:scene,rendering:local},city,validateWorldCompositions(world),sequence,'test');
assert.equal(policy().values.grade,false);assert.deepEqual(policy().sources.grade,{kind:'member',composition:'test',member:'arrival',child:'station'});
delete world.groups.arrival.members[0].rendering;
assert.equal(policy().values.grade,true);assert.deepEqual(policy().sources.grade,{kind:'member',composition:'test',member:'arrival'});
delete world.compositions.test.members[0].rendering;
assert.equal(policy({grade:true}).values.grade,false);assert.deepEqual(policy().sources.grade,{kind:'composition',id:'test'});
delete world.compositions.test.rendering;
assert.deepEqual(policy({grade:true}).sources.grade,{kind:'chunk',id:scene});
assert.deepEqual(policy().sources.grade,{kind:'district',id:'harbor'});
const seq={id:'test',rendering:{grade:true},memberRendering:{[scene]:{grade:false}}};
assert.equal(policy(undefined,seq).values.grade,false);delete seq.memberRendering[scene];
assert.equal(policy(undefined,seq).values.grade,true);assert.deepEqual(policy(undefined,seq).sources.grade,{kind:'sequence',id:'test'});
assert.deepEqual(renderPolicy({id:'not-in-city'},city).sources.grade,{kind:'default'});
assert.equal(RENDER_PASSES.length,10);
for(const invalid of [null,[],{grade:0},{grade:'false'},{grading:true}])assert.throws(()=>validateRenderSettings(invalid));
assert.deepEqual(validateRenderSettings({grade:false,weather:true}),{grade:false,weather:true});
assert.equal(sceneClimate('beach',city),'beach');
const base=weatherAt('harbor',1,1200,3,city);
const pending=structuredClone(city);pending.CLIMATES.harbor.fixed='heat';pending.CLIMATES.harbor.note='PENDING HEAT';
assert.equal(weatherAt('harbor',1,1200,3,pending).kind,'heat');
assert.equal(screenLine('harbor',pending),'WEATHER: PENDING HEAT');
assert.ok(reportLines('harbor',12,pending).some(line=>line.includes('PENDING HEAT')));
assert.ok(forecast('harbor',12,1200,3,pending).every(s=>s.kind==='heat'));
assert.deepEqual(weatherAt('harbor',1,1200,3,city),base,'pending source never mutates shipping policy');
pending.CLIMATES.harbor.weights={clear:0,rain:0};assert.throws(()=>validateCitySource(pending));
pending.CLIMATES.harbor.weights={heat:1};assert.doesNotThrow(()=>validateCitySource(pending));
pending.PLACES.find(p=>p.climate==='beach')!.climate='missing';assert.throws(()=>validateCitySource(pending));
console.log('Local presentation PASS: typed switches, source precedence/reset, member override, climate binding, deterministic pending forecast/report and rejection.');
