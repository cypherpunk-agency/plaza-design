import assert from'node:assert/strict';import fs from'node:fs';import path from'node:path';
import{SIGNAGE_FAMILIES,SIGNAGE_KERNEL_CASES}from'../../src/ssg/game/authoring/catalogues/signage';
import{prepareSignage,paintSignage,signageState,validateSignageState}from'../../src/ssg/game/authoring/signage-kernels';
import{embeddedSignageInventory,embeddedSignageRequest,type SignageWorkbenchConfig,type EmbeddedSignageSettings}from'../../src/ssg/game/authoring/signage-workbench';
import{paintSignageNativeReference}from'./check-signage-workbench-reference';
import{art}from'../../src/ssg/game/art';import{sourceDocuments}from'../../src/ssg/game/authoring/source-documents';
import{SCENES}from'../../src/ssg/game/scenes';import nativeStates from'../../src/ssg/game/authoring/catalogues/signage-states.json';
import{ride,lineOpen}from'../../src/ssg/game/world/transport/line';import{city}from'../../src/ssg/game/world/clock';import{light}from'../../src/ssg/game/world/light';import{hereClimate,overrideOf,CLIMATE_IDS}from'../../src/ssg/game/world/weather';
function recording(){const ops:unknown[]=[],values:Record<string,unknown>={canvas:{width:800,height:420}},gradient={addColorStop(...args:unknown[]){ops.push(['stop',...args]);}};const ctx=new Proxy(values,{get(o,k){if(k==='getTransform')return()=>({a:1,b:0,c:0,d:1,e:0,f:0});if(k==='measureText')return(s:string)=>({width:s.length*5});if(k==='createLinearGradient'||k==='createRadialGradient')return(...a:unknown[])=>{ops.push([k,...a]);return gradient;};if(k in o)return o[String(k)];return(...a:unknown[])=>ops.push([k,...a]);},set(o,k,v){o[String(k)]=v;ops.push(['set',k,v===gradient?'gradient':v]);return true;}}) as unknown as CanvasRenderingContext2D;return{ctx,ops};}
Object.assign(globalThis,{document:{createElement(){return{width:0,height:0,getContext(){return recording().ctx;}};}}});
const documents=sourceDocuments.map(d=>({id:d.id,kind:d.kind,revision:'test',value:JSON.parse(fs.readFileSync('src/ssg/game/'+d.file,'utf8'))})),source=JSON.stringify(documents),globals=()=>JSON.stringify({ride,lineOpen,city:[city.day,city.min,city.seed,city.speed,city.pinned],light:light(),climate:hereClimate(),weather:['city',...CLIMATE_IDS].map(c=>overrideOf(c as 'city'))}),before=globals(),rows=[];
assert.equal(SIGNAGE_FAMILIES.length,33);for(const row of SIGNAGE_KERNEL_CASES){const s={...signageState(row.id),...row},input=JSON.stringify(s),a=recording(),b=recording(),c=recording();paintSignageNativeReference(a.ctx,s);paintSignage(b.ctx,prepareSignage(s));prepareSignage({...s,time:37.123});paintSignage(c.ctx,prepareSignage(s));assert.deepEqual(b.ops,a.ops,row.id+' '+row.variant+' native commands');assert.deepEqual(b.ops,c.ops,row.id+' seek/replay');assert.equal(JSON.stringify(s),input);rows.push({id:row.id,variant:row.variant,time:row.time,minute:row.minute,reduced:row.reduced,power:row.power,commands:b.ops.length});}
const embedded=embeddedSignageInventory({registry:art,documents});assert.equal(embedded.length,308);assert.equal(embedded.reduce((n,e)=>n+e.usages.length,0),725);for(const e of embedded)assert.ok(e.usages.length);
function sets(value:unknown,key:string,to:unknown):boolean{if(!value||typeof value!=='object')return false;if(!Array.isArray(value)&&(value as any).set===key&&(value as any).to===to)return true;return Object.values(value).some(v=>sets(v,key,to));}
const config:SignageWorkbenchConfig={registry:art,documents,openUsage(){throw new Error('No source navigation during validation');},renderNative(){throw new Error('No paint/model during request validation');}},settings:EmbeddedSignageSettings={time:1,minute:1320,seed:41,reduced:false,weather:'clear',zoom:1,cameraX:0,cameraH:0,mode:'composed'};
for(const control of nativeStates.controls){assert.equal(SCENES[control.scene].data!.state[control.key],control.default);const data=JSON.parse(fs.readFileSync('src/ssg/game/'+control.source,'utf8'));for(const value of control.values)assert.ok(sets(data,control.key,value),'Declared native setter missing '+control.scene+'.'+control.key+'='+value);const usage=embedded.flatMap(e=>e.usages).find(u=>u.scene===control.scene&&u.instance===control.instance)!;assert.ok(usage);for(const value of control.values){const request=embeddedSignageRequest(config,usage,{...settings,state:{[control.key]:value}});assert.deepEqual(JSON.parse(String(request.environment.state)),{[control.key]:value});}assert.throws(()=>embeddedSignageRequest(config,usage,{...settings,state:{[control.key]:'unsupported'}}));assert.throws(()=>embeddedSignageRequest(config,usage,{...settings,state:{missing:true}}));if(control.key==='nightLight')assert.throws(()=>embeddedSignageRequest(config,usage,{...settings,minute:580,state:{nightLight:true}}));}
assert.equal(JSON.stringify(documents),source);assert.equal(globals(),before);
for(const patch of[{time:NaN},{time:-1},{minute:1440},{zoom:0},{text:'x'.repeat(241)},{variant:'missing'},{seed:.2},{id:'missing'}])assert.throws(()=>validateSignageState({...signageState(),...patch}));
assert.throws(()=>validateSignageState({...signageState('architecture.tower'),variant:'gear:billboard'}),'Declared but unimplemented gear is visibly unavailable, never a fabricated preview');
const report={typedFamilies:33,kernelCases:rows.length,embeddedTypes:308,sourceUsages:725,sourceLightControls:3,nativeSourceValues:6,lightKeysAndValuesMatchActualDefaultsAndDeclaredSetters:true,nightWindowAndUnsupportedStateRejected:true,allNativeCommandComparisonsPassed:true,seekReplay:true,transportClockLightWeatherSourcePreserved:true,invalidCases:8,rows};fs.writeFileSync(path.resolve('../../.game-test-output/evidence/S11-signage-command-contracts.json'),JSON.stringify(report,null,2));console.log(JSON.stringify({...report,rows:undefined}));
