import assert from 'node:assert/strict';
import {ArtRegistry,drawCompositionSlot,beginLayeredFrame,endLayeredFrame,type ChunkDocument} from '../../src/ssg/game/art/core/composition';
import {evaluateTimeline,validateTimeline,timelineArtwork,type TimelineProgram} from '../../src/ssg/game/art/core/timeline';
import {frameView} from '../../src/ssg/game/art/core/view';
import {measureArtwork} from '../../src/ssg/game/art/core/measure';
import {ComposerModel} from '../../src/ssg/game/authoring/composer-model';
import {setKeyAtPlayhead} from '../../src/ssg/game/authoring/keyframe-control';
import {SCENES} from '../../src/ssg/game/scenes';
import {art} from '../../src/ssg/game/art';
const painted:number[]=[];
const registry=new ArtRegistry().register({type:'box',version:1,label:'Box',category:'test',libraryUse:'reusable',parts:['backdrop'],fields:{size:{kind:'number',label:'Size',default:10},fixed:{kind:'string',label:'Configuration',default:'fixed',animatable:false},list:{kind:'json',label:'List',default:[],validate(){}}},bounds:()=>({x:0,h:10,w:10,tall:10}),anchors:()=>({}),draw(_ctx,_v,p){painted.push(Number(p.size));}});
assert.equal(registry.get('box').fields.size.animatable,true);assert.equal(registry.get('box').fields.fixed.animatable,false);assert.equal(registry.get('box').fields.list.animatable,false);
assert.equal(art.get('environment.palm').fields.fill.animatable,true);
const source=(scene:string):ChunkDocument=>({version:1,scene,instances:[{id:'same-id',type:'box',props:{},placement:{x:0,h:0},order:0,layer:'set'}]});
const a=source('a'),b=source('b'),c=source('c');
const program:TimelineProgram={version:1,sequences:[{id:'move',duration:5,composition:'a',shots:[],text:[],fades:[],beats:[],tracks:[]}]};
setKeyAtPlayhead(program.sequences[0],{kind:'instance',scene:'b',instance:'same-id',property:'x'},0,20,false);
setKeyAtPlayhead(program.sequences[0],{kind:'instance',scene:'b',instance:'same-id',property:'x'},5,120,false);
setKeyAtPlayhead(program.sequences[0],{kind:'property',scene:'b',instance:'same-id',property:'size'},0,35,false);
const context={registry,compositions:{a,b,c}};validateTimeline(program,context);
const frame=evaluateTimeline(program,'move',2.5,context);assert.equal(timelineArtwork(frame,'b')!.composition.instances[0].placement.x,70);assert.equal(frame.composition.instances[0].placement.x,0);assert.equal(b.instances[0].placement.x,0);assert.equal(timelineArtwork(frame,'c'),undefined);
const view={...frameView(0),sequence:{time:2.5,state:frame.state,artwork:frame.artwork}};
measureArtwork(ctx=>{beginLayeredFrame();try{drawCompositionSlot(ctx,registry,b,{view,state:{},reduced:false},'behind-player');}finally{endLayeredFrame();}});assert.deepEqual(painted,[35],'the normal painter consumes source-qualified evaluated properties');
assert.throws(()=>validateTimeline({...program,sequences:[{...program.sequences[0],tracks:[{id:'bad',target:{kind:'instance',scene:'missing',instance:'same-id',property:'x'},keys:[{time:0,value:1}]}]}]},context),/source/);
a.sequence={...program.sequences[0]};delete(a.sequence as any).composition;
const model=new ComposerModel(registry);model.load([a,b,c].map(value=>({id:value.scene,kind:'composition',revision:'v1',value})));
const old=model.inspectDocuments(),oldB=old.find(d=>d.id==='b')!,oldC=old.find(d=>d.id==='c')!;assert(Object.isFrozen(oldB.value));assert.throws(()=>((oldB.value as ChunkDocument).instances[0].placement.x=300));
model.updateInstance('b','same-id','Move source',node=>node.placement.h=5);const next=model.inspectDocuments();assert.equal(next.find(d=>d.id==='c'),oldC,'unchanged documents retain immutable inspection identity');assert.notEqual(next.find(d=>d.id==='b'),oldB);
model.undo();assert.equal((model.get('b').value as ChunkDocument).instances[0].placement.h,0);model.redo();assert.equal((model.get('b').value as ChunkDocument).instances[0].placement.h,5);
const detached=model.get('b');(detached.value as ChunkDocument).instances[0].placement.x=900;assert.equal((model.get('b').value as ChunkDocument).instances[0].placement.x,0,'mutable public reads remain detached');
model.confirmSaved([model.get('b')]);assert.equal(model.dirty('b'),false);model.updateInstance('b','same-id','Move again',n=>n.placement.x=1);assert.equal(model.dirty('b'),true);
for(const scene of Object.values(SCENES))if(scene.ambient?.sky)assert(scene.backdrop||scene.artwork?.instances.some(n=>n.type==='environment.sky'),scene.id+' sky must have a selectable source');
console.log('Source-qualified animation, duplicate instance isolation, shared painting, animation eligibility, immutable cache invalidation, history and saved baseline PASS');
