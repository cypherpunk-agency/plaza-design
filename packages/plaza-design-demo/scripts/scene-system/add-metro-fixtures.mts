import fs from 'node:fs';import {defaultPlayFixture,validatePlayFixtures,validateFixtureMetro} from '../../src/ssg/game/authoring/play-fixtures';import {metroStartingState} from '../../src/ssg/game/authoring/metro-starting-state';import * as city from '../../src/ssg/game/world/city';import {METRO_SOURCE} from '../../src/ssg/game/world/transport/metro-source';
const file='src/ssg/game/authoring/play-fixtures.json',doc=validatePlayFixtures(JSON.parse(fs.readFileSync(file,'utf8')));for(const [id,name,kind]of [['train-start','Train · Galleria departure','at-station'],['train-before-siding','Train · approaching the hidden siding','running'],['train-at-siding','Train · stopped at the hidden siding','siding'],['train-siding-open','Train · siding doors released','siding-open']] as const){if(doc.fixtures.some(f=>f.id===id))throw Error('Fixture already exists: '+id);const f=defaultPlayFixture('train');f.id=id;f.name=name;f.items['maglev.pass']=1;f.metro=metroStartingState(kind,'galleria',city,METRO_SOURCE);if(kind==='siding-open')f.flags[city.HARBOR_FLAG]=true;doc.fixtures.push(f);}validateFixtureMetro(doc);fs.writeFileSync(file,JSON.stringify(validatePlayFixtures(doc),null,2)+'\n');
