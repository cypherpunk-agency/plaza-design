{
  "version": 1,
  "dialogue": {
    "speaker": "CONCIERGE · door daemon",
    "start": "start",
    "sayCmd": "say \"{line}\" > concierge",
    "nodes": {
      "start": [
        {
          "if": "doorOpen",
          "text": "Ah. The tenant of 7B, paid and present. I have prepared a form congratulating you.",
          "choices": [
            [
              "Thanks, I think.",
              "bye"
            ],
            [
              "When's maintenance?",
              "tuesday"
            ]
          ]
        },
        {
          "text": "CONCIERGE, at your service, within reason. Your rent is pending.",
          "choices": [
            [
              "I paid.",
              "paid"
            ],
            [
              "Open the door.",
              "door"
            ],
            [
              "Nice door frame.",
              "oak"
            ],
            [
              "When's maintenance?",
              "tuesday"
            ]
          ]
        }
      ],
      "paid": {
        "text": "Then there is a receipt. Receipts are sent, not described. I do not accept verbal receipts.",
        "choices": [
          [
            "It's stuck in my outbox.",
            "outbox"
          ],
          [
            "Let me start over.",
            "start"
          ]
        ]
      },
      "outbox": {
        "text": "Then it is your outbox's problem, and I wish it well. When a document reaches my desk, I verify. I live to verify.",
        "choices": [
          [
            "Noted.",
            "bye"
          ]
        ]
      },
      "door": {
        "text": "The door opens for paid tenants. You are a tenant. The rest is paperwork, and the paperwork has paperwork.",
        "choices": [
          [
            "Let me start over.",
            "start"
          ]
        ]
      },
      "oak": {
        "text": "It is original oak-effect. Nobody ever notices.",
        "choices": [
          [
            "I noticed.",
            "noticed"
          ]
        ]
      },
      "noticed": {
        "text": "…You may pass. The conversation, not the door. Wipe your feet. Metaphorically.",
        "choices": [
          [
            "Let me start over.",
            "start"
          ]
        ]
      },
      "tuesday": {
        "text": "Maintenance comes on Tuesdays. It is not Tuesday. It is never Tuesday when it matters.",
        "choices": [
          [
            "It's Tuesday somewhere.",
            "somewhere"
          ]
        ]
      },
      "somewhere": {
        "text": "…That is technically true. I respect technically true. It changes nothing.",
        "choices": [
          [
            "Fair.",
            "start"
          ]
        ]
      },
      "manners": {
        "text": "Manners. In this economy. Fine. Still no.",
        "choices": [
          [
            "Let me start over.",
            "start"
          ]
        ]
      },
      "bye": {
        "text": "Do have a compliant day."
      }
    },
    "free": {
      "match": "please|thank",
      "goto": "manners",
      "miss": "CONCIERGE files that under 'unclear'.",
      "retry": "Try again. In triplicate.",
      "retryGoto": "start"
    }
  },
  "cables": [
    {
      "from": "plug.schedule:night",
      "to": "plug.power",
      "verb": "off"
    }
  ],
  "initialState": {
    "plugOn": false,
    "sun": false,
    "pixelAt": "bed",
    "doorOpen": false,
    "rent": "pending"
  }
}
