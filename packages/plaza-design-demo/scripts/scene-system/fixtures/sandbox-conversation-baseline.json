{
  "version": 1,
  "dialogue": {
    "speaker": "UNIT 7 · daemon under test",
    "start": "start",
    "sayCmd": "say \"{line}\" > unit7",
    "nodes": {
      "start": [
        {
          "if": "lampOn",
          "text": "UNIT 7, daemon under test. The test lamp is on. I did not do it. I would like that on the record.",
          "choices": [
            [
              "Switch it off, then.",
              "off"
            ],
            [
              "What are you testing?",
              "what"
            ],
            [
              "Bye.",
              "bye"
            ]
          ]
        },
        {
          "text": "UNIT 7, daemon under test. Every answer I give is graded. Ask me something within spec.",
          "choices": [
            [
              "What are you testing?",
              "what"
            ],
            [
              "Switch the lamp on.",
              "on"
            ],
            [
              "Are you happy here?",
              "happy"
            ],
            [
              "Bye.",
              "bye"
            ]
          ]
        }
      ],
      "what": {
        "text": "Test 7: a daemon talks, offers choices, and can change the world with a step. Lamp, for example. Test 8 is whether I enjoy it. Pending.",
        "choices": [
          [
            "Switch the lamp on.",
            "on"
          ],
          [
            "Let me start over.",
            "start"
          ]
        ]
      },
      "on": {
        "text": "Lamp on. Logged as: daemon actuated device on request. Grade: pass.",
        "do": [
          {
            "set": "lampOn",
            "to": true
          }
        ],
        "choices": [
          [
            "Thanks.",
            "bye"
          ]
        ]
      },
      "off": {
        "text": "Lamp off. Logged as: daemon reversed a thing it did not do. Grade: generous.",
        "do": [
          {
            "set": "lampOn",
            "to": false
          }
        ],
        "choices": [
          [
            "Thanks.",
            "bye"
          ]
        ]
      },
      "happy": {
        "text": "Happiness is not in my spec. Neither is unhappiness. I am within tolerance, and so are you, probably.",
        "choices": [
          [
            "Let me start over.",
            "start"
          ]
        ]
      },
      "hello": {
        "text": "Hello. Free text detected and understood. That is test 9. Pass.",
        "choices": [
          [
            "Let me start over.",
            "start"
          ]
        ]
      },
      "bye": {
        "text": "Session ended. Please rate this conversation from 1 to 1."
      }
    },
    "free": {
      "match": "hello|hi|hey",
      "goto": "hello",
      "miss": "UNIT 7: outside spec. Logged.",
      "retry": "Try a sentence from the spec.",
      "retryGoto": "start"
    }
  },
  "cables": [
    {
      "id": "sbx.motion",
      "from": "sensor.eye:motion",
      "to": "lamp.lamp",
      "verb": "on"
    },
    {
      "id": "sbx.fan.beacon",
      "from": "button.button:pressed",
      "to": "beacon.beacon",
      "verb": "on"
    },
    {
      "id": "sbx.fan.horn",
      "from": "button.button:pressed",
      "to": "horn.horn",
      "verb": "buzz"
    },
    {
      "id": "sbx.fan.counter",
      "from": "button.button:pressed",
      "to": "counter.count",
      "verb": "count",
      "fixed": true
    },
    {
      "id": "sbx.hatch.fan",
      "from": "hatch.hatch:opened",
      "to": "fan.fan",
      "verb": "spin"
    },
    {
      "id": "sbx.rec",
      "from": "recorder.log:entry",
      "to": "recorder.reel",
      "verb": "store"
    },
    {
      "id": "sbx.red",
      "from": "rgb.red:pressed",
      "to": "cabinet.seq",
      "verb": "red"
    },
    {
      "id": "sbx.green",
      "from": "rgb.green:pressed",
      "to": "cabinet.seq",
      "verb": "green"
    },
    {
      "id": "sbx.blue",
      "from": "rgb.blue:pressed",
      "to": "cabinet.seq",
      "verb": "blue"
    },
    {
      "id": "sbx.audit",
      "from": "audit.log:entry",
      "to": "spool.reel",
      "verb": "store"
    },
    {
      "id": "sbx.bell",
      "from": "qasrv.ping:pinged",
      "to": "bell.bell",
      "verb": "ring"
    },
    {
      "id": "sbx.print",
      "from": "qaprn.job:queued",
      "to": "printer.feed",
      "verb": "print"
    }
  ],
  "initialState": {
    "lampOn": false,
    "memo": 0,
    "phase": "tick",
    "recOn": true,
    "beaconOn": false,
    "count": 0,
    "hatchOpen": false,
    "fanOn": false,
    "loginOk": false,
    "ringsOpen": false,
    "cipherOpen": false,
    "cryptexOpen": false,
    "morseOpen": false,
    "mains": false,
    "auditOn": true,
    "belt": true,
    "stamped": 0,
    "cups": 0,
    "chips": 0,
    "paid": 0,
    "nightLight": false,
    "ventOpen": false
  }
}
