function recorder(){const commands:unknown[][]=[];let gradient=0;const values:Record<string,unknown>={globalAlpha:1,lineWidth:1,font:'',getTransform:()=>({a:1}),measureText:(v:string)=>({width:v.length*6})};const ctx=new Proxy(values,{get(t,k:string){if(k in t)return t[k];if(k==='createLinearGradient'||k==='createRadialGradient')return(...args:unknown[])=>{const id=++gradient;commands.push([k,...args,id]);return{id,addColorStop:(...xs:unknown[])=>commands.push(['stop',id,...xs])};};return(...args:unknown[])=>commands.push([k,...args]);},set(t,k:string,v){t[k]=v;commands.push(['set',k,v]);return true;}})as unknown as CanvasRenderingContext2D;return{ctx,commands};}
const priorDocument=globalThis.document;(globalThis as any).document={documentElement:{classList:{add(){},remove(){}}},createElement:()=>({width:0,height:0,getContext:()=>recorder().ctx})};
try{
 for(const reduced of[false,true]){
  const original=new Opening(reduced),privateOpening=new Opening(reduced,baseline.opening);for(const time of[0,3,7]){original.t=privateOpening.t=time;const a=recorder(),b=recorder();original.draw(a.ctx,640,360);privateOpening.draw(b.ctx,640,360);assert.equal(JSON.stringify(b.commands)===JSON.stringify(a.commands),true,'default/private title command identity');}
  const a=recorder(),b=recorder(),defaultAct=new CutscenePlay(CUTSCENES.act2,{reduced,touch:false}),privateAct=new CutscenePlay(createCutscenes(baseline.cinematics).act2,{reduced,touch:false});defaultAct.t=privateAct.t=6;defaultAct.draw(a.ctx,640,360);privateAct.draw(b.ctx,640,360);assert.equal(JSON.stringify(b.commands)===JSON.stringify(a.commands),true,'default/private cinematic commands');
 }
 const paint=recorder();new CutscenePlay(registry.act2,{reduced:false,touch:false}).draw(paint.ctx,640,360);assert(paint.commands.some(c=>c.includes('#112233')),'pending visual input reaches native paint');
 const transcript=recorder(),spoken=new CutscenePlay(registry.intro,{reduced:false,touch:false});spoken.t=4;spoken.draw(transcript.ctx,640,360);assert(transcript.commands.some(c=>c[0]==='fillText'&&c[1]==='PENDING CINEMATIC TEXT'),'pending text reaches native cards');
 function gameFixture(){const game:any=Object.create(Game.prototype),arrivals:any[]=[],noop=()=>{};Object.assign(game,{sources:{sequences:pending},keys:new Set(),hosts:new Map(),term:{close:noop},canvas:{setAttribute:noop},host:{setScene:noop},syncEnginePause:noop,syncHud:noop,k:1,x:recorder().ctx,viewW:640,viewH:360,reduced:false,touch:false,handTo:(...a:any[])=>arrivals.push(a)});Object.defineProperty(game,'placeName',{value:'Test'});return{game,arrivals};}
 for(const mode of['natural','skip','cancel','superseded','callback']){const{game,arrivals}=gameFixture();let callbacks=0;game.playCutscene('intro',['callback','cancel','superseded'].includes(mode)?()=>callbacks++:undefined);if(mode==='skip'){game.cut.step(1);assert(game.cut.skip());}if(mode==='cancel')game.endCutscene(false);else if(mode==='superseded'){game.playCutscene('act2');game.stepCutscene(60*17);}else game.stepCutscene(60*28);game.endCutscene(true);assert.equal(arrivals.length,mode==='cancel'||mode==='callback'?0:1);if(mode==='natural'||mode==='skip')assert.deepEqual(arrivals[0],['downtown','capsule']);if(mode==='superseded')assert.deepEqual(arrivals[0],[registry.act2.handoff!.scene,registry.act2.handoff!.entrance]);assert.equal(callbacks,mode==='callback'?1:0);}

 const gameText=fs.readFileSync('src/ssg/game/runtime/game.ts','utf8'),tree=ts.createSourceFile('game.ts',gameText,ts.ScriptTarget.Latest,true);let branch:ts.IfStatement|undefined;
 const visit=(n:ts.Node)=>{if(ts.isIfStatement(n)&&n.expression.getText(tree).startsWith('this.pendingCut &&'))branch=n;ts.forEachChild(n,visit);};visit(tree);assert(branch);
 const trigger=vm.runInNewContext(ts.transpileModule('(function(){'+branch!.getText(tree)+'})',{compilerOptions:{target:ts.ScriptTarget.ES2022}}).outputText);
 for(const mode of['default-return','edited','edited-skip','edited-cancel']){const{game,arrivals}=gameFixture();let inbox=0;game.here='stacks';game.pendingCut=mode==='default-return'?'act2':'intro';Object.defineProperty(game,'zh',{value:{overlayOpen:false,popupOpen:false},configurable:true});game.inbox=()=>inbox++;trigger.call(game);assert.equal(game.pendingCut,null);if(mode==='edited-skip'){game.cut.step(1);assert(game.cut.skip());}if(mode==='edited-cancel')game.endCutscene(false);else game.stepCutscene(60*28);game.endCutscene(true);assert.equal(arrivals.length,mode==='default-return'||mode==='edited-cancel'?0:1,'triggered handoff owns travel without resetting native same-scene return');if(arrivals.length)assert.deepEqual(arrivals[0],['downtown','capsule']);assert.equal(inbox,mode==='edited-cancel'?0:1,'triggered continuation runs once after handoff');}
 const same=gameFixture();same.game.here='downtown';same.game.playCutscene('intro',()=>{},'after-handoff');same.game.stepCutscene(60*28);assert.deepEqual(same.arrivals,[['downtown','capsule']],'explicit same-scene entrance still repositions');
}finally{globalThis.document=priorDocument;}

