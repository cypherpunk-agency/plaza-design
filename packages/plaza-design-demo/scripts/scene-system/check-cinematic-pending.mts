const renamed=structuredClone(catalogue);renamed.scenes[0].scene.exits![0].id='new-landing';renamed.scenes[0].scene.manifest!.exits!['new-landing']=renamed.scenes[0].scene.manifest!.exits!['landing'];delete renamed.scenes[0].scene.manifest!.exits!['landing'];const badAnchor=values(model.list());badAnchor.set('authored-scenes',renamed);assert.throws(()=>validateSourceDocuments(badAnchor),/handoff/i);const redirected=structuredClone(changed);redirected.sequences.find((s:any)=>s.id==='intro').handoff.entrance='new-landing';badAnchor.set('sequence-cinematics',redirected);validateSourceDocuments(badAnchor);
store.save(grouped.map(d=>({...d,revision:store.read(d.id).revision})));const savedNew=store.list();assert.throws(()=>store.save([{id:'authored-scenes',revision:store.read('authored-scenes').revision,value:{version:1,scenes:[]}}]));assert.deepEqual(store.list(),savedNew);
