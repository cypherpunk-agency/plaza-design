/** Compare effective paint commands while permitting equivalent independently scoped native kernels. */
export function canonicalPaint(commands:unknown[][]){
 type Matrix=number[];type State=Record<string,unknown>&{matrix:Matrix};let state:State={matrix:[1,0,0,1,0,0],globalAlpha:1,lineWidth:1,fillStyle:'#000000',strokeStyle:'#000000',font:'10px sans-serif',textAlign:'start',textBaseline:'alphabetic'},path:unknown[][]=[];const stack:State[]=[],gradients=new Map<number,unknown>(),paints:unknown[][]=[];
 const multiply=(b:number[])=>{const[a,c,d,e,f,g]=state.matrix;state.matrix=[a*b[0]+d*b[1],c*b[0]+e*b[1],a*b[2]+d*b[3],c*b[2]+e*b[3],a*b[4]+d*b[5]+f,c*b[4]+e*b[5]+g];};
 const style=(key:string)=>{const v=state[key];return typeof v==='object'&&v!==null&&'id'in v?gradients.get(Number(v.id)):v;};
 for(const cmd of commands){const [kind,...args]=cmd as [string,...any[]];if(kind==='set'){state[args[0]]=args[1];continue;}if(kind==='save'){stack.push({...state,matrix:[...state.matrix]});continue;}if(kind==='restore'){state=stack.pop()!;continue;}if(kind==='translate'){multiply([1,0,0,1,...args]);continue;}if(kind==='scale'){multiply([args[0],0,0,args[1],0,0]);continue;}if(kind==='rotate'){const cos=Math.cos(args[0]),sin=Math.sin(args[0]);multiply([cos,sin,-sin,cos,0,0]);continue;}if(kind==='setTransform'){state.matrix=[...args];continue;}if(kind==='resetTransform'){state.matrix=[1,0,0,1,0,0];continue;}if(kind.startsWith('create')){const id=args.pop();gradients.set(id,{kind,args,matrix:[...state.matrix],stops:[]});continue;}if(kind==='stop'){(gradients.get(args[0])as any).stops.push(args.slice(1));continue;}if(kind==='beginPath'){path=[];continue;}if(['moveTo','lineTo','rect','arc','ellipse','quadraticCurveTo','bezierCurveTo','closePath'].includes(kind)){path.push([kind,...args,[...state.matrix]]);continue;}if(kind==='clip'){state.clip=path.map(p=>[...p]);continue;}if(kind==='setLineDash'){state.lineDash=args[0];continue;}
 if(['fillRect','strokeRect','fill','stroke','fillText','strokeText','drawImage','clearRect'].includes(kind)){const stroke=kind.startsWith('stroke'),text=kind.endsWith('Text');paints.push([kind,...args,...(['fill','stroke'].includes(kind)?[path.map(p=>[...p])]:[]),{matrix:[...state.matrix],alpha:state.globalAlpha,clip:state.clip,...(kind==='drawImage'?{}:{style:style(stroke?'strokeStyle':'fillStyle')}),...(stroke?{width:state.lineWidth,dash:state.lineDash,lineCap:state.lineCap,lineJoin:state.lineJoin}:{}),...(text?{font:state.font,align:state.textAlign,baseline:state.textBaseline}:{}),shadowColor:state.shadowColor,shadowBlur:state.shadowBlur,shadowOffsetX:state.shadowOffsetX,shadowOffsetY:state.shadowOffsetY}]);}
 }
 return paints;
}
