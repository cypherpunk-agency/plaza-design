export function capsuleClock<T>(run:(advance:(dt:number)=>void)=>T):T{let now=10000,serial=0;const jobs=new Map<number,{at:number;run:()=>void}>(),old={setTimeout:globalThis.setTimeout,clearTimeout:globalThis.clearTimeout},clock=Object.getOwnPropertyDescriptor(performance,'now');Object.defineProperty(performance,'now',{configurable:true,value:()=>now});(globalThis as any).setTimeout=(run:()=>void,ms:number)=>{const id=++serial;jobs.set(id,{at:now+ms,run});return id;};(globalThis as any).clearTimeout=(id:number)=>jobs.delete(id);try{return run(dt=>{now+=dt;for(let n=0;n<100;n++){const due=[...jobs].filter(([,job])=>job.at<=now);if(!due.length)return;for(const[id,job]of due)if(jobs.delete(id))job.run();}assert.fail('unbounded timers');});}finally{globalThis.setTimeout=old.setTimeout;globalThis.clearTimeout=old.clearTimeout;if(clock)Object.defineProperty(performance,'now',clock);}}
export function routerFixture(Model:any,scene:any,advance:(dt:number)=>void,shared=true){const log:any[]=[],notifications:string[]=[],receipts:any[]=[],m=new Model({say:(line:any,from:any,receipt:any)=>{log.push(['say',structuredClone(line),from]);notifications.push('say');if(receipt)receipts.push(receipt);},changed(){notifications.push('changed');},open(){}},scene.data,scene.rules);let commits=0,state:any={flags:{},items:{},tokens:0,values:{capsule:m.state}};const session=shared?new GameplaySession(scene.gameplay,nativeGameplayPort(scene.gameplay,{read:()=>state,write:s=>{mergeValues(state.values,s.values??{});state={...s,values:state.values};}},()=>m),()=>{commits++;m.changed();}):undefined;if(session)attachNativeGameplay(m,session);const emit=m.emit.bind(m),goal=m.goal.bind(m);m.emit=(id:string)=>{log.push(['emit',id]);emit(id);};m.goal=(id:string)=>{if(!m.goals.has(id))log.push(['goal',id]);goal(id);};return{m,session,log,notifications,receipts,commits:()=>commits,advance,step(dt:number,live=true){m.tick(dt,live);advance(dt);},effect(){(scene.rules.effects['router.boot'])((m as any).world((m as any).ctx('router')),{dev:'plug',noun:'power',verb:'on',bySignal:false});},snapshot(){const scratch={...m.scratch};if(shared){if('native.edge.capsule.doorOpened'in scratch)scratch.doorWas=scratch['native.edge.capsule.doorOpened'];else delete scratch.doorWas;delete scratch['native.edge.capsule.doorOpened'];delete scratch.routerUpAtTickStart;}return{scene:m.snapshot(),scratch,log:structuredClone(log),timers:(m as any).time.inspect()};},close(){session?.dispose();m.reset();m.setPaused(true);}};}
