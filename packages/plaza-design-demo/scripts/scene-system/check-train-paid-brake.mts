const missing=new GameplaySession(scene.gameplay!,{read:()=>({flags:{},items:{'maglev.pass':1},tokens:0,values:{train:{pulls:0}}}),write(){throw Error('paid probe must not write');}});for(const id of['train.paidStanding','train.paidAlready','train.paidReady'])assert.equal(missing.query(id),false);assert.equal(matches({not:{compare:{left:{query:'train.missing'},op:'eq',right:{literal:true}}}},{flags:{},items:{},tokens:0},{definition:scene.gameplay!}),false);missing.dispose();
const detachedMetro=createLineSystem(),detached=new SceneModel({say:l=>assert.match(l[1],/verification unavailable/),changed(){},open(){},carry:()=>1},scene.data!,createTrainRules(detachedMetro));detached.setPaused(true);Object.assign(detachedMetro.ride,{phase:'running'});const before={...detachedMetro.ride};detached.act('train','brake','pull',true);assert.deepEqual(detachedMetro.ride,before);console.log(`Train paid brake PASS: ${histories} immutable actual-LineSystem histories including all four physical outcomes, siding boundaries, repeated manual/signal actions, lock/watchdog guards, pure eligibility, exact reply/change/transport order, causal receipt ownership and missing-context fail-closed behavior.`);
