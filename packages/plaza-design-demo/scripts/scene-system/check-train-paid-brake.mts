function fixture(shared:boolean,phase:string,halt:any,offset:number,signal:boolean,block:string){const physical=createLineSystem(),records:any[]=[],outcomes:string[]=[],receipts:any[]=[],metro={...physical,brakeRide:()=>{records.push(['physical']);const value=physical.brakeRide();outcomes.push(value);return value;}},data=structuredClone(shared?scene.data!:oldData);let rules:any;if(shared)rules=createTrainRules(metro);else{const exports:any={};vm.runInNewContext(javascript,{exports,...metro,...city});rules=exports.TRAIN_RULES;}const m=new SceneModel({say:(line,from,receipt)=>{records.push(['say',line,from,{scope:receipt!.scope,source:receipt!.source,tone:receipt!.tone}]);receipts.push(receipt);},changed:()=>records.push(['changed']),open(){},carry:()=>1},data,rules);m.setPaused(true);m.now=()=>1000;m.wall=()=>1000;Object.assign(physical.ride,{at:1,to:2,phase,halt,span:physical.SEG,frames:physical.RUN,timer:physical.RUN/2,v:3,open:.2,doors:false});const distance=physical.rideSpeed()**2/(2*physical.BRAKE.decel),siding=physical.sidingAlong()!;physical.ride.d=siding-distance+offset;physical.ride.pos=physical.SEG+physical.ride.d;let root:any={flags:{},items:{'maglev.pass':1},tokens:0},session:GameplaySession|undefined;if(shared){session=new GameplaySession(scene.gameplay!,fixtureGameplayPort(scene.gameplay!,{read:()=>root,write:s=>{root=s;}},()=>m));attachNativeGameplay(m,session);}if(block==='lock')m.locks.set('train',2000);if(block==='watchdog')m.frozen=()=>true;
 const capture=()=>JSON.parse(JSON.stringify({state:m.state,scratch:m.scratch,goals:[...m.goals],ride:physical.ride,records,outcomes}));try{const before=capture(),eligibility=m.eligibility('train','brake','pull',signal);assert.deepEqual(capture(),before,'eligibility cannot invoke brakeRide or mutate transport');if(block==='none')assert(eligibility.ok);const expected=phase==='braking'?'braking':phase==='running'||phase==='resuming'?'ready':'standing';if(shared){assert.equal(m.value('trainStanding'),expected==='standing');assert.equal(m.value('trainBraking'),expected==='braking');assert.equal(m.value('trainCanBrake'),expected==='ready');}const frames:any[]=[];for(let n=0;n<2;n++){const count=outcomes.length;m.act('train','brake','pull',signal);const blocked=block==='watchdog'||block==='lock'&&!signal;assert.equal(outcomes.length-count,blocked?0:1,'exactly one physical call per accepted action');frames.push(capture());}assert.equal(receipts.length,2);assert.notEqual(receipts[0].id,receipts[1].id);assert.notEqual(receipts[0].cueId,receipts[1].cueId,'same-text repeated actions retain distinct causal cues');return{frames,outcomes};}finally{session?.dispose();m.reset();m.setPaused(true);}}
let histories=0;const outcomes=new Set<string>(),sample=createLineSystem();for(const phase of['dwell','closing','opening','running','braking','halted','resuming'])for(const halt of[null,'track','siding'])for(const offset of[-sample.BRAKE.window-.01,-sample.BRAKE.window,0,sample.BRAKE.window,sample.BRAKE.window+.01])for(const signal of[false,true])for(const block of['none','lock','watchdog']){const expected=fixture(false,phase,halt,offset,signal,block),actual=fixture(true,phase,halt,offset,signal,block);assert.deepEqual(actual.frames,expected.frames,JSON.stringify({phase,halt,offset,signal,block}));actual.outcomes.forEach(value=>outcomes.add(value));histories++;}assert.deepEqual([...outcomes].sort(),['braking','siding','standing','track']);
