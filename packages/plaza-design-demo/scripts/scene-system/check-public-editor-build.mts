/** Focused static packaging check. Never starts a write service or edits game source. */
import assert from 'node:assert/strict';import fs from 'node:fs';import path from 'node:path';import {createHash}from'node:crypto';
import {buildPublicEditor,publicEditorSnapshot}from'./build-public-editor.mts';
import {sourceDocuments}from'../../src/ssg/game/authoring/source-documents';
const game=path.resolve('src/ssg/game'),base=path.resolve('../../.scene-system/public-editor-build-check');fs.mkdirSync(base,{recursive:true});const output=fs.mkdtempSync(path.join(base,'run-')),homepage='<html>existing homepage is unchanged</html>\n';fs.writeFileSync(path.join(output,'index.html'),homepage);
const sha=(value:string|Uint8Array)=>createHash('sha256').update(value).digest('hex'),before=sourceDocuments.map(d=>sha(fs.readFileSync(path.join(game,d.file)))),history=fs.existsSync(path.join(game,'.authoring-history'));
const snapshot=publicEditorSnapshot();assert.equal(snapshot.documents.length,26);assert.equal(Object.keys(snapshot.sources).length,71);assert.deepEqual(snapshot.documents.map(d=>d.id),sourceDocuments.map(d=>d.id));for(const document of snapshot.documents){assert.match(document.revision,/^[0-9a-f]{64}$/);assert.deepEqual(Object.keys(document).sort(),['id','kind','revision','value']);}for(const[file,text]of Object.entries(snapshot.sources))assert.equal(text,fs.readFileSync(path.join(game,file),'utf8'));
const result=await buildPublicEditor(output),html=fs.readFileSync(path.join(result.directory,'index.html'),'utf8'),manifest=JSON.parse(fs.readFileSync(path.join(result.directory,'build-manifest.json'),'utf8'));
assert.equal(result.documentCount,26);assert.equal(result.sourceCount,71);assert.match(result.application,/^app-[A-Z0-9]+\.js$/i);assert.equal(manifest.applicationSha256,sha(fs.readFileSync(path.join(result.directory,result.application))));assert.equal(html.includes('data-editor-mode="public"'),true);assert.equal(html.includes('src="./'+result.application+'"'),true);assert.equal(html.includes("connect-src 'self'"),true);assert.equal(html.includes('Download edits'),true);assert.equal(html.includes('does not write repository files'),true);assert.equal(/https?:\/\//.test(html),false);for(const weight of[400,500,600,700])assert.equal(html.includes('/fonts/ibm-plex-mono-latin-'+weight+'-normal.woff2'),true);
assert.deepEqual(JSON.parse(fs.readFileSync(path.join(result.directory,'documents.json'),'utf8')),snapshot.documents);assert.deepEqual(JSON.parse(fs.readFileSync(path.join(result.directory,'sources.json'),'utf8')),snapshot.sources);assert.equal(fs.readFileSync(path.join(output,'index.html'),'utf8'),homepage);assert.deepEqual(sourceDocuments.map(d=>sha(fs.readFileSync(path.join(game,d.file)))),before);assert.equal(fs.existsSync(path.join(game,'.authoring-history')),history);
console.log(JSON.stringify({status:'PASS',documents:26,sources:71,hashedApplication:result.application,homepageUntouched:true,sourceDocumentsUnchanged:true,noJournalCreation:true,output}));
