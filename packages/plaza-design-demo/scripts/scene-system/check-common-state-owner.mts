import {Menu} from '../../src/ssg/game/ui/menu';
import {readSlot} from '../../src/ssg/game/runtime/slots';
import {Game} from '../../src/ssg/game/runtime/game';
import {newSave,loadSave} from '../../src/ssg/game/runtime/save';
import type {GameplayDefinition,GameplayState} from '../../src/ssg/game/engine/gameplay/types';
const definition:GameplayDefinition={version:1,flags:[],items:[],events:['advanced'],conversations:{},reactions:[{event:'advanced',command:'react'}],commands:{advance:{sources:['interaction'],actions:[{state:'review.count',add:1},{state:'review.session',add:1},{state:'review.interaction',add:1},{emit:'advanced'}]},react:{sources:['system'],when:{state:'review.interaction',is:1},actions:[{state:'review.count',add:1}]},refuse:{sources:['interaction'],actions:[{state:'review.count',add:1},{state:'review.held',add:1}]},interaction:{sources:['interaction'],when:{state:'review.interaction',is:0},actions:[]}},state:{'review.count':{owner:'review',lifetime:'save',type:'number',default:0},'review.held':{owner:'review',lifetime:'save',type:'string',nullable:true,default:null},'review.session':{owner:'review',lifetime:'session',type:'number',default:0},'review.interaction':{owner:'review',lifetime:'interaction',type:'number',default:0}},native:{verbs:[],events:{},goals:{}}};
// The deliberately refused numeric operation is well-formed only for a nullable number.
definition.state!['review.held']={owner:'review',lifetime:'save',type:'number',nullable:true,default:null};
const raw=emptyData('review','Review'),data=projectSceneState(raw,definition),save=newSave();save.gameplay={review:{count:3,held:null,session:8,interaction:9}};const block=save.gameplay.review;
const model=new SceneModel({say(){},open(){},changed(){}},data,{effects:{},settle:s=>{s.count=0;}},undefined,undefined,undefined,block);model.setPaused(true);
assert.equal(model.state,block);assert.equal(model.get('count'),3);let state:GameplayState={flags:{},items:{},tokens:0,values:save.gameplay};
const port={read:()=>state,write:(next:GameplayState)=>{mergeValues(state.values!,next.values!);state={...next,values:state.values};}};
const session=new GameplaySession(definition,nativeGameplayPort(definition,port,()=>model));attachNativeGameplay(model,session);
assert.equal(session.state().values!.review.session,0,'new session initializes its common block once');assert.equal(model.get('session'),0);assert.equal(session.state().values!.review.interaction,0);assert(session.eligibility('interaction','interaction').ok);assert.equal(model.get('count'),3);
assert(session.dispatch('advance','interaction').ok);assert.equal(model.state,block);assert.equal(model.get('count'),5,'shared reaction and native model see one committed block');assert.equal(model.get('session'),1);assert.equal(session.state().values!.review.interaction,0,'read resets interaction');assert(session.eligibility('interaction','interaction').ok,'eligibility resets interaction');
model.set('count',7);assert.equal(stateValue(session.state().values,'review.count'),7,'native write immediately visible to commands');const before=cloneState(state);assert.deepEqual(session.dispatch('refuse','interaction'),{ok:false,reason:'resources'});assert.deepEqual(state,before,'atomic failure leaves same common block');assert.equal(model.state,block);
const snapshot=model.snapshot();assert.equal(snapshot.state.count,0);assert.equal(model.get('count'),7,'settling affects checkpoint copy only');model.restore({...snapshot,state:{...snapshot.state,count:4}});assert.equal(model.state,block,'restore retains block');assert.equal(model.get('count'),0,'restore settles restored values');model.reset();model.setPaused(true);assert.equal(model.state,block,'reset retains block');assert.equal(model.get('count'),0);session.dispose();
const freshSession=new GameplaySession(definition,nativeGameplayPort(definition,port,()=>model));assert.equal(freshSession.state().values!.review.session,0);freshSession.dispose();
// Execute real Game serialization and current-format reload; no scene scalar snapshot is stored.
const previous=globalThis.localStorage,memory=new Map<string,string>();(globalThis as any).localStorage={getItem:(k:string)=>memory.get(k)??null,setItem:(k:string,v:string)=>memory.set(k,v),removeItem:(k:string)=>memory.delete(k)};
try{const game:any=Object.create(Game.prototype);game.save=save;game.content={review:{id:'review',gameplay:definition}};game.sceneDefinition=(id:string)=>id==='review'?game.content.review:{};game.hosts=new Map([['review',{model}]]);model.set('count',6);model.set('session',2);model.set('interaction',2);save.scenes.review={goals:[],links:[],logic:[]};game.persistSave();const loaded=loadSave();assert.equal(model.get('count'),6);assert.equal(save.gameplay!.review.count,6);assert.equal(loaded.gameplay!.review.count,0,'stored root uses settled scalar copy');assert(!('session'in loaded.gameplay!.review));assert(!('interaction'in loaded.gameplay!.review));assert(!('state'in loaded.scenes.review!),'SceneSave contains engine metadata only');const menu:any=Object.create(Menu.prototype);menu.hooks={scene:()=>({id:'review',name:'Review'}),save:()=>save,saveSnapshot:()=>game.prepareSave(save)};menu.slots=()=>{};menu.store(1);assert.deepEqual(readSlot(1)!.save.gameplay,loaded.gameplay,'actual Menu slot write uses same settled lifetime-filtered snapshot');const loadedBlock=loaded.gameplay!.review;const restored=new SceneModel({say(){},open(){},changed(){}},data,{effects:{}},undefined,undefined,undefined,loadedBlock);restored.restore({...loaded.scenes.review!,state:{...loadedBlock}});assert.equal(restored.state,loadedBlock);assert.equal(restored.get('held'),null);assert.equal(restored.get('count'),0);restored.setPaused(true);}finally{globalThis.localStorage=previous;}
const host:any=Object.create(SceneHost.prototype);let writes=0;host.model=model;host.snapshot=()=>({goals:[],links:[],logic:[]});host.store={store:(snapshot:any)=>{assert(!('state'in snapshot));writes++;}};host.saved=JSON.stringify({...host.snapshot(),state:model.state});model.set('count',8);host.persist();assert.equal(writes,1,'scalar-only native changes still trigger Host persistence');host.persist();assert.equal(writes,1,'unchanged common block does not resave');
const cloned=cloneValues(save.gameplay);cloned.review.count=999;assert.notEqual(save.gameplay!.review.count,999);console.log('Common scalar owner PASS: native/shared writes, stable model identity, atomic failure/reactions, all lifetimes, copy-only settling, real Game persistence and current save reload without duplicate scene scalars.');
