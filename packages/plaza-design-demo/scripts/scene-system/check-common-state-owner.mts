import assert from 'node:assert/strict';
import {GameplaySession,cloneState} from '../../src/ssg/game/engine/gameplay/session';
import {mergeValues,cloneValues,stateValue} from '../../src/ssg/game/engine/gameplay/state';
import {nativeGameplayPort,attachNativeGameplay} from '../../src/ssg/game/engine/gameplay/native-bindings';
import {projectSceneState} from '../../src/ssg/game/engine/gameplay/scene-state';
import {SceneModel} from '../../src/ssg/game/engine/model';
import {emptyData} from '../../src/ssg/game/engine/empty-data';
