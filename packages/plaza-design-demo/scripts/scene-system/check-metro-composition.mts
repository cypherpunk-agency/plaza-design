function recording(){const ops:any[]=[],stack:any[]=[],init={globalAlpha:1,fillStyle:'#000',strokeStyle:'#000',lineWidth:1,font:'10px sans-serif',textAlign:'start',textBaseline:'alphabetic',shadowBlur:0,shadowColor:'rgba(0,0,0,0)',matrix:[1,0,0,1,0,0],clips:[]};let state:any=structuredClone(init),path:any[]=[];
 const multiply=(b:number[])=>{const a=state.matrix;state.matrix=[a[0]*b[0]+a[2]*b[1],a[1]*b[0]+a[3]*b[1],a[0]*b[2]+a[2]*b[3],a[1]*b[2]+a[3]*b[3],a[0]*b[4]+a[2]*b[5]+a[4],a[1]*b[4]+a[3]*b[5]+a[5]];};
 const ctx=new Proxy({}, {get(_target,key:string){if(key in state)return state[key];if(key==='measureText')return(s:string)=>({width:s.length*4.25});if(key.startsWith('create')&&key.endsWith('Gradient'))return(...args:unknown[])=>{const g={type:key,args,stops:[] as unknown[]};return{...g,addColorStop:(...q:unknown[])=>g.stops.push(q)};};return(...args:any[])=>{if(key==='save'){stack.push(structuredClone(state));return;}if(key==='restore'){state=stack.pop();if(!state)throw new Error('Unbalanced restore');return;}if(key==='translate'){multiply([1,0,0,1,args[0],args[1]]);return;}if(key==='scale'){multiply([args[0],0,0,args[1],0,0]);return;}if(key==='rotate'){const c=Math.cos(args[0]),s=Math.sin(args[0]);multiply([c,s,-s,c,0,0]);return;}if(key==='beginPath'){path=[];return;}if(['moveTo','lineTo','arc','ellipse','rect','closePath','quadraticCurveTo','bezierCurveTo'].includes(key)){path.push([key,...args]);return;}if(key==='clip'){state.clips.push(plain(path));return;}const keys=['globalAlpha','matrix','clips',...(key==='drawImage'?[]:key.startsWith('stroke')?['strokeStyle','lineWidth']:['fillStyle']),...(key.includes('Text')?['font','textAlign','textBaseline']:[]),'shadowBlur','shadowColor'];const style=Object.fromEntries(keys.map(k=>[k,state[k]]));if(key==='drawImage')args=args.slice(1);ops.push([key,args,plain(style),['fill','stroke'].includes(key)?plain(path):null]);};},set(_target,key:string,value){state[key]=value;return true;}}) as CanvasRenderingContext2D;return{ctx,ops};}
