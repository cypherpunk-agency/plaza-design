function same(a:any[],b:any[],label:string){if(JSON.stringify(a)===JSON.stringify(b))return;let first=0;while(JSON.stringify(a[first])===JSON.stringify(b[first]))first++;throw new Error(label+' first command '+first+'/'+a.length+'/'+b.length+': '+JSON.stringify(a[first])+' != '+JSON.stringify(b[first]));}

