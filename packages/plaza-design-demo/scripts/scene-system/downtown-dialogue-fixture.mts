/** Test helpers run the actual common Game state path; production has no Downtown adapter. */
import type {Save} from '../../src/ssg/game/runtime/save';import type {GameplayDefinition} from '../../src/ssg/game/engine/gameplay/types';import {currentStateGame} from './common-state-fixture.mts';import {ConversationSession} from '../../src/ssg/game/engine/gameplay/conversation';import {DOWNTOWN_DIALOGUE_GAMEPLAY} from '../../src/ssg/game/scenes/downtown/dialogue-state';
export interface Talk {pages:string[];spend?:boolean;ask?:string}
export function fixerPrice(save:Save,definition:GameplayDefinition=DOWNTOWN_DIALOGUE_GAMEPLAY):number{const f=currentStateGame(save,definition);try{return f.session.quote('downtown.fixer.hint').quote;}finally{f.session.dispose();}}
export function fixerTalk(save:Save,definition:GameplayDefinition=DOWNTOWN_DIALOGUE_GAMEPLAY):Talk{const f=currentStateGame(save,definition);try{const talk=new ConversationSession(f.session,'talk.downtown.fixer'),frame=talk.frame();talk.close();return{pages:frame.pages,...(frame.completion?{ask:frame.completion.terminalPrefill}:{}),...(f.session.events().some((e:any)=>e.id==='downtown.fixer.hint.paid')?{spend:true}:{})};}finally{f.session.dispose();}}
export function npcTalk(id:string,save:Save,definition:GameplayDefinition=DOWNTOWN_DIALOGUE_GAMEPLAY):string[]{const f=currentStateGame(save,definition);try{const talk=new ConversationSession(f.session,'talk.downtown.'+(Object.prototype.hasOwnProperty.call(definition.conversations,'talk.downtown.'+id)?id:'unknown')),frame=talk.frame();talk.close();return frame.pages;}finally{f.session.dispose();}}
