import assert from 'node:assert/strict';
import {GameplaySession,cloneState} from '../../src/ssg/game/engine/gameplay/session';
import {matches,validateGameplay} from '../../src/ssg/game/engine/gameplay/validation';
import {validateGameplayRewards} from '../../src/ssg/game/engine/gameplay/rewards';
import type {GameplayDefinition,GameplayState} from '../../src/ssg/game/engine/gameplay/types';
const definition:GameplayDefinition={version:1,flags:['seen'],items:[],events:['awarded'],state:{'test.node':{owner:'test',lifetime:'save',type:'enum',options:['NODE.A','NODE.B'],default:'NODE.A'}},queries:{node:{kind:'label',key:'node.box'},selected:{kind:'select',cases:[{when:{flag:'seen'},value:{literal:'NODE.B'}},{value:{query:'node'}}]}},commands:{award:{sources:['interaction'],when:{not:{player:{collection:'controlled',contains:{query:'node'}}}},actions:[{grant:{controlled:{query:'node'}}},{emit:'awarded'}]},react:{sources:['system'],when:{player:{collection:'controlled',contains:{query:'node'}}},actions:[{flag:'seen',value:true}]},draft:{sources:['interaction'],actions:[{state:'test.node',set:'NODE.B'},{grant:{controlled:{state:'test.node'}}}]},rollback:{sources:['interaction'],actions:[{grant:{controlled:{query:'node'}}},{tokens:-1}]}},reactions:[{event:'awarded',command:'react'}],conversations:{}};
const vocabulary={keyring:new Set(['key.A']),controlled:new Set(['NODE.A','NODE.B'])},texts={'node.box':'NODE.A'};
validateGameplay(definition);validateGameplayRewards(definition,vocabulary,texts);
let state:GameplayState={flags:{},items:{},tokens:0,player:{handle:'KEEP',jump:false,keyring:['key.A'],controlled:[]}},context:any={labels:texts};const grants:any[]=[],events:any[]=[],session=new GameplaySession(definition,{read:()=>state,write:value=>{state=value;}},()=>{},[],vocabulary);session.readContext=()=>context;session.observeGrants(g=>grants.push(g));session.observe(e=>events.push(e));const original=cloneState(state);assert(session.eligibility('award','interaction').ok);assert.deepEqual(state,original);assert.deepEqual(session.dispatch('rollback','interaction'),{ok:false,reason:'resources'});assert.deepEqual(state,original);assert.equal(grants.length,0);assert(session.dispatch('award','interaction').ok);assert.deepEqual(state.player!.controlled,['NODE.A']);assert.equal(state.flags.seen,true,'reaction sees committed-in-draft controlled target');assert(!session.eligibility('award','interaction').ok);assert(session.dispatch('draft','interaction').ok);assert.deepEqual(state.player!.controlled,['NODE.A','NODE.B']);assert.equal(grants.length,2);assert.equal(events.length,1);
for(const labels of[undefined,{'node.box':3},{'node.box':null},{'node.box':'NOT.CANONICAL'}]){context={labels};const before=cloneState(state),history=session.events(),count=grants.length;assert.deepEqual(session.dispatch('rollback','interaction'),{ok:false,reason:'resources'});assert.deepEqual(state,before);assert.deepEqual(session.events(),history);assert.equal(grants.length,count);if(typeof labels?.['node.box']!=='string'){assert.equal(session.matches({not:{player:{collection:'controlled',contains:{query:'node'}}}}),false);assert.equal(session.matches({not:{player:{collection:'keyring',contains:{query:'node'}}}}),false);}}
context={labels:texts};assert(session.matches({player:{collection:'keyring',contains:{literal:'key.A'}}}));assert.equal(matches({not:{player:{collection:'controlled',contains:{query:'node'}}}},{flags:{},items:{},tokens:0},{definition,labels:texts}),false);
for(const value of[{'node.box':'NOT.CANONICAL'},{}, {'node.box':false}])assert.throws(()=>validateGameplayRewards(definition,vocabulary,value as any));assert.throws(()=>validateGameplayRewards(definition,vocabulary),/associated scene/);
const finite=structuredClone(definition);finite.commands.award.actions=[{grant:{controlled:{query:'selected'}}}];assert.doesNotThrow(()=>validateGameplayRewards(finite,vocabulary,texts));finite.queries!.selected={kind:'select',cases:[{when:{flag:'seen'},value:{literal:'NOT.CANONICAL'}},{value:{query:'node'}}]};assert.throws(()=>validateGameplayRewards(finite,vocabulary,texts),/Unknown controlled/);
const unbounded=structuredClone(definition);unbounded.state!['test.node']={owner:'test',lifetime:'save',type:'string',default:'NODE.A'};unbounded.commands.award.actions=[{grant:{controlled:{state:'test.node'}}}];validateGameplay(unbounded);assert.throws(()=>validateGameplayRewards(unbounded,vocabulary,texts),/finite/);
for(const mutate of[(d:any)=>delete d.queries.node,(d:any)=>d.queries.node={kind:'count',conditions:[{flag:'seen'}]},(d:any)=>d.commands.award.actions=[{grant:{controlled:{literal:123}}}]]){const bad=structuredClone(definition);mutate(bad);assert.throws(()=>validateGameplay(bad));}
session.dispose();console.log('Controlled scalar targets PASS: draft copies, label freshness/reactions, canonical metadata, missing/nonstring unknown-under-not, atomic refusal/history, finite source targets and missing/unassociated source rejection.');
