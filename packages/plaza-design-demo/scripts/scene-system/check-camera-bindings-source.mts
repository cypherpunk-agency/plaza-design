const ids=['yard-devices','yard-gameplay','downtown-devices','downtown-gameplay'],dir=fs.mkdtempSync(path.resolve('../../.scene-system/camera-bindings-source-')),selected=sourceDocuments.filter(d=>ids.includes(d.id)).map(d=>({...d,validateContext:(v:unknown,all:ReadonlyMap<string,unknown>)=>d.validateContext?d.validateContext(v,new Map([...base,...all])):d.validate(v)})),original:Record<string,string>={};
