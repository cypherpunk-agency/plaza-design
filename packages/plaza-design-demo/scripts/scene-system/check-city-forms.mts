class Element {children:Element[]=[];attributes:Record<string,string>={};value='';checked=false;textContent='';onchange?:()=>void;onclick?:()=>void;append(...nodes:Element[]){this.children.push(...nodes);}replaceChildren(...nodes:Element[]){this.children=[...nodes];}setAttribute(key:string,value:string){this.attributes[key]=value;}}
Object.defineProperty(globalThis,'document',{configurable:true,value:{createElement:()=>new Element()}});
const documents=sourceDocuments.map(d=>({id:d.id,kind:d.kind,value:JSON.parse(fs.readFileSync('src/ssg/game/'+d.file,'utf8')),revision:'fixture'})),values=new Map(documents.map(d=>[d.id,d.value]));let source=validatePendingCity(city,values),line=validateMetroSource(metro),host=new Element();const context:any={documents,authoring:{get:(id:string)=>({value:id==='city-source'?source:id==='metro-source'?line:values.get(id)}),edit:(id:string,_label:string,v:unknown)=>{if(id==='city-source')source=validatePendingCity(v,values);else line=validateMetroSource(v);}}},handle=mountCityAuthoring(host as unknown as HTMLElement,context);
const all=(n:Element):Element[]=>[n,...n.children.flatMap(all)],field=(name:string)=>{const n=all(host).find(n=>n.attributes['aria-label']===name);assert(n,'field '+name);return n;},change=(name:string,value:string|boolean)=>{const before=JSON.stringify(source),n=field(name);if(typeof value==='boolean')n.checked=value;else n.value=value;n.onchange!();if(JSON.stringify(source)!==before)handle.refresh!();},click=(name:string)=>{const n=all(host).find(n=>n.textContent===name);assert(n,'button '+name);n.onclick!();handle.refresh!();};
