change('City MAP_W','1400');assert.equal(source.MAP_W,1400);const frameWidth=source.DISTRICT_MAP.downtown.frame[2]+10;change('City DISTRICT_MAP downtown frame 2',String(frameWidth));assert.equal(source.DISTRICT_MAP.downtown.frame[2],frameWidth);const stationX=source.STATION_MAP.downtown[0]+1;change('City STATION_MAP downtown 0',String(stationX));assert.equal(source.STATION_MAP.downtown[0],stationX);const padY=source.PAD_MAP.downtown[1]+1;change('City PAD_MAP downtown 1',String(padY));assert.equal(source.PAD_MAP.downtown[1],padY);const oldLoop=source.LOOP_MAP.length;click('Add City LOOP_MAP');assert.equal(source.LOOP_MAP.length,oldLoop+1);const oldLinks=source.LINKS.length;click('Add City LINKS');assert.equal(source.LINKS.length,oldLinks+1);const oldPlans=source.LINES_PLANNED.length;click('Add City LINES_PLANNED');assert.equal(source.LINES_PLANNED.length,oldPlans+1);
change('New district ID','review-district');click('Add district');assert(source.DISTRICTS.some(d=>d.id==='review-district'));change('City DISTRICT_REVEAL review-district near downtown',true);assert(source.DISTRICT_REVEAL['review-district' as keyof typeof source.DISTRICT_REVEAL].near.includes('downtown'));click('Remove district review-district');assert(!source.DISTRICTS.some(d=>d.id==='review-district'));
const movable=source.PLACES.find(p=>p.scenes.length>1)!;assert(movable);const scene=movable.scenes.at(-1)!;change('New place ID','review-place');change('New place scene',scene);click('Add place');assert.equal(source.PLACES.find(p=>p.id==='review-place')!.entrance,scene);assert(!source.PLACES.find(p=>p.id===movable.id)!.scenes.includes(scene));change('Place review-place map point',true);assert.equal(source.PLACE_MAP['review-place' as keyof typeof source.PLACE_MAP]!.length,2);change('Place review-place reveal rule',true);change('City PLACE_IN_VIEW review-place downtown',true);assert.deepEqual(source.PLACE_IN_VIEW['review-place' as keyof typeof source.PLACE_IN_VIEW],['downtown']);change('Merge review-place into',movable.id);click('Merge place review-place');assert(!source.PLACES.some(p=>p.id==='review-place'));assert(source.PLACES.find(p=>p.id===movable.id)!.scenes.includes(scene));const before=structuredClone(source);change('Transport boarding entrance','missing');assert.deepEqual(source,before,'invalid route field rejected atomically');handle();console.log('City typed forms PASS: full map points/frame/path/link/plannedline/reveal controls, atomic district/place membership CRUD, station/taxi/boarding/siding arrival spawn choices, transport text and flag.');
