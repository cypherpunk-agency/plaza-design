/** Verify existing F5 source/evidence pins; never reissues browser acceptance. */
import assert from'node:assert/strict';import*as fs from'node:fs';import*as path from'node:path';import{fileURLToPath}from'node:url';import{createHash}from'node:crypto';import{sourceDocuments}from'../../src/ssg/game/authoring/source-documents';import{buildEventInspection}from'../../src/ssg/game/authoring/event-inspector-model';
const demo=fileURLToPath(new URL('../../',import.meta.url)),game=path.join(demo,'src/ssg/game'),hash=(f:string)=>createHash('sha256').update(fs.readFileSync(f)).digest('hex'),report=JSON.parse(fs.readFileSync(path.join(game,'authoring/inventories/S12.acceptance.json'),'utf8'));assert.equal(report.gate,'F5');for(const[f,h]of Object.entries(report.sourcePins))assert.equal(hash(path.join(game,f)),h,'F5 implementation pin changed: '+f);for(const[f,h]of Object.entries(report.checkPins))assert.equal(hash(path.join(demo,f)),h,'F5 focused-check pin changed: '+f);const documents=sourceDocuments.map(d=>({id:d.id,kind:d.kind,revision:hash(path.join(game,d.file)),value:JSON.parse(fs.readFileSync(path.join(game,d.file),'utf8'))}));assert.deepEqual(Object.keys(report.documentRevisions).sort(),documents.map(d=>d.id).sort());for(const d of documents)assert.equal(d.revision,report.documentRevisions[d.id],'F5 inspected document changed: '+d.id);const graph=buildEventInspection({documents});assert.deepEqual(graph.coverage,report.coverage);assert.equal(graph.nodes.length,report.counts.nodes);assert.equal(graph.edges.length,report.counts.edges);console.log(JSON.stringify({gate:'F5',sourcePins:Object.keys(report.sourcePins).length,checkPins:Object.keys(report.checkPins).length,nodes:graph.nodes.length,edges:graph.edges.length,result:'PASS existing pins; browser workflow was not rerun'}));
