fs.writeFileSync(path.join(dir,'evidence.json'),JSON.stringify({status:'PASS',scene:'shop',documents:3,sourceTransaction:saved.transaction,nativeCommandAndObjective:true,legacySceneFormat:true,geometry:{width:980,buyX:616,vendingX:530,vendingPromptH:106},checks:['history','bundle','protected Save','native reload','exact byte Undo','atomic invalid reference rejection']},null,2)+'\n');console.log('Shop manifest Save PASS: added/rebound/removed ordinary native content, shared action/event/objective, width/anchor/size-derived geometry, legacy scene input, atomic history/bundle/source Save/native reload/byte Undo. Evidence: '+dir);
