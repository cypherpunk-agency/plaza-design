let state:any={flags:{},items:{},tokens:1};const session=new GameplaySession(native.gameplay!,{read:()=>state,write:v=>{state=v;}});const use=native.uses!.find(u=>u.id==='review-action')!;assert.equal(native.objective!(state.flags),'Use the new action');assert.deepEqual(use.use({gameplay:session,flags:state.flags} as any),['Action committed.']);assert.equal(state.flags['shop.review.done'],true);assert.equal(native.objective!(state.flags),'Action complete');
