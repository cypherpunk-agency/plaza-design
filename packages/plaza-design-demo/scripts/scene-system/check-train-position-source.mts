function fixture(shared:boolean,phase:string,at:number,pos:number,open:number,signal:boolean,block:string){const metro=createLineSystem(),records:any[]=[],receipts:any[]=[];let rules:any;if(shared)rules=createTrainRules(metro);else{const exports:any={};vm.runInNewContext(javascript,{exports,...metro,...city});rules=exports.TRAIN_RULES;}const m=new SceneModel({say:(line,from,receipt)=>{records.push(['say',line,from,{scope:receipt!.scope,source:receipt!.source,tone:receipt!.tone}]);receipts.push(receipt);},changed:()=>records.push(['changed']),open(){}},structuredClone(shared?scene.data!:oldData),rules);m.setPaused(true);m.now=()=>1000;m.wall=()=>1000;Object.assign(metro.ride,{phase,at,to:(at+1)%3,pos,open});let root:any={flags:{},items:{},tokens:0};const session=shared?new GameplaySession(scene.gameplay!,fixtureGameplayPort(scene.gameplay!,{read:()=>root,write:s=>{root=s;}},()=>m)):undefined;if(session)attachNativeGameplay(m,session);if(block==='lock')m.locks.set('train',2000);if(block==='watchdog')m.frozen=()=>true;
