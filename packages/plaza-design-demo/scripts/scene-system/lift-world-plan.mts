import fs from 'node:fs';import ts from 'typescript';
function lift(file:string,module:string,factory:string,modelType:string,defaults:string){const text=fs.readFileSync(file,'utf8');if(text.includes('export function '+factory))throw new Error('Already lifted');const sf=ts.createSourceFile(file,text,ts.ScriptTarget.Latest,true),imports:string[]=[],types:string[]=[],body:string[]=[],names:string[]=[],bindings:string[]=[];
for(const s of sf.statements){if(ts.isImportDeclaration(s)){if((s.moduleSpecifier as ts.StringLiteral).text===module){const named=s.importClause!.namedBindings;if(!named||!ts.isNamedImports(named))throw new Error('Named imports expected');const value=named.elements.filter(e=>!e.isTypeOnly).map(e=>e.name.text),type=named.elements.filter(e=>e.isTypeOnly).map(e=>e.name.text);bindings.push(...value);if(type.length)imports.push(`import type {${type.join(',')}} from '${module}';`);}else imports.push(s.getFullText(sf));continue;}if(ts.isTypeAliasDeclaration(s)||ts.isInterfaceDeclaration(s)){types.push(s.getFullText(sf));continue;}let full=s.getFullText(sf);const token=s.modifiers?.find(m=>m.kind===ts.SyntaxKind.ExportKeyword);if(token){const start=token.getStart(sf)-s.getFullStart();full=full.slice(0,start)+full.slice(start+6);if(ts.isVariableStatement(s))for(const d of s.declarationList.declarations){if(!ts.isIdentifier(d.name))throw new Error('Identifier expected');names.push(d.name.text);}else if(ts.isFunctionDeclaration(s))names.push(s.name!.text);}body.push(full);}
const head=`import * as ${defaults} from '${module}';\nimport type {${modelType}} from '${module}';\n`;
fs.writeFileSync(file,head+imports.join('\n')+'\n'+types.join('\n')+`\n/** Instance-owned lookup/caches; the shipping facade uses unchanged default inputs. */\nexport function ${factory}(world:${modelType}=${defaults}){\n const {${bindings.join(',')}}=world;\n`+body.join('\n')+`\n return {${names.join(',')}};\n}\nconst shipping=${factory}();\nexport const {${names.join(',')}}=shipping;\n`);console.log('Lifted '+file+': '+names.length+' exports');}
lift('src/ssg/game/world/cityplan.ts','./city','createCityPlan','CityModel','defaultCity');
