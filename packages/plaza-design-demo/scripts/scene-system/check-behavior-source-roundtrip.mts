/** Run in a fresh Node process between browser Save and journal Undo. No source writes. */
import assert from'node:assert/strict';
import{readFileSync}from'node:fs';import{createHash}from'node:crypto';import{fileURLToPath}from'node:url';
import{SCENES}from'../../src/ssg/game/scenes';import{SceneModel,type Line}from'../../src/ssg/game/engine/model';
const mode=process.argv[2];assert.ok(mode==='edited'||mode==='baseline','Pass edited or baseline');const scene=SCENES.sandbox;assert.ok(scene.data&&scene.rules&&typeof scene.rules==='object');const lines:Line[]=[];const model=new SceneModel({say:line=>lines.push(line),open:()=>{},changed:()=>{}},scene.data,scene.rules);model.act('lamp','lamp','on');assert.equal(model.state.lampOn,true);assert.equal(model.state.memo,mode==='edited'?2:0);assert.equal(lines.some(l=>l[1]==='S13 integrated source roundtrip'),mode==='edited');const file=fileURLToPath(new URL('../../src/ssg/game/scenes/sandbox/devices.json',import.meta.url)),sha=createHash('sha256').update(readFileSync(file)).digest('hex');if(mode==='baseline')assert.equal(sha,'ea44d5a90ad211c2d50fad9519fa42e2b4dc4899925840fdd860e08aab23ac0e');console.log(JSON.stringify({mode,source:'scenes/sandbox/devices.json',sha256:sha,runtime:'SCENES.sandbox + real SceneModel',lampOn:model.state.lampOn,memo:model.state.memo,lines}));model.reset();
