import assert from 'node:assert/strict';
import {PresentationSignals} from '../../src/ssg/game/engine/gameplay/presentation-signals';
import {GameplaySession} from '../../src/ssg/game/engine/gameplay/session';
import {validateGameplay} from '../../src/ssg/game/engine/gameplay/validation';
import {validateGameplayText,renderGameplayText} from '../../src/ssg/game/engine/gameplay/text-template';
import {validateSceneDocument,compileSceneDocument} from '../../src/ssg/game/engine/gameplay/scene-document';
import type {GameplayState} from '../../src/ssg/game/engine/gameplay/types';
const definition=validateGameplay({version:1,flags:[],items:['tea'],state:{'test.count':{owner:'test',lifetime:'save',type:'number',default:2,min:0,max:3}},events:['test.cue','test.other'],commands:{'test.emit':{sources:['interaction','signal'],actions:[{tokens:-1},{emit:'test.cue'}]}},reactions:[],conversations:{}});
const cues=new PresentationSignals([{event:'test.cue',target:'flight'}],{flight:-1e9});let state:GameplayState={flags:{},items:{tea:2},tokens:1},frame=100,failCommit=false;
const session=new GameplaySession(definition,{read:()=>state,write:s=>{if(failCommit)throw new Error('Rejected commit');state=s;}});session.observe(e=>cues.event(e,frame));
assert.equal(session.eligibility('test.emit','interaction').ok,true);assert.equal(cues.read('flight'),-1e9,'eligibility is not a presentation event');failCommit=true;assert.equal(session.dispatch('test.emit','interaction').ok,false);assert.equal(cues.read('flight'),-1e9);assert.equal(state.tokens,1);
failCommit=false;assert.equal(session.dispatch('test.emit','interaction').ok,true);assert.equal(cues.read('flight'),100);frame=200;assert.equal(session.dispatch('test.emit','interaction').ok,false);assert.equal(cues.read('flight'),100,'resource refusal publishes no cue');
state.tokens=1;assert.equal(session.dispatch('test.emit','signal').ok,true);assert.equal(cues.read('flight'),200,'signal and ordinary commands use the same presentation observer');
const snapshot=cues.capture();cues.restore({flight:12});assert.equal(cues.read('flight'),12);cues.restore(snapshot);assert.equal(cues.read('flight'),200);for(const bad of [{flight:NaN},{flight:4,extra:1},{},[],{flight:'now'}])assert.throws(()=>cues.restore(bad as any));assert.throws(()=>new PresentationSignals([{event:'test.cue',target:'missing'}],{flight:0}));
session.dispose();state.tokens=1;frame=300;assert.equal(session.dispatch('test.emit','interaction').ok,false);assert.equal(cues.read('flight'),200);
validateGameplayText(['Tokens {tokens}; tea {item:tea}; count {state:test.count}.'],definition);assert.deepEqual(renderGameplayText(['Tokens {tokens}; tea {item:tea}; count {state:test.count}.'],{...state,values:{'test.count':3}}),['Tokens 1; tea 2; count 3.']);for(const key of ['state:missing','item:missing','process.env','tokens:secret'])assert.throws(()=>validateGameplayText(['{'+key+'}'],definition));
const source={version:1,id:'test',name:'Test',intro:['Arrived'],uses:[{id:'tap',name:'Device',label:'Tap',routes:[{template:true,command:'test.emit',pages:['Spent; have {tokens}'],failure:['Refused; have {tokens}']}]}]};const doc=validateSceneDocument(source,definition),compiled=compileSceneDocument(doc,{tap:0},()=>[]);let saved:GameplayState={flags:{},items:{},tokens:0};const gp=new GameplaySession(definition,{read:()=>saved,write:s=>{saved=s;}});assert.deepEqual(compiled.uses[0].use({gameplay:gp} as any),['Refused; have 0']);saved.tokens=2;assert.deepEqual(compiled.uses[0].use({gameplay:gp} as any),['Spent; have 1']);
console.log('Presentation signals/templates PASS: only committed events stamp, ordinary/signal parity, pure eligibility, failed commit/resource isolation, snapshot validation/disposal, declared read-only text fields and post-command success/failure text.');
