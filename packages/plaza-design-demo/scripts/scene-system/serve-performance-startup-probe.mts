import fs from 'node:fs';import path from 'node:path';import http from 'node:http';
// Deliberately tiny sibling-realm probe: same opaque sandbox/names, no Game or fonts.
const port=Number(process.argv[2]??4212);if(!Number.isInteger(port)||port<1024||port>65535)throw new Error('Valid loopback port required');const root=path.resolve('../../.performance/startup-probe/run-'+Date.now());fs.mkdirSync(root,{recursive:true});const log=(v:object)=>fs.appendFileSync(path.join(root,'transport.jsonl'),JSON.stringify({at:new Date().toISOString(),...v})+'\n');
const bootstrap=`parent.postMessage({channel:'probe',type:'parser',realm:new URL(location.href).searchParams.get('realm')},'*');`;
const {createHash}=await import('node:crypto'),hash=createHash('sha256').update(bootstrap).digest('base64');
fs.writeFileSync(path.join(root,'frame.html'),`<!doctype html><html><head><meta charset="utf-8"><meta http-equiv="Content-Security-Policy" content="default-src 'none';script-src 'self' 'sha256-${hash}';style-src 'unsafe-inline';font-src data:;img-src data:"><script>${bootstrap}</script></head><body>tiny parser probe<script src="frame.js"></script></body></html>`);
fs.writeFileSync(path.join(root,'frame.js'),`parent.postMessage({channel:'probe',type:'ready',realm:new URL(location.href).searchParams.get('realm')},'*');`);
fs.writeFileSync(path.join(root,'runner.js'),`let serial=0,current,events=[];const show=(type,extra={})=>{events.push({type,at:performance.now(),...extra});document.querySelector('pre').textContent=JSON.stringify(events,null,2);};function next(){const frame=document.createElement('iframe');frame.loading='eager';frame.name='access-denied-editor-play:normal';frame.setAttribute('sandbox','allow-scripts');frame.width='960';frame.height='540';const id=++serial;current=frame;frame.onload=()=>show('load',{id});frame.onerror=()=>show('error',{id});frame.src='/frame.html?realm='+id;document.querySelector('#stage').append(frame);show('insert',{id});setTimeout(()=>{if(current===frame)show('threshold',{id});},5000);}window.addEventListener('message',e=>{if(e.source!==current?.contentWindow||e.data?.channel!=='probe')return;show(e.data.type,{realm:e.data.realm});if(e.data.type==='ready'&&serial===1){current.remove();show('remove',{id:1});setTimeout(next,500);}});document.querySelector('button').onclick=()=>{document.querySelector('button').disabled=true;next();};`);
fs.writeFileSync(path.join(root,'index.html'),`<!doctype html><html><head><meta charset="utf-8"><meta http-equiv="Content-Security-Policy" content="default-src 'none';script-src 'self';style-src 'unsafe-inline';frame-src 'self';connect-src 'self'"></head><body><button>Run two tiny private frames</button><pre></pre><div id="stage"></div><script src="runner.js"></script></body></html>`);
const server=http.createServer((req,res)=>{const url=new URL(req.url??'/', 'http://127.0.0.1:'+port),name=url.pathname==='/'?'index.html':url.pathname.slice(1);if(!['index.html','frame.html','runner.js','frame.js'].includes(name)){res.writeHead(404).end();return;}const id=Date.now()+':'+url.pathname+url.search;log({event:'request',id});let bytes=0;req.on('aborted',()=>log({event:'request-aborted',id,bytes}));res.on('finish',()=>log({event:'response-finish',id,bytes}));res.on('close',()=>log({event:'response-close',id,bytes,complete:res.writableFinished}));res.writeHead(200,{'Content-Type':name.endsWith('.js')?'application/javascript':'text/html','Cache-Control':'no-store'});const stream=fs.createReadStream(path.join(root,name));stream.on('data',chunk=>bytes+=chunk.length);stream.on('end',()=>log({event:'stream-end',id,bytes}));stream.on('error',error=>{log({event:'stream-error',id,error:String(error)});res.destroy(error);});stream.pipe(res);});
server.listen(port,'127.0.0.1',()=>console.log(JSON.stringify({url:'http://127.0.0.1:'+port,root})));process.on('SIGINT',()=>server.close());
