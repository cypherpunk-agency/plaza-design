import fs from 'node:fs';import ts from 'typescript';
const file='src/ssg/game/ui/citymap.ts',text=fs.readFileSync(file,'utf8');if(text.includes('export function createCityMap'))throw new Error('Already lifted');const sf=ts.createSourceFile(file,text,ts.ScriptTarget.Latest,true),imports:string[]=[],types:string[]=[],body:string[]=[],names:string[]=[],city:string[]=[],plan:string[]=[];
for(const s of sf.statements){if(ts.isImportDeclaration(s)){const from=(s.moduleSpecifier as ts.StringLiteral).text;if(['../world/city','../world/cityplan'].includes(from)){const named=s.importClause!.namedBindings;if(!named||!ts.isNamedImports(named))throw new Error('Named imports expected');(from.endsWith('/city')?city:plan).push(...named.elements.filter(e=>!e.isTypeOnly).map(e=>e.name.text));const t=named.elements.filter(e=>e.isTypeOnly).map(e=>e.name.text);if(t.length)imports.push(`import type {${t.join(',')}} from '${from}';`);}else imports.push(s.getFullText(sf));continue;}if(ts.isTypeAliasDeclaration(s)||ts.isInterfaceDeclaration(s)){(s.modifiers?.some(m=>m.kind===ts.SyntaxKind.ExportKeyword)?types:body).push(s.getFullText(sf));continue;}let full=s.getFullText(sf);const token=s.modifiers?.find(m=>m.kind===ts.SyntaxKind.ExportKeyword);if(token){const start=token.getStart(sf)-s.getFullStart();full=full.slice(0,start)+full.slice(start+6);if(ts.isFunctionDeclaration(s))names.push(s.name!.text);else throw new Error('Unexpected exported value');}body.push(full);}
fs.writeFileSync(file,`import * as defaultCity from '../world/city';\nimport type {CityModel} from '../world/city';\nimport {createCityPlan} from '../world/cityplan';\n`+imports.join('\n')+'\n'+types.join('\n')+`\n/** Map rendering/input and caches consume one isolated city/plan pair. */\nexport function createCityMap(world:CityModel=defaultCity,geography:ReturnType<typeof createCityPlan>=createCityPlan(world)){\n const {${city.join(',')}}=world;\n const {${plan.join(',')}}=geography;\n`+body.join('\n')+`\n return {${names.join(',')}};\n}\nconst shipping=createCityMap();\nexport const {${names.join(',')}}=shipping;\n`);console.log('Lifted city map renderer/input: '+names.join(', '));
