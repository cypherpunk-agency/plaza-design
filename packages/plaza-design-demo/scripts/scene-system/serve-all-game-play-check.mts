/** Loopback-only technical fixture; production runtime bytes stay untouched on disk. */
import fs from 'node:fs';import path from 'node:path';import http from 'node:http';
const port=Number(process.argv[2]??4207);if(!Number.isInteger(port)||port<1024||port>65535)throw new Error('Invalid port');
const root=path.resolve('../../.scene-system/all-game-play-check'),home=path.resolve('dist-homepage'),config=JSON.parse(fs.readFileSync(path.join(root,'config.json'),'utf8')),origin='http://127.0.0.1:'+port;
const instrumentation=`(()=>{const send=(type,value)=>parent.postMessage({channel:'all-game-play-check',type,value},'*');send('script',true);for(const key of['localStorage','sessionStorage'])Object.defineProperty(window,key,{get(){send('storage',key);throw new Error('Unexpected native storage');}});window.addEventListener('error',e=>send('error',e.message));window.addEventListener('unhandledrejection',e=>send('error',String(e.reason)));let paints=0;const fill=CanvasRenderingContext2D.prototype.fillText;CanvasRenderingContext2D.prototype.fillText=function(...args){paints++;if(paints===1||paints%100===0)send('paint',paints);return fill.apply(this,args);};})();\n`;
const server=http.createServer(async(req,res)=>{try{const url=new URL(req.url??'/',origin);if(req.method==='GET'&&url.pathname.startsWith('/runtime/')){console.log(new Date().toISOString()+' GET '+url.pathname+url.search);res.on('finish',()=>console.log(new Date().toISOString()+' SENT '+url.pathname+url.search));}
 if(req.method==='POST'&&url.pathname==='/report'){if(req.headers.origin!==origin||req.headers['content-type']!=='application/json'){res.writeHead(403);res.end();return;}let body='',size=0;for await(const chunk of req){size+=chunk.length;if(size>128000)throw new Error('Report too large');body+=chunk;}const report=JSON.parse(body),ids=new Set(config.cases.map((c:any)=>c.fixture.scene));if(report.source!==config.source||report.cases!==19||report.rows?.length!==19||report.runtime.scriptSha256!==config.runtime.scriptSha256)throw new Error('Wrong source/runtime/cases');for(const row of report.rows){if(!ids.delete(row.scene)||row.status!==(row.running===true&&row.error===null&&row.receivedScene===row.scene&&row.states>=2&&row.paintCalls>0&&row.nativeStorage===0&&row.inaccessible===true&&row.sandbox==='allow-scripts'?'PASS':'FAIL'))throw new Error('Invalid startup result');}if(ids.size||report.status!==(report.rows.every((r:any)=>r.status==='PASS')?'PASS':'FAIL'))throw new Error('Invalid summary');const dir=path.join(root,'evidence');fs.mkdirSync(dir,{recursive:true});const file=Date.now()+'.json';fs.writeFileSync(path.join(dir,file),JSON.stringify({...report,recordedAt:new Date().toISOString(),instrumentation:'local server-only native-storage/error/paint observers; no input hooks'},null,2)+'\n',{flag:'wx'});res.writeHead(201,{'Content-Type':'text/plain'});res.end('evidence/'+file);return;}
 if(req.method!=='GET'){res.writeHead(405);res.end();return;}
 let file:string|undefined,type='text/html',prefix='';if(url.pathname==='/'||url.pathname==='/index.html')file=path.join(root,'index.html');else if(url.pathname==='/check.js'){file=path.join(root,'check.js');type='text/javascript';}else if(url.pathname==='/runtime/'+config.runtime.entry)file=path.join(home,'editor',config.runtime.entry);else if(url.pathname==='/runtime/'+config.runtime.script){file=path.join(home,'editor',config.runtime.script);type='text/javascript';prefix=instrumentation;}else if(/^\/fonts\/ibm-plex-mono-latin-(400|500|600|700)-normal\.woff2$/.test(url.pathname)){file=path.join(home,url.pathname.slice(1));type='font/woff2';}if(!file){res.writeHead(404);res.end();return;}const body=prefix?Buffer.from(prefix+fs.readFileSync(file,'utf8')):fs.readFileSync(file);res.writeHead(200,{'Content-Type':type,'Content-Length':body.length,'Cache-Control':'no-store','Connection':'close'});res.end(body);
 }catch(error){res.writeHead(400,{'Content-Type':'text/plain'});res.end(String(error));}});
server.listen(port,'127.0.0.1',()=>console.log('All-scene private Play fixture: '+origin));process.on('SIGINT',()=>server.close());process.on('SIGTERM',()=>server.close());
