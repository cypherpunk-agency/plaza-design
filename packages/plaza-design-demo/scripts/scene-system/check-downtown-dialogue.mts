import assert from 'node:assert/strict';import fs from 'node:fs';import path from 'node:path';import {gunzipSync} from 'node:zlib';import {createHash} from 'node:crypto';import {newSave,type Save} from '../../src/ssg/game/runtime/save';import {fixerPrice,fixerTalk,npcTalk} from './downtown-dialogue-fixture.mts';
const base=path.resolve('../../.scene-system/all-game-baseline-2026-10-18/source'),fixture=JSON.parse(gunzipSync(fs.readFileSync('scripts/scene-system/fixtures/downtown-dialogue-original.json.gz')).toString('utf8'));
for(const[file,hash]of Object.entries(fixture.sources))assert.equal(createHash('sha256').update(fs.readFileSync(path.join(base,file))).digest('hex'),hash,'immutable dialogue behavior evidence '+file);
// Frozen observations supply expected gameplay, not an old-save loading contract.
const current=(input:any):Save=>{const{hints,...fields}=structuredClone(input);return{...newSave(),...fields,gameplay:Object.fromEntries(['box','install','relay','gate'].map(goal=>['downtown.hints.'+goal,hints[goal]??0]))};};
const effects=(save:Save)=>({flags:save.flags,tokens:save.tokens,handle:save.handle,jump:save.jump,controlled:save.controlled,keyring:save.keyring,items:save.items,hints:Object.fromEntries(['box','install','relay','gate'].map(goal=>[goal,save.gameplay?.['downtown.hints.'+goal]??0]))});
for(const[index,row]of fixture.fixer.entries()){const save=current(row.input);assert.equal(fixerPrice(save),row.priceBefore,'price '+index);assert.deepEqual(fixerTalk(save),row.out,'talk '+index);assert.deepEqual(effects(save),effects(current(row.after)),'behavior effects '+index);assert.equal(fixerPrice(save),row.priceAfter,'next price '+index);assert(!('hints'in save),'current runtime never owns a second hint store');}
for(const row of fixture.npcs){const save=current(row.input),before=structuredClone(save);assert.deepEqual(npcTalk(row.id,save),row.out);assert.deepEqual(save,before,'NPC read-only behavior');}
for(const row of fixture.sequences){const save=current(row.input);for(const step of row.steps){assert.equal(fixerPrice(save),step.price);assert.deepEqual(fixerTalk(save),step.out);assert.deepEqual(effects(save),effects(current(step.after)));}}
console.log('Downtown current-state behavior PASS: '+fixture.fixer.length+' immutable Fixer pages/price/effect observations, '+fixture.npcs.length+' NPC cases, '+fixture.sequences.length+' repeated histories through actual common Game port. No old-save compatibility contract.');
