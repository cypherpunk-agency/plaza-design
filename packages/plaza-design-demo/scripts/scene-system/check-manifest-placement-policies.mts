import assert from 'node:assert/strict';
import {art} from '../../src/ssg/game/art';
import {manifestCompositionRows,manifestGeometry} from '../../src/ssg/game/engine/gameplay/manifest-geometry';
import {validateManifestTarget} from '../../src/ssg/game/engine/gameplay/manifest-contract';
import {compileManifestDocument} from '../../src/ssg/game/engine/gameplay/manifest-content-compiler';
import type {SceneDocument} from '../../src/ssg/game/engine/gameplay/scene-document';
const source:SceneDocument={version:1,id:'fixture',name:'Fixture',intro:[],uses:[{id:'use',name:'Object',label:'USE',routes:[{pages:['OK.']}]}],exits:[{id:'exit',to:'fixture',label:'OUT'}],manifest:{version:1,width:600,spawn:'spawn',uses:{use:{instance:'point',promptH:0,promptAboveFloor:true,responseH:0,responseAboveFloor:true}},exits:{exit:'exit'}}};
const composition=art.validate({version:1,scene:'fixture',instances:[{id:'spawn',type:'furniture.stool',props:{seed:1},placement:{x:180,h:0},order:0,pass:'backdrop'},{id:'point',type:'furniture.stool',props:{seed:1},placement:{x:220,h:0},order:1,pass:'backdrop'},{id:'exit',type:'furniture.stool',props:{seed:1},placement:{x:400,h:0},order:2,pass:'backdrop'}]});
const compile=()=>compileManifestDocument(source,manifestCompositionRows(composition),()=>({name:'',pages:[]}),{groups:['uses','readables','rests','exits']});
let use=compile().content.uses![0];assert.equal(use.promptH,undefined);assert.equal(use.h,undefined);
composition.instances[1].placement.h=32;use=compile().content.uses![0];assert.equal(use.promptH,32);assert.equal(use.h,32);
composition.instances[1].placement.h=0;source.manifest!.uses.use={instance:'point',promptH:0,responseH:0};use=compile().content.uses![0];assert.equal(use.promptH,0);assert.equal(use.h,0,'explicit zero remains available without conditional policy');
for(const invalid of [{instance:'point',promptAboveFloor:true},{instance:'point',promptH:0,promptAboveFloor:false},{instance:'point',promptH:0,promptAboveFloor:'true'}])assert.throws(()=>validateManifestTarget(invalid));
composition.instances[2].placement={x:400,h:0,scale:2,facing:-1};source.manifest!.exits!.exit={instance:'exit',anchor:'origin',x:10,promptH:82};
const rows=manifestCompositionRows(composition);assert.throws(()=>manifestGeometry(source,rows,['uses','exits']));
const transformed=manifestGeometry(source,rows,['uses','exits'],{transformedExits:true});assert.equal(transformed.bindings.exits.exit.x,380);assert.equal(transformed.bindings.exits.exit.promptH,82);
const native=compileManifestDocument(source,rows,()=>({name:'',pages:[]}),{groups:['uses','readables','rests','exits'],transformedExits:true});assert.equal(native.content.exits[0].x,380);
source.manifest!.uses.use='exit';assert.throws(()=>manifestGeometry(source,rows,['uses','exits'],{transformedExits:true}),'transformed exits do not loosen ordinary interactions');
source.manifest!.uses.use='point';source.manifest!.spawn='exit';assert.throws(()=>manifestGeometry(source,rows,['uses','exits'],{transformedExits:true}),'spawn policy stays strict');
source.manifest!.spawn='spawn';composition.instances[2].placement.parallax=.5;assert.throws(()=>manifestGeometry(source,manifestCompositionRows(composition),['uses','exits'],{transformedExits:true}),'parallax cannot drive gameplay exits');
console.log('Manifest placement policies PASS: ground omission/elevated prompt+response, explicit zero, strict policy flags, mirrored/scaled horizontal exit anchors and unchanged interaction/spawn/parallax restrictions.');
