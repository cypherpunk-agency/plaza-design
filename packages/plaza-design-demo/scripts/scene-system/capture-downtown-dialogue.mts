/** Finite original Downtown dialogue corpus; refuses to overwrite its immutable result. */
import fs from 'node:fs';import path from 'node:path';import {pathToFileURL} from 'node:url';import {createHash} from 'node:crypto';import {gzipSync} from 'node:zlib';
const base=path.resolve('../../.scene-system/all-game-baseline-2026-10-18/source'),file='scripts/scene-system/fixtures/downtown-dialogue-original.json.gz';if(fs.existsSync(file))throw new Error('Original Downtown dialogue fixture already captured');
const original=await import(pathToFileURL(path.join(base,'scenes/downtown/dialogue.ts')).href),goals=['handle','till','box','install','relay','gate','done'];
function state(goal:string,handle:string){const i=goals.indexOf(goal);return {handle:i?handle:'',tokens:0,jump:i>=4,controlled:[...(i>=3?['0x2F']:[]),...(i>=5?['0x31']:[])],flags:{...(i>=2?{till:true}:{}),...(i>=6?{end:true}:{}),foreign:true},hints:{foreign:7},keyring:['foreign.chip'],scenes:{foreign:{state:{kept:7}}},items:{tea:3},foreign:'keep'};}
const fixer:any[]=[];
for(const goal of goals)for(const name of goal==='handle'?['']:['MORGAN','NEON'])for(const metFixer of [false,true])for(const greeted of [false,true])for(const gloves of [false,true])for(const keys of [[],['glove.left'],['glove.right'],['glove.left','glove.right']])for(const used of [0,1,2,3,9])for(const tokens of [0,1,3]){
 const input:any=state(goal,name);Object.assign(input,{tokens,keyring:[...input.keyring,...keys]});Object.assign(input.flags,{metFixer,greeted,gloves});input.hints[goal]=used;const saved=structuredClone(input),priceBefore=original.fixerPrice(saved),out=original.fixerTalk(saved),priceAfter=original.fixerPrice(saved);fixer.push({goal,input,priceBefore,out,after:saved,priceAfter});
}
const npcs:any[]=[];for(const id of ['hood','umbrella','hat','unknown'])for(let mask=0;mask<16;mask++){const input:any=state('till','MORGAN');input.controlled=['0x2F','0x31','0x3C','foreign.node'].filter((_n,i)=>mask&(1<<i));const before=structuredClone(input),out=original.npcTalk(id,input);if(JSON.stringify(input)!==JSON.stringify(before))throw new Error('Original NPC dialogue mutated its save');npcs.push({id,input,out});}
const sequences:any[]=[];for(const goal of goals)for(const tokens of [0,1,5]){const input:any=state(goal,'MORGAN');input.tokens=tokens;input.keyring.push('glove.left','glove.right');const current=structuredClone(input),steps:any[]=[];for(let n=0;n<8;n++){const price=original.fixerPrice(current),out=original.fixerTalk(current);steps.push({price,out,after:structuredClone(current)});}sequences.push({goal,input,steps});}
const files=['scenes/downtown/dialogue.ts','scenes/downtown/progression.ts','runtime/save.ts','runtime/game.ts'],sources=Object.fromEntries(files.map(f=>[f,createHash('sha256').update(fs.readFileSync(path.join(base,f))).digest('hex')]));
fs.writeFileSync(file,gzipSync(JSON.stringify({version:1,source:'all-game-baseline-2026-10-18',sources,fixer,npcs,sequences,prefill:{phase:'after-final-page',field:'ask',command:'set handle ',note:'Runtime method-extraction check executes the original final-page callback separately; dialogue fixtures preserve the ask value.'}})));
console.log(`Captured ${fixer.length} Fixer branches, ${npcs.length} NPC control subsets and ${sequences.length} repeated eight-step dialogue histories from immutable source.`);
