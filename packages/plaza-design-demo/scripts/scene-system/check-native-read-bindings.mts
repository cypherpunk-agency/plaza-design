const fixture=JSON.parse(fs.readFileSync('scripts/scene-system/fixtures/laundromat-conversation-baseline.json','utf8')),original=fixture.dialogue,registered=gameplayScene('laundromat'),source=registered.validateGameplay(JSON.parse(fs.readFileSync('src/ssg/game/scenes/laundromat/gameplay.json','utf8')));
