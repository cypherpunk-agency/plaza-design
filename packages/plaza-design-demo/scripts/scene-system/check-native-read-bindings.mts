console.log(`Native read bindings/SUDS PASS: ${cases} original node/state cases and ${choices} choice transitions, unbounded native count truthiness, live changes over stale saved flags, no duplicated saved flags, commerce isolation, free-input/retry, pending dialogue, read-only permissions and cable ownership.`);
