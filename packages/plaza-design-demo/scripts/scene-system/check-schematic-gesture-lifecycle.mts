import assert from 'node:assert/strict';
import {Schematic} from '../../src/ssg/game/engine/schematic';
const original=Object.getOwnPropertyDescriptor(globalThis,'window'),listeners=new Map<string,Set<(e:any)=>void>>();
Object.defineProperty(globalThis,'window',{configurable:true,value:{addEventListener:(key:string,fn:(e:any)=>void)=>{if(!listeners.has(key))listeners.set(key,new Set());listeners.get(key)!.add(fn);},removeEventListener:(key:string,fn:(e:any)=>void)=>listeners.get(key)?.delete(fn)}});
const count=()=>[...listeners.values()].reduce((n,s)=>n+s.size,0),event=(pointerId=1)=>({pointerId,clientX:10,clientY:10,button:0,preventDefault(){},stopPropagation(){},target:{closest:()=>null},currentTarget:{style:{},classList:{remove(){}}}}),send=(type:string,e=event())=>{for(const fn of [...listeners.get(type)??[]])fn(e);};
function fixture(){const s:any=Object.create(Schematic.prototype);let actions=0;const fields={root:{hidden:false},mode:'board',stage:{querySelector:()=>null,getBoundingClientRect:()=>({left:0,top:0}),clientWidth:1000,clientHeight:600},known:new Set(['device']),anchors:new Map(),moved:new Map(),voff:new Map(),open:new Set(),boardPos:new Map(),offsets:new Map(),unfolded:new Set(),folded:new Set(),m:{items:()=>[],noun:()=>true},render(){},show(){},presentHint(){},onClose(){},onLayout(){actions++;},onMovePart(){actions++;},lines(){},fold(){actions++;},addLogic(){actions++;return 'new';},onDrawer(){},under:()=>null,note(){actions++;},propose(){actions++;},only(key:string){this.open.add(key);},visionOffset:()=>({x:0,y:0})};Object.assign(s,fields);return{s,actions:()=>actions+(s.open.size?1:0),tap:()=>actions++};}
const gestures=['dragPiece','partGestures','coreGestures','nounGestures','startWire','startChip','dragOut'];
function begin(s:any,name:string,tap:()=>void){const e=event();if(name==='dragPiece'){s.dragPiece(e,'device',tap);return;}if(['startWire','startChip','dragOut'].includes(name)){s[name](e,name==='startWire'?'device.noun:done':'item');return;}const node:any={addEventListener:(type:string,fn:(e:any)=>void)=>{assert.equal(type,'pointerdown');node.down=fn;},style:{}};if(name==='coreGestures')s.coreGestures(node,{style:{}},'device',tap);else s[name](node,'device.noun');node.down(e);}
const interruptions=[(s:any)=>s.close(),(s:any)=>s.resetLayout(),(s:any)=>s.restoreLayout({}),(s:any)=>s.restorePieces({},()=>true),(s:any)=>s.openDevice('device'),(s:any)=>s.openBoard(),(s:any)=>s.openVision(),()=>send('pointercancel')];
