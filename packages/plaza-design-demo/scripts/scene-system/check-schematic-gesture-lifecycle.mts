try{for(const name of gestures){for(let repeat=0;repeat<10;repeat++)for(const interrupt of interruptions){const f=fixture();begin(f.s,name,f.tap);assert.equal(count(),3,name);const stale=[...listeners.get('pointerup')!];send('pointerup',event(99));assert.equal(count(),3,'foreign pointer cannot finish gesture');interrupt(f.s);assert.equal(count(),0,name+' interruption must release listeners');const before=f.actions();for(const fn of stale)fn(event());send('pointermove');send('pointerup');assert.equal(f.actions(),before,name+' must not act after interruption');cases++;}
 const f=fixture();begin(f.s,name,f.tap);send('pointerup');assert.equal(count(),0);assert(f.actions()>0,name+' normal tap still works');cases++;
 }
 // Replacement, not only close, releases the previous gesture without running it.
 const f=fixture();begin(f.s,'dragPiece',f.tap);begin(f.s,'startWire',f.tap);assert.equal(count(),3);assert.equal(f.actions(),0);assert.equal(f.s.armed,'device.noun:done');begin(f.s,'startWire',f.tap);assert.equal(f.s.armed,'device.noun:done','previous wire cancellation must not clear new wire');f.s.close();assert.equal(count(),0);
