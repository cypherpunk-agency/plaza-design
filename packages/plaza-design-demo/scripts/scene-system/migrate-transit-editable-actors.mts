/** One-time transit sprite recipe lift; immutable source remains the visual comparison oracle. */
import fs from 'node:fs';import {metroGeometry} from '../../src/ssg/game/scenes/metro/composition';import {galleriaStationGeometry} from '../../src/ssg/game/scenes/galleriaStation/composition';import {harborStationGeometry} from '../../src/ssg/game/scenes/harborStation/composition';import {trainGeometry} from '../../src/ssg/game/scenes/train/composition';
for(const [id,geometry] of [['metro',metroGeometry],['galleriaStation',galleriaStationGeometry],['harborStation',harborStationGeometry],['train',trainGeometry]] as const){const folder='src/ssg/game/scenes/'+id+'/',source=JSON.parse(fs.readFileSync(folder+'scene.json','utf8')),doc=JSON.parse(fs.readFileSync(folder+'composition.json','utf8'));if(source.actors)throw new Error('Transit actor lift already applied: '+id);const rows=geometry(),at=(id:string)=>rows.find(r=>r.instance.id===id)!.placement;source.actors=[];
 const body=(node:any,presentation:any)=>{source.actors.push({id:node.id,instance:node.id,band:'background',reaction:'actor.'+node.id,presentation});node.type='actor.prepared';node.props={actor:node.id};node.bindings={pose:'actor.'+node.id+'.pose'};};
 if(id==='train'){const riders=doc.instances.filter((n:any)=>n.type==='train.rider'),count=riders.filter((n:any)=>n.props.mode!=='regular').length,width=Number(rows.find(r=>r.instance.id==='scene')!.props.width);for(const node of riders){const p=node.props,regular=p.mode==='regular',presentation={kind:'rider',rider:regular?p.kind:'phone',sit:!!p.sit,...(regular?{flip:at(node.id).x>width/2,phase:at(node.id).x,regular:true}:{controller:{kind:'trainCrowd',slot:p.slot,count,standing:p.mode==='standing'}})};body(node,presentation);}}
 else{const waiting=doc.instances.filter((n:any)=>n.type==='station.waiting-passenger'),station=id==='metro'?'downtown':id==='galleriaStation'?'galleria':'harbor';waiting.forEach((node:any,i:number)=>body(node,{kind:'rider',rider:'phone',controller:{kind:'platformQueue',station,slot:i,count:waiting.length}}));const bench=doc.instances.find((n:any)=>n.type==='station.bench'&&n.props.who);if(bench){const kind=bench.props.who;bench.props={who:'',sourceRider:true};bench.bindings={...(bench.bindings??{}),rider:'actor.regular.pose.embedded'};body(doc.instances.find((n:any)=>n.id==='regular'),{kind:'rider',rider:kind,sit:true,phase:at(bench.id).x});}}
 fs.writeFileSync(folder+'scene.json',JSON.stringify(source,null,2)+'\n');fs.writeFileSync(folder+'composition.json',JSON.stringify(doc,null,2)+'\n');
}
console.log('Lifted 36 original transit rider recipes and explicit procedural count/slots without changing authored placement.');
