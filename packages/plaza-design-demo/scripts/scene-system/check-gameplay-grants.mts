try{const save=newSave(),game:any=Object.create(Game.prototype),data=emptyData('grant-review','Grant review'),d=structuredClone(grants);data.devices=[{id:'washer3',name:'WASHER 3',nouns:[{id:'door',kind:'ACT',verbs:['take']}]}];d.native={verbs:[{device:'washer3',noun:'door',verb:'take',cases:[{command:'take',say:['take jacket','Pass recovered.','ok']}]}],events:{},goals:{}};const lines:any[]=[],receipts:any[]=[];const model=new SceneModel({keyring:()=>save.keyring,give:()=>assert.fail('shared grant cannot mutate via native give'),say:(line,from,receipt)=>{assert(save.keyring.includes(key),'feedback only after root commit');lines.push([line,from]);receipts.push(receipt);},changed(){},open(){}},data,{effects:{}});model.setPaused(true);game.save=save;game.content={'grant-review':{id:'grant-review',gameplay:d}};game.hosts=new Map([['grant-review',{model}]]);game.gameplaySessions=new Map();game.sceneDefinition=(id:string)=>game.content[id]??{};game.syncHud=()=>{};const shared=game.gameplayFor('grant-review');attachNativeGameplay(model,shared);const k=KEYRING.get(key)!;const expected=model.line('keyring.'+k.kind,{label:k.label,text:k.text??''});model.act('washer3','door','take');assert.deepEqual(save.keyring,[key]);assert.deepEqual(lines[0],[expected,'washer3'],'original metadata line and actual origin preserved');assert.equal(lines[1][0][1],'Pass recovered.');assert(receipts[0].cueId);assert.notEqual(receipts[0].id,receipts[1].id);assert.equal(receipts[0].cueId,receipts[1].cueId,'grant and final reply share the native causal cue');const count=lines.length;model.act('washer3','door','take');assert.equal(lines.length,count+1,'repeat displays only ordinary response');assert.equal(receipts.filter(r=>r.id===receipts[0].id).length,1);assert.equal(loadSave().keyring.filter(k=>k===key).length,1,'current autosave persists actual keyring');shared.dispose();model.reset();model.setPaused(true);}finally{globalThis.localStorage=prior;}
