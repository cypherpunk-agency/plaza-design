let state:GameplayState={flags:{},items:{},tokens:0,player:{handle:'TEST',jump:false,controlled:[],keyring:[]}},writes=0;const order:string[]=[];const s=new GameplaySession(grants,{read:()=>state,write:next=>{state=next;writes++;}},()=>order.push('commit'),[],{keyring:new Set(KEYRING.keys())});s.observe(e=>order.push(e.id));s.observeGrants(g=>{assert(state.player!.keyring.includes(key));assert.equal(g.command,'take');order.push('grant:'+g.id);});const initial=cloneState(state);s.state();assert(s.eligibility('take','interaction').ok);assert.deepEqual(state,initial);assert.equal(writes,0);assert.deepEqual(order,[]);assert.deepEqual(s.dispatch('refuse','interaction'),{ok:false,reason:'resources'});assert.deepEqual(state,initial);assert.deepEqual(order,[]);assert(s.dispatch('take','interaction').ok);assert.deepEqual(order,['commit','take','grant:'+key,'after']);assert(state.flags.done,'reaction sees grant in the same atomic draft');assert.deepEqual(state.player!.keyring,[key]);assert.equal(s.events().length,2,'grant creates no implicit authored event');assert(s.dispatch('only','interaction').ok);assert.equal(order.filter(x=>x.startsWith('grant:')).length,1,'repeat grant has no duplicated feedback');assert(!s.dispatch('guarded','interaction').ok);s.dispose();
