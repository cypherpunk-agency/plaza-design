import type{SceneDef}from'../../src/ssg/game/scenes/kit';
const root=path.resolve('../..'),originalDir=path.join(root,'.scene-system/transport-marker-original');
function plain(v:unknown){return JSON.parse(JSON.stringify(v));}
function opening(file:string){const sf=ts.createSourceFile(file,fs.readFileSync(file,'utf8'),99,true);let value='';function visit(n:ts.Node){if(ts.isVariableDeclaration(n)&&n.name.getText(sf)==='TURNSTILE')value=n.initializer!.getText(sf);ts.forEachChild(n,visit);}visit(sf);return vm.runInNewContext('('+value+')');}
