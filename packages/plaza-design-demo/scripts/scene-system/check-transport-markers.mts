fs.writeFileSync(path.join(root,'.scene-system/evidence/S5-transport-marker-contracts.json'),JSON.stringify({defaultDoorCases,movedDoorCases,checkpointPaintCases:beatCases,timingConstantsEquivalent:true,stairTriggerAndCheckpointDistinct:true,linkedArrivalMarker:true,unsupportedTransformsRejected:true,worldCoordinatesRemainLocal:true,note:'Original target/paint comparisons use real current Game methods; workflow/timing/save/sound parity belongs to check-opening-runtime.mts. No gameplay playthrough.'},null,2));console.log('Transport markers: '+defaultDoorCases+' default and '+movedDoorCases+' moved door cases; '+beatCases+' checkpoint paint cases pass.');
