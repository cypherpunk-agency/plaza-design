function methods(file:string){const sf=ts.createSourceFile(file,fs.readFileSync(file,'utf8'),99,true),game=sf.statements.find(n=>ts.isClassDeclaration(n)&&n.name?.text==='Game') as ts.ClassDeclaration;return new Map(game.members.filter(ts.isMethodDeclaration).map(n=>[n.name.getText(sf),n.getText(sf)]));}
const beforeMethods=methods(path.join(originalDir,'runtime/game.ts'));
function minimal(source:Map<string,string>,timing:Record<string,unknown>,events:unknown[]){const exports:any={};vm.runInNewContext(ts.transpileModule('export class FocusedGame{'+['exitTargets','storyExit','drawBeat','updateStory'].map(k=>source.get(k)).join('\n')+'}',{compilerOptions:{target:99,module:ts.ModuleKind.CommonJS}}).outputText,{exports,...line,stationAt,STATIONS,TURNSTILE:timing,OPENING,storeSave:()=>events.push('save'),sound:{blip:()=>events.push('blip'),granted:()=>events.push('granted')}});return exports.FocusedGame;}
function base(Class:any,here='metro'){const g=new Class();Object.defineProperties(g,Object.fromEntries(Object.entries({here,clock:0,t:500,cam:300,viewW:640,save:{flags:{}},story:'home',keys:{clear(){}},sleep:null,world:{stationAt,STATIONS},metro:line}).map(([key,value])=>[key,{value,writable:true,configurable:true}])));return g;}
function recording(){const ops:unknown[]=[],values:Record<string,unknown>={};return{ops,ctx:new Proxy(values,{get(target,key:string){if(key in target)return target[key];if(key==='measureText')return(s:string)=>({width:s.length*4.25});return(...args:unknown[])=>ops.push([key,...args]);},set(target,key:string,value){ops.push(['set',key,value]);target[key]=value;return true;}}) as unknown as CanvasRenderingContext2D};}
const oldEvents:unknown[]=[],Old=minimal(beforeMethods,originalTiming,oldEvents),Current=function(){return Object.create(Game.prototype);}as any;
const openBefore={...line.lineOpen};let defaultDoorCases=0,movedDoorCases=0;
try{Object.assign(line.lineOpen,{downtown:true,galleria:true,harbor:true});
 for(const[scene,factory,doc,validate]of[[metro,metroScene,metroComposition,validateMetroComposition],[galleriaStation,galleriaStationScene,G.composition,G.validate],[harborStation,harborStationScene,H.composition,H.validate]] as const){
  assert.equal(scene.platformStop,line.STOP);const changed=structuredClone(doc);changed.instances.find(n=>n.id==='platform-train')!.placement.x+=37;validate(changed);const moved=factory(changed);assert.equal(moved.platformStop,line.STOP+37);assert.equal(moved.exits.find(e=>e.id==='train')!.x,scene.exits.find(e=>e.id==='train')!.x+37);
  for(const cam of[0,300,800])for(let t=0;t<1500;t+=25){const old=base(Old,scene.id),current=base(Current,scene.id);Object.assign(old,{cam,t});Object.assign(current,{cam,t});const expected=plain(old.exitTargets(scene)),actual=plain(current.exitTargets(scene));assert.deepEqual(actual,expected,scene.id+' default doors '+t+' '+cam);defaultDoorCases++;const edited=plain(current.exitTargets(moved));assert.deepEqual(edited,actual.map((target:any)=>target.id==='exit:train'?{...target,x:target.x+37}:target),scene.id+' moved doors '+t+' '+cam);movedDoorCases++;}
  for(const transform of[{h:1},{scale:2},{facing:-1},{parallax:.9}]){const invalid=structuredClone(changed);Object.assign(invalid.instances.find(n=>n.id==='platform-train')!.placement,transform);assert.throws(()=>validate(invalid),/horizontal/);}
 }
}finally{Object.assign(line.lineOpen,openBefore);}
assert.equal(metro.exits.find(e=>e.id==='downtown')!.x,32);assert.deepEqual(metro.exits.find(e=>e.id==='downtown')!.checkpoint,{x:originalTiming.x,h:0});
const movedCheckpoint=structuredClone(metroComposition);movedCheckpoint.instances.find(n=>n.id==='turnstile')!.placement.x+=41;const edited=metroScene(movedCheckpoint);assert.equal(edited.exits[0].x,metro.exits[0].x,'stair trigger stays independent');assert.deepEqual(edited.exits[0].checkpoint,{x:originalTiming.x+41,h:0});
for(const transform of[{h:1},{scale:2},{facing:-1},{parallax:.9}]){const invalid=structuredClone(movedCheckpoint);Object.assign(invalid.instances.find(n=>n.id==='turnstile')!.placement,transform);assert.throws(()=>validateMetroComposition(invalid),/horizontal/);}
let beatCases=0;for(const checkpoint of[metro.exits[0].checkpoint!,edited.exits[0].checkpoint!,{x:200,h:12}])for(const elapsed of[0,20,149,150,199]){
 const old=base(Old),current=base(Current),before=recording(),after=recording();let oldGo=0,newGo=0;originalTiming.x=checkpoint.x;old.storyExit({turnstile:true},32,()=>oldGo++);current.beat={start:0,checkpoint,then:()=>newGo++};Object.assign(old,{clock:elapsed,x:before.ctx,sx:(x:number)=>x-80,y:(h:number)=>280-h-(checkpoint.h??0)});Object.assign(current,{clock:elapsed,x:after.ctx,sx:(x:number)=>x-80,y:(h:number)=>280-h});old.drawBeat();current.drawBeat();assert.deepEqual(plain(after.ops),plain(before.ops),'checkpoint UI '+checkpoint.x+' '+elapsed);beatCases++;
}
// Shared source workflow/timing/save/sound parity is exercised by check-opening-runtime.mts.
