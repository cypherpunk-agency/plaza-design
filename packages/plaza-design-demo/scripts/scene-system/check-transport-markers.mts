import {Game} from '../../src/ssg/game/runtime/game';
import assert from'node:assert/strict';import fs from'node:fs';import path from'node:path';import vm from'node:vm';import ts from'typescript';
import {metro,metroScene}from'../../src/ssg/game/scenes/metro/index';import{metroComposition,validateMetroComposition}from'../../src/ssg/game/scenes/metro/composition.ts';
import{galleriaStation,galleriaStationScene}from'../../src/ssg/game/scenes/galleriaStation/index';import{galleriaStationAdapter as G}from'../../src/ssg/game/scenes/galleriaStation/composition.ts';
import{harborStation,harborStationScene}from'../../src/ssg/game/scenes/harborStation/index';import{harborStationAdapter as H}from'../../src/ssg/game/scenes/harborStation/composition.ts';
