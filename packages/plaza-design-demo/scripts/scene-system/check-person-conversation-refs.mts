import assert from 'node:assert/strict';
import {validateSceneDocument,type SceneDocument} from '../../src/ssg/game/engine/gameplay/scene-document';
import {withSceneConversations} from '../../src/ssg/game/engine/gameplay/scene-conversations';
import {compileSceneActors} from '../../src/ssg/game/engine/gameplay/actors';
import {manifestCompositionRows} from '../../src/ssg/game/engine/gameplay/manifest-geometry';
import {art} from '../../src/ssg/game/art';
import {validateGameplay} from '../../src/ssg/game/engine/gameplay/validation';
import {GameplaySession} from '../../src/ssg/game/engine/gameplay/session';
import {ConversationSession} from '../../src/ssg/game/engine/gameplay/conversation';
import {withBotConversations} from '../../src/ssg/game/engine/gameplay/bot-conversations';
import type {GameplayState} from '../../src/ssg/game/engine/gameplay/types';
const graph='talk.warehouse.vendor',cursor=graph+'.cursor';
const g=validateGameplay({version:1,flags:['paid'],items:[],events:[],state:{[cursor]:{owner:graph,lifetime:'save',type:'number',default:0,min:0,max:1}},commands:{advance:{sources:['conversation'],actions:[{state:cursor,set:1}]},reward:{sources:['conversation'],when:{not:{flag:'paid'}},actions:[{flag:'paid',value:true},{tokens:2}]}},reactions:[],conversations:{[graph]:{entry:[{when:{state:cursor,is:0},node:'first'},{node:'again'}],nodes:{first:{speaker:'VENDOR',pages:['First.'],onEnter:'advance',choices:[{id:'accept',label:'Accept',command:'reward',next:'again'}]},again:{speaker:'VENDOR',pages:['Again.']}}}}});
const source:SceneDocument={version:1,id:'warehouse',name:'Reference fixture',intro:[],uses:[],actors:[{id:'vendor',instance:'actor-vendor',target:'vendor',band:'world',seed:7,look:{bot:'android'}}],people:[{id:'vendor',name:'VENDOR',conversation:graph}]};
const composition=art.validate({version:1,scene:'warehouse',instances:[{id:'actor-vendor',type:'character.prepared',props:{actor:'vendor'},placement:{x:180,h:0},order:0,pass:'backdrop',bindings:{pose:'actor.vendor.pose'}}]});
const validated=validateSceneDocument(source,g,{actors:true}),definition=withSceneConversations(g,validated);
assert.deepEqual(definition,g,'reference keeps graph, state, commands and ownership exact');
const native=compileSceneActors(validated,manifestCompositionRows(composition)).vendor;
assert.equal(native.conversation,graph);assert.deepEqual(native.talk,[],'empty runtime marker preserves key-person drawing without duplicating authored pages');
assert.deepEqual(withBotConversations({id:'warehouse',name:'Fixture',width:600,spawn:180,exits:[],people:[native],gameplay:definition}).gameplay,definition,'explicit robot graph prevents redundant procedural reaction');
let state:GameplayState={flags:{},items:{},tokens:0};const port={read:()=>state,write:(s:GameplayState)=>{state=s;}};
let session=new GameplaySession(definition,port),conversation=new ConversationSession(session,native.conversation!);
assert.deepEqual(conversation.frame().pages,['First.']);assert.equal(state.values![cursor],1);assert(conversation.choose('accept').ok);assert.equal(state.tokens,2);conversation.close();session.dispose();
state=JSON.parse(JSON.stringify(state));session=new GameplaySession(definition,port);conversation=new ConversationSession(session,graph);assert.deepEqual(conversation.frame().pages,['Again.']);assert.equal(state.tokens,2);assert.equal(conversation.choose('accept').ok,false);conversation.close();session.dispose();
const pending=structuredClone(g);pending.conversations[graph].nodes.again.pages=['Pending existing graph.'];const compiled=withSceneConversations(pending,source);session=new GameplaySession(compiled,port);assert.deepEqual(new ConversationSession(session,native.conversation!).frame().pages,['Pending existing graph.']);session.dispose();
const mixed=structuredClone(source);mixed.people!.push({id:'other',name:'OTHER',talk:[['Hello.'],['Later.']]});const both=withSceneConversations(g,validateSceneDocument(mixed,g,{actors:true}));assert.deepEqual(both.conversations[graph],g.conversations[graph]);assert(both.conversations['talk.warehouse.other']);assert(both.state!['talk.warehouse.other.cursor']);
for(const person of [{id:'vendor',name:'VENDOR',conversation:'missing'}, {id:'vendor',name:'VENDOR',conversation:graph,talk:[['Duplicated.']]}, {id:'vendor',name:'VENDOR',conversation:graph,repeat:'cycle'}, {id:'vendor',name:'VENDOR',conversation:graph,lines:[{pages:['Duplicate.']}]}, {id:'vendor',name:'VENDOR'}]){const invalid=structuredClone(source) as any;invalid.people=[person];assert.throws(()=>validateSceneDocument(invalid,g,{actors:true}));}
const withoutState=structuredClone(g);delete withoutState.state;withoutState.commands={};withoutState.conversations[graph]={entry:[{node:'only'}],nodes:{only:{speaker:'VENDOR',pages:['One graph.']}}};assert.equal(withSceneConversations(withoutState,source).state,undefined,'no invented cursor storage for references');
console.log('Person conversation references PASS: exact graph/command/cursor ownership, native robot binding, existing saved progress/reward guard, pending graph edits, mixed chatter, no duplicated bot graphs and invalid/double-owned definitions rejected.');
